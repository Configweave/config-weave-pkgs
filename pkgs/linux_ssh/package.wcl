package "linux_ssh" {
  description = "Manage SSH keys, known hosts and client/daemon configuration"

  resource "authorized_key" {
    description = "Ensure an SSH authorized key is present or absent"
    script = "resources/authorized_key.ws"
    // read-modify-write on a shared authorized_keys file — parallel steps lose updates
    concurrency = "exclusive"
    param "user" { description = "Account name" type = "string" required = true }
    param "key" { description = "Authorized key line" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the key to authorized_keys" }
      symbol "absent"  { description = "Remove the key from authorized_keys" }
    }
    param "home" { description = "Optional home directory override" type = "string" default = "" }
  }

  resource "known_host" {
    description = "Ensure a known_hosts entry is present"
    script = "resources/known_host.ws"
    concurrency = "exclusive"
    param "name" { description = "Host name the entry is for (informational)" type = "string" default = "" }
    param "key" { description = "Full known_hosts line" type = "string" required = true }
    param "home" { description = "Home directory owning ~/.ssh/known_hosts; defaults to the current user home" type = "string" default = "" }
    param "path" { description = "Explicit known_hosts path override" type = "string" default = "" }
  }

  resource "ssh_config_setting" {
    description = "Ensure an ssh client option is set via an ssh_config.d drop-in"
    script = "resources/ssh_config_setting.ws"
    concurrency = "parallel"
    param "key" { description = "ssh_config option name, such as StrictHostKeyChecking" type = "string" required = true }
    param "value" { description = "Option value (required when present)" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Write the ssh_config.d drop-in" }
      symbol "absent"  { description = "Remove the drop-in" }
    }
    param "host" { description = "Host pattern the option applies to" type = "string" default = "*" }
  }

  resource "sshd_config_setting" {
    description = "Ensure an sshd option is set via an sshd_config.d drop-in"
    script = "resources/sshd_config_setting.ws"
    concurrency = "exclusive"
    param "key" { description = "sshd_config option name, such as PasswordAuthentication" type = "string" required = true }
    param "value" { description = "Option value (required when present)" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Write the sshd_config.d drop-in" }
      symbol "absent"  { description = "Remove the drop-in" }
    }
    param "validate" { description = "Run sshd -t validation when sshd is available" type = "bool" default = true }
  }

  // The absent steps converge on files seeded during setup (run 1 checks every
  // step before any apply).
  test "ssh_converges" {
    description = "Keys, known hosts and config drop-ins converge in a Debian container"
    image = "debian:12"
    setup = "mkdir -p /root/.ssh /etc/ssh/sshd_config.d && printf 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOldKeyGoesAway cw-old\\n' > /root/.ssh/authorized_keys && printf 'X11Forwarding yes\\n' > /etc/ssh/sshd_config.d/50-config-weave-x11forwarding.conf"
    verify = "tests/ssh_verify.ws"

    step "key" {
      description = "Install an authorized key for root"
      resource = "authorized_key"
      properties {
        user = "root"
        home = "/root"
        key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAITestConfigWeaveKey config-weave"
      }
    }

    step "rm_key" {
      description = "Remove the seeded key line"
      resource = "authorized_key"
      requires = ["key"]
      properties {
        user = "root"
        home = "/root"
        key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOldKeyGoesAway cw-old"
        ensure = :absent
      }
    }

    // `home` is explicit: without it the resource falls back to $HOME, and
    // the guest agent runs execs with HOME=/ rather than the user's home.
    step "known" {
      description = "Add a known_hosts entry"
      resource = "known_host"
      properties {
        home = "/root"
        name = "cw-test.example"
        key = "cw-test.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAITestConfigWeaveKey"
      }
    }

    step "client" {
      description = "Set a client option"
      resource = "ssh_config_setting"
      properties { key = "StrictHostKeyChecking" value = "no" }
    }

    step "daemon" {
      description = "Set a daemon option"
      resource = "sshd_config_setting"
      properties { key = "PasswordAuthentication" value = "no" }
    }

    step "rm_daemon" {
      description = "Remove the seeded daemon drop-in"
      resource = "sshd_config_setting"
      properties { key = "X11Forwarding" ensure = :absent }
    }
  }

  // Root's file is seeded with modes sshd's StrictModes rejects, a key whose
  // comment changes, and a key with options that :absent must still find.
  // `modes` runs first: every other present step also fixes the modes.
  test "authorized_key_converges" {
    description = "authorized_key matches keys by type and blob, enforces StrictModes attributes, and serves a user without a same-named group"
    image = "debian:12"
    group = "ssh"
    setup = "(id cwkey >/dev/null 2>&1 || useradd -m -g users cwkey) && mkdir -p /root/.ssh && printf 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIRotateCommentKey old-comment\\nfrom=\"10.0.0.1\",command=\"echo a b\" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOptionedKeyGoesAway cw-old\\nssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKeepThisKeyUntouched keep\\n' > /root/.ssh/authorized_keys && chmod 755 /root/.ssh && chmod 644 /root/.ssh/authorized_keys"
    verify = "tests/authorized_key_verify.ws"

    step "modes" {
      description = "A key already in the file converges on .ssh and file modes alone"
      resource = "authorized_key"
      properties { user = "root" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKeepThisKeyUntouched keep" }
    }

    step "comment" {
      description = "The same key with a new comment replaces the old line instead of adding a second"
      resource = "authorized_key"
      requires = ["modes"]
      properties { user = "root" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIRotateCommentKey new-comment" }
    }

    step "rm_optioned" {
      description = "Removing a key also removes a line that adds options and a different comment"
      resource = "authorized_key"
      requires = ["modes"]
      properties { user = "root" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOptionedKeyGoesAway" ensure = :absent }
    }

    step "non_root" {
      description = "A key for a user whose primary group is not named after it, home found through getent"
      resource = "authorized_key"
      properties { user = "cwkey" key = "restrict ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINonRootUserKey cwkey@test" }
    }

    step "multi_line" {
      description = "A key with a line break would add a second entry and is rejected"
      resource = "authorized_key"
      expect = "error"
      properties { user = "cwkey" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINonRootUserKey a\nssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIInjectedKey b" }
    }

    step "not_a_key" {
      description = "Text that is not an authorized_keys entry is rejected"
      resource = "authorized_key"
      expect = "error"
      properties { user = "cwkey" key = "hello world" }
    }

    step "bad_user" {
      description = "A user name that would be read as an option is rejected"
      resource = "authorized_key"
      expect = "error"
      properties { user = "-froot" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINonRootUserKey x" }
    }
  }
}
