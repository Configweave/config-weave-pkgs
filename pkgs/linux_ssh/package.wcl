package "linux_ssh" {
  description = "Manage SSH authorized keys, known hosts and ssh/sshd configuration drop-ins"

  resource "authorized_key" {
    description = "Ensure an SSH key is present in or absent from a user's ~/.ssh/authorized_keys. Lines match on key type and base64 blob, so a line for the same key with other options or another comment is rewritten to the wanted text when :present, and removed when :absent. When :present, check also requires what sshd's StrictModes requires: .ssh mode 700 and authorized_keys mode 600, both owned by the user (group: the user's login group). The home directory itself must not be group- or world-writable either; that is not managed here. The file is replaced through a temp file and rename. A symlink at authorized_keys, dangling or not, is an error in both check and apply: it is never read, written or replaced"
    script = "resources/authorized_key.ws"
    // read-modify-write on a shared authorized_keys file — parallel steps lose updates
    concurrency = "exclusive"
    param "user" { description = "Account name; it must exist when :present" type = "string" required = true }
    param "key" { description = "One authorized_keys line: [options] type base64 [comment]. Line breaks are rejected" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the key, or rewrite its line to the wanted options and comment" }
      symbol "absent"  { description = "Remove every line for the key, whatever its options or comment. A missing user or file is already absent" }
    }
    param "home" { description = "Absolute home directory override; defaults to the user's home from its passwd entry" type = "string" default = "" }
  }

  resource "known_host" {
    description = "Ensure a known_hosts entry is present or absent. Entries match on marker, host list, key type and key blob, so a different comment is rewritten rather than duplicated. Hashed host names (HashKnownHosts) are not matched by `name`. Without `path` the file is ~/.ssh/known_hosts in `home`, or in the home of the user config-weave runs as, read from its passwd entry (not $HOME). In a home, apply makes .ssh mode 700 and hands .ssh and the file to the home directory's owner, and check compares both; with an explicit `path` only the content is managed. A symlink at the file, dangling or not, is an error in both check and apply: it is never read, written or replaced"
    script = "resources/known_host.ws"
    // read-modify-write on a shared known_hosts file
    concurrency = "exclusive"
    param "name" { description = "Host name whose entries this step owns. When :present, a plain entry for this host with the same marker and key type but another key is replaced (key rotation); other key types are kept. When :absent without `key`, every plain entry naming this host is removed" type = "string" default = "" }
    param "key" { description = "Full known_hosts line: [@cert-authority|@revoked] hosts type base64 [comment]. Required when :present; when :absent, the entry with this host list and key is removed" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the entry, replacing a rotated-out key for `name`" }
      symbol "absent"  { description = "Remove the entry given by `key`, or every entry for `name`" }
    }
    param "home" { description = "Home directory owning ~/.ssh/known_hosts; defaults to the home of the user config-weave runs as" type = "string" default = "" }
    param "path" { description = "Explicit absolute known_hosts path, such as /etc/ssh/ssh_known_hosts; overrides `home`" type = "string" default = "" }
  }

  resource "ssh_config_setting" {
    description = "Ensure an ssh client option is set for a host pattern through its own /etc/ssh/ssh_config.d drop-in: 10-config-weave-<key>.conf for host *, or 10-config-weave-<key>-<host>-<digest>.conf for any other pattern, so one key can be set for several patterns. ssh keeps the first value it reads, so the 10- prefix puts these ahead of distribution drop-ins such as 50-redhat.conf, and a host-specific file sorts ahead of the all-hosts one. Needs `Include /etc/ssh/ssh_config.d/*.conf` near the top of /etc/ssh/ssh_config (Debian, Ubuntu and Fedora ship it); a user's ~/.ssh/config still overrides. A drop-in left by an older version (50-config-weave-<key>.conf) for the same host is removed"
    script = "resources/ssh_config_setting.ws"
    // steps for one key share the legacy file name they migrate from
    concurrency = "exclusive"
    param "key" { description = "ssh_config option name, such as StrictHostKeyChecking: letters and digits only; Host, Match and Include are rejected" type = "string" required = true }
    param "value" { description = "Option value (required when present), on one line" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Write the ssh_config.d drop-in" }
      symbol "absent"  { description = "Remove the drop-in for this key and host" }
    }
    param "host" { description = "Host pattern list the option applies to, as written after `Host`, on one line" type = "string" default = "*" }
  }

  resource "sshd_config_setting" {
    description = "Ensure an sshd option is set through its own drop-in, /etc/ssh/sshd_config.d/10-config-weave-<key>.conf. sshd keeps the first value it reads, so the 10- prefix puts it ahead of 50-cloud-init.conf. When sshd is installed and `validate` is on, apply runs sshd -t and restores the previous drop-in (or removes the new one) when sshd rejects it, and check compares the effective value from sshd -T, so a value set by an earlier drop-in, by sshd_config above its Include line, or a missing `Include /etc/ssh/sshd_config.d/*.conf` is an error rather than reported converged. sshd -T and -t need the host keys and /run/sshd to exist. A running sshd keeps its old configuration until reloaded: set `reload`, or restart it with a service resource. A drop-in left by an older version (50-config-weave-<key>.conf) is removed"
    script = "resources/sshd_config_setting.ws"
    concurrency = "exclusive"
    param "key" { description = "sshd_config option name, such as PasswordAuthentication: letters and digits only; Match and Include are rejected" type = "string" required = true }
    param "value" { description = "Option value (required when present), on one line" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Write the sshd_config.d drop-in" }
      symbol "absent"  { description = "Remove the drop-in" }
    }
    param "validate" { description = "When sshd is installed: validate with sshd -t after writing (rolling back on failure) and compare the effective value from sshd -T in check. false compares the drop-in's content only" type = "bool" default = true }
    param "reload" { description = "After a change, reload a running sshd: systemctl reload of an active ssh or sshd unit, or SIGHUP to the pid in /run/sshd.pid without systemd. Nothing is done when sshd is not running" type = "bool" default = false }
  }

  // Root's file is seeded with modes sshd's StrictModes rejects, a key whose
  // comment changes, and a key with options that :absent must still find.
  // `modes` runs first: every other present step also fixes the modes.
  test "authorized_key_converges" {
    description = "authorized_key matches keys by type and blob, enforces StrictModes attributes, and serves a user without a same-named group"
    image = "debian:12"
    group = "ssh"
    setup = "(id cwkey >/dev/null 2>&1 || useradd -m -g users cwkey) && mkdir -p /root/.ssh && printf 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIRotateCommentKey old-comment\\nfrom=\"10.0.0.1\",command=\"echo a b\" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOptionedKeyGoesAway cw-old\\nssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKeepThisKeyUntouched keep\\n' > /root/.ssh/authorized_keys && chmod 755 /root/.ssh && chmod 644 /root/.ssh/authorized_keys && (id cwlink >/dev/null 2>&1 || useradd -m -g users cwlink) && printf 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPlantedLinkSecretKey root\\n' > /root/cw-secret-keys && chmod 600 /root/cw-secret-keys && mkdir -p /home/cwlink/.ssh /home/cwdangle/.ssh && ln -sfn /root/cw-secret-keys /home/cwlink/.ssh/authorized_keys && ln -sfn /root/cw-nowhere-keys /home/cwdangle/.ssh/authorized_keys && chown -hR cwlink:users /home/cwlink/.ssh"
    verify = "tests/authorized_key_verify.ws"

    step "modes" {
      description = "A key already in the file converges on .ssh and file modes alone"
      resource = "authorized_key"
      properties { user = "root" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKeepThisKeyUntouched keep" }
    }

    step "comment" {
      description = "The same key with a new comment replaces the old line instead of adding a second"
      resource = "authorized_key"
      requires = ["modes"]
      properties { user = "root" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIRotateCommentKey new-comment" }
    }

    step "rm_optioned" {
      description = "Removing a key also removes a line that adds options and a different comment"
      resource = "authorized_key"
      requires = ["modes"]
      properties { user = "root" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOptionedKeyGoesAway" ensure = :absent }
    }

    step "non_root" {
      description = "A key for a user whose primary group is not named after it, home found through getent"
      resource = "authorized_key"
      properties { user = "cwkey" key = "restrict ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINonRootUserKey cwkey@test" }
    }

    step "multi_line" {
      description = "A key with a line break would add a second entry and is rejected"
      resource = "authorized_key"
      expect = "error"
      properties { user = "cwkey" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINonRootUserKey a\nssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIInjectedKey b" }
    }

    step "not_a_key" {
      description = "Text that is not an authorized_keys entry is rejected"
      resource = "authorized_key"
      expect = "error"
      properties { user = "cwkey" key = "hello world" }
    }

    // cwlink's authorized_keys is a symlink the user planted at a root-only
    // file that already holds the key; cwdangle's points at nothing.
    step "planted_link" {
      description = "A symlink at authorized_keys is an error even when its target already holds the key"
      resource = "authorized_key"
      expect = "error"
      properties { user = "cwlink" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPlantedLinkSecretKey root" }
    }

    step "planted_link_absent" {
      description = "Removing a key through a symlink at authorized_keys is an error"
      resource = "authorized_key"
      expect = "error"
      properties { user = "cwlink" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPlantedLinkSecretKey" ensure = :absent }
    }

    step "dangling_link" {
      description = "A dangling symlink at authorized_keys is an error, and nothing is created at its target"
      resource = "authorized_key"
      expect = "error"
      properties { user = "root" home = "/home/cwdangle" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINonRootUserKey x" }
    }

    step "bad_user" {
      description = "A user name that would be read as an option is rejected"
      resource = "authorized_key"
      expect = "error"
      properties { user = "-froot" key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINonRootUserKey x" }
    }
  }

  // No step sets `home` for root: the default must come from root's passwd
  // entry, since the guest agent runs with HOME=/.
  test "known_host_converges" {
    description = "known_host adds, rotates and removes entries, in the right home and with the home owner's ownership"
    image = "debian:12"
    group = "ssh"
    setup = "(id cwkh >/dev/null 2>&1 || useradd -m -g users cwkh) && mkdir -p /root/.ssh && printf 'cw-rot.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOldRotatedHostKey\\ncw-rot.example ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABOtherTypeKey\\ncw-gone.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGoneHostKeyBlob1\\ncw-gone.example,10.0.0.9 ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABGoneRsaBlob1\\ncw-bykey.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIRemoveByKeyBlob old comment\\n' > /root/.ssh/known_hosts && printf 'cw-secret.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPlantedLinkSecretKey\\n' > /root/cw-secret-hosts && chmod 600 /root/cw-secret-hosts && mkdir -p /home/cwkhl/.ssh /home/cwkhd/.ssh && ln -sfn /root/cw-secret-hosts /home/cwkhl/.ssh/known_hosts && ln -sfn /root/cw-nowhere-hosts /home/cwkhd/.ssh/known_hosts"
    verify = "tests/known_host_verify.ws"

    step "default_home" {
      description = "Without home or path the entry goes to the running user's home from its passwd entry"
      resource = "known_host"
      properties { key = "cw-default.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDefaultHomeKey" }
    }

    step "rotate" {
      description = "A new key of the same type for a named host replaces the old one and keeps its other key types"
      resource = "known_host"
      properties { name = "cw-rot.example" key = "cw-rot.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINewRotatedHostKey" }
    }

    step "rm_name" {
      description = "Removing by name drops every plain entry for the host"
      resource = "known_host"
      properties { name = "cw-gone.example" ensure = :absent }
    }

    step "rm_key" {
      description = "Removing by key drops the entry whatever its comment"
      resource = "known_host"
      properties { key = "cw-bykey.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIRemoveByKeyBlob" ensure = :absent }
    }

    step "non_root" {
      description = "An entry in another user's home is owned by that user"
      resource = "known_host"
      properties { home = "/home/cwkh" key = "cw-user.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIUserHomeHostKey" }
    }

    step "system_file" {
      description = "An explicit path, such as the system-wide file"
      resource = "known_host"
      properties { path = "/etc/ssh/ssh_known_hosts" key = "@cert-authority *.cw.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICertAuthorityKey" }
    }

    // /home/cwkhl/.ssh/known_hosts is a symlink planted at a root-only file
    // that already holds the entry; /home/cwkhd's points at nothing.
    step "planted_link" {
      description = "A symlink at known_hosts is an error even when its target already holds the entry"
      resource = "known_host"
      expect = "error"
      properties { home = "/home/cwkhl" key = "cw-secret.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPlantedLinkSecretKey" }
    }

    step "planted_link_absent" {
      description = "Removing an entry through a symlink at known_hosts is an error"
      resource = "known_host"
      expect = "error"
      properties { home = "/home/cwkhl" name = "cw-secret.example" ensure = :absent }
    }

    step "dangling_link" {
      description = "A dangling symlink at known_hosts is an error, and nothing is created at its target"
      resource = "known_host"
      expect = "error"
      properties { home = "/home/cwkhd" key = "cw-dangle.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIUserHomeHostKey" }
    }

    step "multi_line" {
      description = "A key with a line break is rejected"
      resource = "known_host"
      expect = "error"
      properties { key = "a.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIUserHomeHostKey\nb.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIUserHomeHostKey" }
    }
  }

  // Seeds: a cloud-init drop-in the 10- prefix must beat, drop-ins with the
  // old 50- name, a valid drop-in a rejected update must leave in place, and
  // an earlier drop-in that shadows a key. sshd is started so `reload` has
  // something to reload; verify sees the banner only if it did.
  test "sshd_config_converges" {
    description = "sshd_config_setting wins over cloud-init, migrates old drop-ins, rolls back what sshd -t rejects, reports shadowed keys and reloads sshd"
    image = "debian:12"
    group = "ssh"
    setup = "(test -x /usr/sbin/sshd || (apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq openssh-server openssh-client >/dev/null)) && mkdir -p /run/sshd /etc/ssh/sshd_config.d && cd /etc/ssh/sshd_config.d && printf 'PasswordAuthentication yes\\n' > 50-cloud-init.conf && printf 'X11Forwarding no\\n' > 50-config-weave-x11forwarding.conf && printf 'MaxAuthTries 3\\n' > 50-config-weave-maxauthtries.conf && printf 'LogLevel VERBOSE\\n' > 10-config-weave-loglevel.conf && printf 'ClientAliveInterval 30\\n' > 05-local.conf && echo cw-banner-text > /etc/cw-banner && (test -s /run/sshd.pid && kill -0 $(cat /run/sshd.pid) 2>/dev/null || /usr/sbin/sshd)"
    verify = "tests/sshd_config_verify.ws"

    step "password" {
      description = "A value that 50-cloud-init.conf also sets takes effect"
      resource = "sshd_config_setting"
      properties { key = "PasswordAuthentication" value = "no" }
    }

    step "migrate" {
      description = "A 50-config-weave drop-in with the same value is moved to the 10- name"
      resource = "sshd_config_setting"
      properties { key = "X11Forwarding" value = "no" }
    }

    step "rm_legacy" {
      description = "Removal also removes the old-named drop-in"
      resource = "sshd_config_setting"
      properties { key = "MaxAuthTries" ensure = :absent }
    }

    step "normalised" {
      description = "A value sshd -T prints differently (2m as 120) still converges"
      resource = "sshd_config_setting"
      properties { key = "LoginGraceTime" value = "2m" }
    }

    step "reload" {
      description = "A banner set with reload reaches the running sshd"
      resource = "sshd_config_setting"
      properties { key = "Banner" value = "/etc/cw-banner" reload = true }
    }

    step "rejected_update" {
      description = "sshd -t rejects the new value and the previous drop-in is restored"
      resource = "sshd_config_setting"
      expect = "error"
      properties { key = "LogLevel" value = "BOGUS" }
    }

    step "rejected_new" {
      description = "sshd -t rejects a new drop-in and it is removed"
      resource = "sshd_config_setting"
      expect = "error"
      properties { key = "MaxSessions" value = "many" }
    }

    step "shadowed" {
      description = "A key an earlier drop-in sets cannot take effect, which is an error"
      resource = "sshd_config_setting"
      expect = "error"
      properties { key = "ClientAliveInterval" value = "60" }
    }

    step "block_key" {
      description = "Match is a block, not an option"
      resource = "sshd_config_setting"
      expect = "error"
      properties { key = "Match" value = "all" }
    }

    step "injected" {
      description = "A value with a line break would add a second directive"
      resource = "sshd_config_setting"
      expect = "error"
      properties { key = "PermitRootLogin" value = "no\nPasswordAuthentication yes" }
    }
  }

  test "ssh_config_converges" {
    description = "ssh_config_setting keeps one drop-in per key and host, migrates old drop-ins and removes its own"
    image = "debian:12"
    group = "ssh"
    setup = "(test -x /usr/bin/ssh || (apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq openssh-client >/dev/null)) && mkdir -p /etc/ssh/ssh_config.d && cd /etc/ssh/ssh_config.d && printf 'Host *\\n    StrictHostKeyChecking ask\\n' > 50-config-weave-stricthostkeychecking.conf && printf 'Host other.example\\n    Compression no\\n' > 50-config-weave-compression.conf && printf 'Host *\\n    ForwardAgent yes\\n' > 10-config-weave-forwardagent.conf"
    verify = "tests/ssh_config_verify.ws"

    step "all_hosts" {
      description = "Set an option for every host, replacing the old-named drop-in"
      resource = "ssh_config_setting"
      properties { key = "StrictHostKeyChecking" value = "no" }
    }

    step "one_host" {
      description = "The same option for one pattern gets its own drop-in instead of fighting the all-hosts one"
      resource = "ssh_config_setting"
      properties { key = "StrictHostKeyChecking" value = "accept-new" host = "*.cw.example" }
    }

    step "foreign_legacy" {
      description = "An old-named drop-in for another host is left to that host's step"
      resource = "ssh_config_setting"
      properties { key = "Compression" value = "yes" }
    }

    step "remove" {
      description = "Remove a drop-in"
      resource = "ssh_config_setting"
      properties { key = "ForwardAgent" ensure = :absent }
    }

    step "injected_host" {
      description = "A host with a line break would add a directive outside the Host block"
      resource = "ssh_config_setting"
      expect = "error"
      properties { key = "User" value = "cw" host = "a\nProxyCommand evil" }
    }

    step "path_key" {
      description = "A key that is not an option name cannot reach the file name"
      resource = "ssh_config_setting"
      expect = "error"
      properties { key = "../../../tmp/x" value = "y" }
    }
  }
}
