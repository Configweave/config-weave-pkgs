package "linux_flatpak" {
  description = "Manage Flatpak applications and remotes"

  resource "package" {
    description = "Ensure a Flatpak application is installed or absent"
    script = "resources/package.ws"
    concurrency = "exclusive"
    param "id" { description = "Application id (e.g. org.mozilla.firefox)" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Install the application" }
      symbol "absent"  { description = "Uninstall the application" }
    }
    param "remote" { description = "Remote to install from" type = "string" default = "flathub" }
  }

  resource "remote" {
    description = "Ensure a Flatpak remote is configured or absent"
    script = "resources/remote.ws"
    concurrency = "exclusive"
    param "name" { description = "Remote name" type = "string" required = true }
    param "url" { description = "Remote URL (required when :present)" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the remote" }
      symbol "absent"  { description = "Delete the remote" }
    }
  }

  // Unlike the other managers' `cache_updated`, this upgrades installed apps
  // and runtimes rather than refreshing metadata: flatpak resolves against the
  // remote live, so an `--appstream` refresh would buy nothing.
  resource "updated" {
    description = "Run flatpak update when the last update is older than max_age"
    script = "resources/updated.ws"
    concurrency = "exclusive"
    param "installation" {
      description = "Which flatpak installation to update"
      type = "symbol"
      default = :system

      symbol "system" { description = "Update the system-wide installation" }
      symbol "user"   { description = "Update the calling user's installation" }
    }
    param "max_age" {
      description = "Update when the last update is older than this span"
      type = "duration"
      default = 24h
    }
  }

  // Needs the network and a real flatpak install, so the test runs in a
  // Fedora VM with NAT. `remote` converges against flathub; `package` is
  // exercised through its absent path only — installing a real app pulls a
  // multi-hundred-megabyte runtime, which is scenario territory, not a
  // convergence test. `updated` is cheap here for the same reason: with no
  // apps installed, `flatpak update` is a no-op that still writes its stamp.
  //
  // The steps are chained with `requires`: `exclusive` only serializes steps
  // of the SAME resource type, but every flatpak subcommand contends for the
  // one system installation lock. Playbooks mixing these need the same
  // ordering.
  test "remote_converges" {
    description = "The flathub remote, an absent app and the update window all converge"
    template = "x86_64/fedora-44"
    setup = "dnf install -y flatpak"
    verify = "tests/remote_verify.ws"

    step "flathub" {
      description = "Add the flathub remote"
      resource = "remote"
      properties {
        name = "flathub"
        url = "https://dl.flathub.org/repo/flathub.flatpakrepo"
        ensure = :present
      }
    }

    step "app_absent" {
      description = "An app that was never installed is already configured"
      resource = "package"
      expect = "already_configured"
      requires = ["flathub"]
      properties { id = "org.example.CwNeverInstalled" ensure = :absent }
    }

    step "updated" {
      description = "Update the system installation and stamp the window"
      resource = "updated"
      requires = ["app_absent"]
      properties { installation = :system  max_age = 24h }
    }
  }
}
