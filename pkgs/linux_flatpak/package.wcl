package "linux_flatpak" {
  description = "Manage Flatpak applications and remotes"

  resource "package" {
    description = "Ensure a Flatpak application is installed or absent"
    script = "resources/package.ws"
    concurrency = "exclusive"
    param "id" { description = "Application id (e.g. org.mozilla.firefox)" type = "string" required = true }
    param "ensure" { description = "Desired state: :present or :absent" type = "symbol" default = :present }
    param "remote" { description = "Remote to install from" type = "string" default = "flathub" }
  }

  resource "remote" {
    description = "Ensure a Flatpak remote is configured or absent"
    script = "resources/remote.ws"
    concurrency = "exclusive"
    param "name" { description = "Remote name" type = "string" required = true }
    param "url" { description = "Remote URL (required when :present)" type = "string" default = "" }
    param "ensure" { description = "Desired state: :present or :absent" type = "symbol" default = :present }
  }

  // Needs the network and a real flatpak install, so the test runs in a
  // Fedora VM with NAT. `remote` converges against flathub; `package` is
  // exercised through its absent path only — installing a real app pulls a
  // multi-hundred-megabyte runtime, which is scenario territory, not a
  // convergence test.
  test "remote_converges" {
    description = "The flathub remote is added and a second apply is a no-op"
    template = "x86_64/fedora-44"
    setup = "dnf install -y flatpak"
    verify = "tests/remote_verify.ws"

    step "flathub" {
      description = "Add the flathub remote"
      resource = "remote"
      properties {
        name = "flathub"
        url = "https://dl.flathub.org/repo/flathub.flatpakrepo"
        ensure = :present
      }
    }

    step "app_absent" {
      description = "An app that was never installed is already configured"
      resource = "package"
      expect = "already_configured"
      requires = ["flathub"]
      properties { id = "org.example.CwNeverInstalled" ensure = :absent }
    }
  }
}
