package "linux_snap" {
  description = "Manage snap packages"

  resource "package" {
    description = "Ensure a snap package is installed or absent"
    script = "resources/package.wisp"
    concurrency = "exclusive"
    param "name" { description = "Snap name" type = "string" required = true }
    param "ensure" { description = "Desired state: :present or :absent" type = "symbol" default = :present }
    param "classic" { description = "Install with classic confinement" type = "bool" default = false }
    param "channel" { description = "Channel to install from (e.g. latest/stable); empty means the default" type = "string" default = "" }
  }

  // snapd needs a live systemd and the network, so the test runs in an
  // Ubuntu VM with NAT rather than a container. `hello-world` is the
  // smallest real snap; installing it also pulls the `core` base, so the
  // apply run takes a couple of minutes.
  test "package_converges" {
    description = "A snap installs and a second apply is a no-op"
    template = "x86_64/ubuntu-24.04"
    setup = "systemctl start snapd.socket snapd.service && snap wait system seed.loaded"
    verify = "tests/package_verify.wisp"

    step "install" {
      description = "Install the hello-world snap"
      resource = "package"
      properties { name = "hello-world" ensure = :present }
    }

    step "absent_stays_absent" {
      description = "A snap that was never installed is already configured"
      resource = "package"
      expect = "already_configured"
      properties { name = "cw-never-installed" ensure = :absent }
    }
  }
}
