package "linux_accounts" {
  description = "Manage local Linux users, groups and per-user sudoers drop-ins"

  resource "group" {
    description = "Ensure a local group exists with the given gid, or is absent. Only /etc/group is consulted, so an LDAP or SSSD group of the same name neither satisfies :present nor blocks :absent. Changing the gid of an existing group runs groupmod -g, which does not re-own files that still carry the old gid"
    script = "resources/group.ws"
    concurrency = "exclusive"
    param "name" { description = "Group name: letters, digits, '_', '.' and '-', not starting with '-' or '.'" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the group, or set its gid" }
      symbol "absent"  { description = "Delete the group. Fails while it is still a user's primary group, so order that user's removal first with requires" }
    }
    param "gid" { description = "Numeric group id; 0 leaves it to groupadd and does not compare it" type = "int" default = 0 }
  }

  resource "user" {
    description = "Ensure a local user exists with the given uid, primary group, home and shell, or is absent. Only /etc/passwd is consulted, so a directory (LDAP/SSSD) user of the same name is not managed. An existing user is reconciled with a single usermod. A new home is moved there with usermod -m, unless the target directory already exists: then it is adopted as it is and the old home is left in place. Changing uid re-owns the files in the home directory only"
    script = "resources/user.ws"
    concurrency = "exclusive"
    param "name" { description = "User name: letters, digits, '_', '.' and '-', not starting with '-' or '.', optionally ending in '$'" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the user, or reconcile uid, group, home and shell" }
      symbol "absent"  { description = "Delete the user" }
    }
    param "uid" { description = "Numeric user id; 0 leaves it to useradd and does not compare it" type = "int" default = 0 }
    param "group" { description = "Primary group, by name or numeric gid; empty is not compared. The group must exist" type = "string" default = "" }
    param "home" { description = "Absolute home directory; empty is not compared" type = "string" default = "" }
    param "shell" { description = "Absolute login shell; empty is not compared" type = "string" default = "" }
    param "system" { description = "Create a system account (uid below UID_MIN from /etc/login.defs). Cannot change after creation: when uid is not set, an existing user on the other side of UID_MIN is an error in both check and apply. When uid is set, uid decides and this only affects creation. root passes either way" type = "bool" default = false }
    param "remove_home" { description = "When ensure = :absent: also remove the home directory and mail spool (userdel -r)" type = "bool" default = false }
  }

  resource "sudoers_user" {
    description = "Ensure a sudoers.d rule for a user exists or is absent"
    script = "resources/sudoers_user.ws"
    concurrency = "global"
    param "user" { description = "Account the rule applies to" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Write the sudoers.d rule" }
      symbol "absent"  { description = "Remove the sudoers.d rule" }
    }
    param "passwordless" { description = "Allow sudo without a password (NOPASSWD)" type = "bool" default = false }
    param "commands" { description = "Command specification for the rule" type = "string" default = "ALL" }
    param "validate" { description = "Run visudo validation when available" type = "bool" default = true }
  }

  // The absent steps converge on entities seeded during setup (run 1 checks
  // every step before any apply, so they cannot target state a present step
  // creates). Removal ordering: user before its primary group.
  test "accounts_converge" {
    description = "Accounts create and remove converge in a Debian container"
    image = "debian:12"
    // The seeded group is deliberately NOT named after the user: userdel
    // removes a same-named primary group itself (USERGROUPS_ENAB), which
    // would leave rm_group nothing to do.
    setup = "groupadd cwoldgrp && useradd -m -g cwoldgrp -s /bin/sh cwold && useradd -m -s /bin/sh cwkeephome && mkdir -p /etc/sudoers.d && printf 'cwold ALL=(ALL:ALL) ALL\\n' > /etc/sudoers.d/cwold && chmod 0440 /etc/sudoers.d/cwold"
    verify = "tests/accounts_verify.ws"

    step "group" {
      description = "Create group"
      resource = "group"
      properties { name = "cwtest" gid = 2050 }
    }

    step "user" {
      description = "Create user"
      resource = "user"
      requires = ["group"]
      properties { name = "cwtest" uid = 3050 group = "cwtest" home = "/home/cwtest" shell = "/bin/sh" }
    }

    step "system_user" {
      description = "Create a system account"
      resource = "user"
      properties { name = "cwsys" system = true shell = "/usr/sbin/nologin" }
    }

    step "sudo" {
      description = "Grant passwordless sudo"
      resource = "sudoers_user"
      requires = ["user"]
      properties { user = "cwtest" passwordless = true }
    }

    step "rm_sudo" {
      description = "Remove the seeded sudoers rule"
      resource = "sudoers_user"
      properties { user = "cwold" ensure = :absent }
    }

    step "rm_user" {
      description = "Remove the seeded user and its home"
      resource = "user"
      properties { name = "cwold" ensure = :absent remove_home = true }
    }

    step "rm_user_keep_home" {
      description = "Remove a seeded user but keep its home"
      resource = "user"
      properties { name = "cwkeephome" ensure = :absent }
    }

    step "rm_group" {
      description = "Remove the seeded group once its user is gone"
      resource = "group"
      requires = ["rm_user"]
      properties { name = "cwoldgrp" ensure = :absent }
    }
  }

  // Every existing account is seeded with the wrong uid, gid, group, home or
  // shell, so each reconcile path runs on a real usermod/groupmod.
  test "accounts_drift_converges" {
    description = "Existing users and groups are reconciled, and what cannot be is refused"
    image = "debian:12"
    setup = "groupadd -g 2100 cwnewprim && groupadd cwoldprim && useradd -m -u 3001 -g cwoldprim -s /bin/sh cwdrift && touch /home/cwdrift/keep && useradd -m -s /bin/sh cwexist && touch /home/cwexist/keep && mkdir -p /srv/cwtaken && touch /srv/cwtaken/theirs && groupadd -g 2200 cwgid && useradd -m -s /bin/sh cwreg"
    verify = "tests/accounts_drift_verify.ws"

    step "drift" {
      description = "Change uid, primary group (by gid), home and shell of an existing user"
      resource = "user"
      properties { name = "cwdrift" uid = 3500 group = "2100" home = "/srv/cwdrift" shell = "/bin/bash" }
    }

    step "existing_home" {
      description = "Point a user at a home directory that already exists"
      resource = "user"
      properties { name = "cwexist" home = "/srv/cwtaken" }
    }

    step "gid" {
      description = "Change an existing group's gid"
      resource = "group"
      properties { name = "cwgid" gid = 2201 }
    }

    step "system_mismatch" {
      description = "A regular user cannot become a system account"
      resource = "user"
      expect = "error"
      properties { name = "cwreg" system = true }
    }

    step "option_name" {
      description = "A user name that reads as an option is rejected"
      resource = "user"
      expect = "error"
      properties { name = "-ocw" }
    }

    step "bad_group_name" {
      description = "A group name with a line break is rejected"
      resource = "group"
      expect = "error"
      properties { name = "cw\nroot" }
    }

    step "bad_shell" {
      description = "A shell that would add a passwd field is rejected"
      resource = "user"
      expect = "error"
      properties { name = "cwreg" shell = "/bin/sh:0" }
    }
  }
}
