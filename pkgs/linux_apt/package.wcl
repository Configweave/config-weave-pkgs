package "linux_apt" {
  description = "Manage packages on apt/dpkg systems"

  resource "package" {
    description = "Ensure an apt package is installed, at an exact version if one is given, or absent. Installed means dpkg reports it installed: a removed package whose conffiles remain (the \"rc\" state) counts as absent. A package held with apt-mark is an error to change, version or removal alike; release the hold first with linux_apt.hold. apt-get waits up to five minutes for the dpkg lock, but different linux_apt resource types can still run at the same time, so order package, hold, debconf_selection and cache_updated steps with requires"
    script = "resources/package.ws"
    concurrency = "exclusive"
    param "name" { description = "Package name, optionally with :arch; must not start with '-'" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Install the package" }
      symbol "absent"  { description = "Remove the package with apt-get remove; its conffiles stay (the rc state)" }
    }
    param "version" { description = "Exact version to install when present, the full Debian version as apt-cache policy shows it including any epoch (1:2.38-1); empty means any version. A version below the installed one is a downgrade, which is allowed. This installs a version once; it does not stop later upgrades, which is what linux_apt.hold is for" type = "string" default = "" }
  }

  resource "cache_updated" {
    description = "Run apt-get update when the index is older than max_age"
    script = "resources/cache_updated.ws"
    concurrency = "exclusive"
    param "max_age" {
      description = "Refresh when the last update is older than this span"
      type = "duration"
      default = 24h
    }
  }

  resource "repository" {
    description = "Ensure an apt sources.list.d file exists or is absent"
    script = "resources/repository.ws"
    concurrency = "exclusive"
    param "name" { description = "Repository file basename without .list" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Write the sources.list.d file" }
      symbol "absent"  { description = "Remove the sources.list.d file" }
    }
    param "content" { description = "Repository file content (required when present)" type = "string" default = "" }
  }

  resource "signing_key" {
    description = "Ensure an apt signing key under /etc/apt/keyrings exists or is absent"
    script = "resources/signing_key.ws"
    concurrency = "exclusive"
    param "name" { description = "Keyring basename" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent (removes both .asc and .gpg)"
      type = "symbol"
      default = :present

      symbol "present" { description = "Install the signing key" }
      symbol "absent"  { description = "Remove the key, both .asc and .gpg" }
    }
    param "content" { description = "ASCII-armored GPG public key (required when present)" type = "string" default = "" }
    param "dearmor" { description = "Also produce a binary .gpg keyring via gpg --dearmor" type = "bool" default = true }
  }

  resource "hold" {
    description = "Ensure an apt-mark hold on a package is present or absent"
    script = "resources/hold.ws"
    concurrency = "exclusive"
    param "name" { description = "Package name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present (held) or :absent (not held)"
      type = "symbol"
      default = :present

      symbol "present" { description = "Hold the package at its current version" }
      symbol "absent"  { description = "Release the hold" }
    }
  }

  resource "debconf_selection" {
    description = "Pre-seed a debconf answer"
    script = "resources/debconf_selection.ws"
    concurrency = "exclusive"
    param "package" { description = "Owning package name" type = "string" required = true }
    param "question" { description = "debconf question name" type = "string" required = true }
    param "vtype" { description = "Answer type (string, boolean, select, ...)" type = "string" default = "string" }
    param "value" { description = "Answer value" type = "string" required = true }
  }

  test "existing_package" {
    description = "package can detect an installed Debian package"
    image = "debian:12"
    # Shares one container with the other debian tests (all debian:12, and
    # they touch unrelated state: an installed-package check vs. repo files).
    group = "debian"

    step "base-files-installed" {
      description = "base-files is already installed in Debian"
      resource = "package"
      expect = "already_configured"
      properties { name = "base-files" }
    }
  }

  // A real install over the container's NAT: `hello` is the smallest thing
  // in the archive, so the apply path is exercised without a slow download.
  test "package_installs" {
    description = "package installs a real package and removing it converges"
    image = "debian:12"
    group = "debian"
    setup = "apt-get update -qq"
    verify = "tests/apt_install_verify.ws"

    step "install" {
      description = "Install hello"
      resource = "package"
      properties { name = "hello" ensure = :present }
    }

    step "absent_stays_absent" {
      description = "A package that was never installed is already configured"
      resource = "package"
      expect = "already_configured"
      properties { name = "cw-no-such-package" ensure = :absent }
    }
  }

  // Versions, removal and holds against a local file repository of tiny
  // packages that setup builds with dpkg-deb, so every version exists and
  // stays put. Setup is idempotent: the group shares one container.
  test "package_versions" {
    description = "package pins versions (downgrades included), treats the rc state as absent, removes for real and guards dependents and holds"
    image = "debian:12"
    group = "debian"
    setup = <<'SETUP'
set -e
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
d=/srv/cw-repo
rm -rf "$d" && mkdir -p "$d"
mk() {
  b=$(mktemp -d) && mkdir -p "$b/DEBIAN"
  { printf 'Package: %s\nVersion: %s\nArchitecture: all\nMaintainer: cw <cw@config-weave.invalid>\n' "$1" "$2"; [ -z "$3" ] || echo "Depends: $3"; echo 'Description: config-weave test package'; } > "$b/DEBIAN/control"
  if [ "$1" = cw-rc ]; then mkdir -p "$b/etc" && echo x > "$b/etc/cw-rc.conf" && echo /etc/cw-rc.conf > "$b/DEBIAN/conffiles"; fi
  dpkg-deb -Zgzip --build "$b" "$d/$1_$2_all.deb" >/dev/null && rm -rf "$b"
}
mk cw-pin 1.0 ''; mk cw-pin 2.0 ''; mk cw-held 1.0 ''; mk cw-held 2.0 ''
mk cw-rc 1.0 ''; mk cw-gone 1.0 ''
mk cw-base 1.0 ''; mk cw-dep 1.0 cw-base
mk cw-base2 1.0 ''; mk cw-dep2 1.0 cw-base2
cd "$d" && for f in *.deb; do dpkg-deb -f "$f"; printf 'Filename: ./%s\nSize: %s\nSHA256: %s\n\n' "$f" "$(stat -c %s "$f")" "$(sha256sum "$f" | cut -d' ' -f1)"; done > Packages
echo 'deb [trusted=yes] file:/srv/cw-repo ./' > /etc/apt/sources.list.d/cw-local.list
apt-get update -qq
apt-mark unhold cw-held >/dev/null
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --allow-downgrades cw-pin=2.0 cw-held=2.0 cw-rc cw-gone cw-dep cw-dep2 >/dev/null
apt-mark hold cw-held >/dev/null
dpkg -r cw-rc >/dev/null
SETUP
    verify = "tests/apt_versions_verify.ws"

    step "rc_state_pin" {
      description = "A removed package whose conffiles remain is not installed, even at the pinned version"
      resource = "package"
      properties { name = "cw-rc" version = "1.0" }
    }

    step "downgrade" {
      description = "Pin below the installed version"
      resource = "package"
      requires = ["rc_state_pin"]
      properties { name = "cw-pin" version = "1.0" }
    }

    step "remove" {
      description = "Remove an installed package"
      resource = "package"
      requires = ["downgrade"]
      properties { name = "cw-gone" ensure = :absent }
    }

    step "held_pin" {
      description = "A held package is not silently re-versioned"
      resource = "package"
      expect = "error"
      requires = ["remove"]
      properties { name = "cw-held" version = "1.0" }
    }

    step "option_name" {
      description = "A name apt would read as an option is rejected"
      resource = "package"
      expect = "error"
      properties { name = "--purge" }
    }
  }

  // The absent steps converge on files seeded during setup (run 1 checks
  // every step before any apply).
  test "repositories_and_keys_converge" {
    description = "repository and signing_key add and remove converge"
    image = "debian:12"
    group = "debian"
    setup = "mkdir -p /etc/apt/sources.list.d /etc/apt/keyrings && echo 'deb http://stale.invalid/debian bookworm main' > /etc/apt/sources.list.d/cw-stale.list && echo stale-key > /etc/apt/keyrings/cw-stale.asc"
    verify = "tests/apt_repository_verify.ws"

    step "repo" {
      description = "Write repository file"
      resource = "repository"
      properties {
        name = "config-weave-test"
        content = "deb http://deb.debian.org/debian bookworm main\n"
      }
    }

    step "rm_repo" {
      description = "Remove the seeded stale repository"
      resource = "repository"
      properties { name = "cw-stale" ensure = :absent }
    }

    step "key" {
      description = "Install an apt signing key (armored, no dearmor)"
      resource = "signing_key"
      properties {
        name = "cw-test"
        dearmor = false
        content = "-----BEGIN PGP PUBLIC KEY BLOCK-----\n\nmDMEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n-----END PGP PUBLIC KEY BLOCK-----\n"
      }
    }

    step "rm_key" {
      description = "Remove the seeded stale key"
      resource = "signing_key"
      properties { name = "cw-stale" ensure = :absent }
    }
  }

  // Untested by design: cache_updated hits the network (apt-get update),
  // which does not converge honestly in an offline container.
  //
  // The apt steps are chained with `requires`: `exclusive` only serializes
  // steps of the SAME resource type, but package/hold/debconf all contend
  // for the one dpkg lock, so mixing them concurrently fails.
  // Playbooks mixing these resources need the same ordering.
  test "apt_state_changes" {
    description = "Removal, holds and debconf selections converge offline on Debian"
    image = "debian:12"
    group = "debian"
    setup = "apt-mark hold gzip >/dev/null"
    verify = "tests/apt_state_verify.ws"

    step "remove" {
      description = "Remove the preinstalled tzdata package (offline)"
      resource = "package"
      properties { name = "tzdata" ensure = :absent }
    }

    step "hold" {
      description = "Hold base-files at its current version"
      resource = "hold"
      requires = ["remove"]
      properties { name = "base-files" }
    }

    step "unhold" {
      description = "Release the hold setup placed on gzip"
      resource = "hold"
      requires = ["hold"]
      properties { name = "gzip" ensure = :absent }
    }

    step "debconf" {
      description = "Pre-seed a debconf answer"
      resource = "debconf_selection"
      requires = ["unhold"]
      properties { package = "cw-test" question = "cw-test/enable" vtype = "boolean" value = "true" }
    }
  }
}
