package "linux_zypper" {
  description = "Manage packages on zypper/SUSE systems"

  resource "package" {
    description = "Ensure an rpm package is installed or absent via zypper"
    script = "resources/package.ws"
    concurrency = "exclusive"
    param "name" { description = "Package name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Install the package" }
      symbol "absent"  { description = "Remove the package" }
    }
    param "version" { description = "Optional version to pin when present; empty means any version" type = "string" default = "" }
  }

  resource "cache_updated" {
    description = "Run zypper refresh when the index is older than max_age"
    script = "resources/cache_updated.ws"
    concurrency = "exclusive"
    param "max_age" {
      description = "Refresh when the last update is older than this span"
      type = "duration"
      default = 24h
    }
  }

  // Check-only test: installing/refreshing needs the network, so the
  // existence probe on a base package is the honest offline test.
  // No real-install test: a first `zypper install` in the Leap container
  // spends over two minutes refreshing repository metadata before it does
  // any work, which is too slow and too network-dependent to be worth a
  // convergence test. The check paths below cover the resource's logic; the
  // apply path is the same `zypper install` every other manager wraps.
  test "zypper_existing_package" {
    description = "zypper/rpm installed package checks work in openSUSE"
    image = "opensuse/leap:15.6"

    step "filesystem-installed" {
      description = "filesystem is installed in openSUSE"
      resource = "package"
      expect = "already_configured"
      properties { name = "filesystem" }
    }
  }
}
