package "linux_pacman" {
  description = "Manage packages on pacman/Arch systems"

  resource "package" {
    description = "Ensure a pacman package is installed or absent"
    script = "resources/package.ws"
    concurrency = "exclusive"
    param "name" { description = "Package name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Install the package" }
      symbol "absent"  { description = "Remove the package" }
    }
  }

  resource "cache_updated" {
    description = "Run pacman -Sy when the index is older than max_age"
    script = "resources/cache_updated.ws"
    concurrency = "exclusive"
    param "max_age" {
      description = "Refresh when the last update is older than this span"
      type = "duration"
      default = 24h
    }
  }

  resource "aur_package" {
    description = "Ensure an AUR package is installed or absent via yay/paru"
    script = "resources/aur_package.ws"
    concurrency = "exclusive"
    param "name" { description = "AUR package name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Build and install the AUR package" }
      symbol "absent"  { description = "Remove the package" }
    }
    param "helper" { description = "AUR helper: auto (detect yay then paru), yay or paru" type = "string" default = "auto" }
    param "user" { description = "Non-root user to build/install as (AUR builds cannot run as root)" type = "string" required = true }
  }

  // Check-only test: installing anything needs the network, and aur_package
  // additionally needs an AUR helper and a build user. The existence probe
  // on a base package is the honest offline test.
  // A real install over the container's NAT. The resource runs `pacman -S`
  // without `-y` on purpose — syncing the package database is an operator
  // decision, not something a convergence step should do behind your back —
  // so setup syncs it first, exactly as a playbook would.
  test "package_installs" {
    description = "package installs a real package and removing it converges"
    image = "archlinux:latest"
    setup = "pacman -Sy --noconfirm"
    verify = "tests/pacman_install_verify.ws"

    step "install" {
      description = "Install tree"
      resource = "package"
      properties { name = "tree" ensure = :present }
    }

    step "absent_stays_absent" {
      description = "A package that was never installed is already configured"
      resource = "package"
      expect = "already_configured"
      properties { name = "cw-no-such-package" ensure = :absent }
    }
  }

  test "pacman_existing_package" {
    description = "pacman installed package checks work in Arch"
    image = "archlinux:latest"

    step "filesystem-installed" {
      description = "filesystem is installed in Arch"
      resource = "package"
      expect = "already_configured"
      properties { name = "filesystem" }
    }
  }
}
