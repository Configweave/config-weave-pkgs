package "linux_runit" {
  description = "Manage runit services (Void)"

  // One resource for the whole service: its definition directory under
  // sv_dir, whether it is linked into the supervised service directory, and
  // whether it is up. `state` and `enabled` default to :unmanaged so this can
  // install a definition without also deciding those, or manage an existing
  // service without supplying a run script.
  resource "service" {
    description = "Ensure a runit service's run script, service-directory link and running state"
    script = "resources/service.ws"
    concurrency = "exclusive"
    param "name" { description = "Service name, and the directory name under sv_dir" type = "string" required = true }
    param "ensure" {
      description = "Whether the service is installed"
      type = "symbol"
      default = :present

      symbol "present" { description = "The service definition exists under sv_dir" }
      symbol "absent"  { description = "Unlink the service and delete its definition directory" }
    }
    param "run" { description = "Body of the service's run script; empty manages an existing definition without rewriting it" type = "string" default = "" }
    param "state" {
      description = "Runtime state to enforce"
      type = "symbol"
      default = :unmanaged

      symbol "running"   { description = "Bring the service up" }
      symbol "stopped"   { description = "Bring the service down" }
      symbol "unmanaged" { description = "Leave the runtime state alone" }
    }
    param "enabled" {
      description = "Whether the service is linked into the supervised service directory"
      type = "symbol"
      default = :unmanaged

      symbol "enabled"   { description = "Link the definition into the service directory" }
      symbol "disabled"  { description = "Remove the link, ending supervision" }
      symbol "unmanaged" { description = "Leave the link alone" }
    }
    param "sv_dir" { description = "Service definition directory" type = "string" default = "/etc/sv" }
    param "service_dir" { description = "Active (supervised) service directory" type = "string" default = "/var/service" }
  }

  // `sv` needs a live runsvdir supervising the service directory, so the
  // test runs in a VM. Void has no vmlab template yet; runit from Ubuntu's
  // archive is the same upstream, and setup stands up a real runsvdir (as a
  // transient systemd unit so it outlives the setup exec) over the throwaway
  // services the steps act on.
  test "service_converges" {
    description = "A service is installed and supervised, one is stopped, and a seeded one is removed"
    template = "x86_64/ubuntu-24.04"
    setup = "apt-get install -y -qq runit && mkdir -p /var/service /etc/sv/cw-stop /etc/sv/cw-seeded && for s in cw-stop cw-seeded; do printf '#!/bin/sh\\nexec sleep 3600\\n' > /etc/sv/$s/run; chmod +x /etc/sv/$s/run; done && systemd-run --unit=cw-runsvdir --collect runsvdir /var/service && sleep 1 && ln -sfn /etc/sv/cw-stop /var/service/cw-stop && for i in $(seq 1 30); do [ -e /var/service/cw-stop/supervise/ok ] && break; sleep 1; done"
    verify = "tests/service_verify.ws"

    // cw-stop is supervised and running after setup, so stopping it is a
    // real convergence rather than a no-op.
    step "stop" {
      description = "Stop a supervised service"
      resource = "service"
      properties { name = "cw-stop" state = :stopped }
    }

    // A service this resource installs from scratch, run script and all.
    step "install" {
      description = "Install a run script, link it and bring it up"
      resource = "service"
      requires = ["stop"]
      properties {
        name = "cw-managed"
        enabled = :enabled
        state = :running
        run = <<'RUN'
#!/bin/sh
exec sleep 3600
RUN
      }
    }

    // cw-seeded has a definition but was never linked, so :absent still has
    // the definition directory to remove.
    step "remove" {
      description = "Remove the service definition seeded during setup"
      resource = "service"
      requires = ["install"]
      properties { name = "cw-seeded" ensure = :absent }
    }
  }
}
