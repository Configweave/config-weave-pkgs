package "linux_kde" {
  description = "Manage KDE Plasma configuration files"

  gatherer "kde_paths" {
    description = "Report KDE user configuration and data paths, and whether the Plasma 6 config tools are on PATH"
    script = "gatherers/kde_paths.ws"
    returns "home" { description = "Resolved home directory" type = "string" }
    returns "config_dir" { description = "KDE config directory (~/.config)" type = "string" }
    returns "local_share_dir" { description = "KDE data directory (~/.local/share)" type = "string" }
    returns "has_kreadconfig6" { description = "True when kreadconfig6 is on PATH" type = "bool" }
    returns "has_kwriteconfig6" { description = "True when kwriteconfig6 is on PATH" type = "bool" }
    returns "has_plasma_apply_colorscheme" { description = "True when plasma-apply-colorscheme is on PATH" type = "bool" }
    param "home" { description = "Target home directory; defaults to the home of the account config-weave runs as, from the passwd database ($HOME only when that lookup fails)" type = "string" default = "" }
  }

  gatherer "kde_version" {
    description = "Detect the installed Plasma version and KConfig command-line tools, searching PATH"
    script = "gatherers/kde_version.ws"
    returns "plasma_major" { description = "Plasma major version from plasmashell --version (0 when plasmashell is not installed)" type = "int" }
    returns "kconfig_tools_major" { description = "Major version of the newest kreadconfig/kwriteconfig tools on PATH: 6, 5, or 0 when neither" type = "int" }
    returns "has_kreadconfig6" { description = "True when kreadconfig6 or kwriteconfig6 is on PATH" type = "bool" }
    returns "has_legacy_kconfig_tools" { description = "True when only the KDE Frameworks 5 tools (kreadconfig5/kwriteconfig5) are on PATH, with no 6 tools" type = "bool" }
  }

  resource "kconfig_entry" {
    description = "Ensure a KConfig key is present in or absent from a KDE configuration file"
    script = "resources/kconfig_entry.ws"
    // read-modify-write on one config file — parallel steps on the same file
    // lose writes
    concurrency = "exclusive"
    param "home" { description = "Target home directory; defaults to the current user home" type = "string" default = "" }
    param "file" { description = "KDE config filename under ~/.config, such as kdeglobals or kwinrc" type = "string" required = true }
    param "group" { description = "KConfig group name" type = "string" required = true }
    param "subgroup" { description = "Optional KConfig subgroup name" type = "string" default = "" }
    param "key" { description = "KConfig key name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Set the key" }
      symbol "absent"  { description = "Remove the key" }
    }
    param "value" { description = "Desired string value (required when present)" type = "string" default = "" }
  }

  test "kconfig_converges" {
    description = "kconfig_entry adds and removes keys without a Plasma session"
    image = "debian:12"
    setup = "mkdir -p /tmp/cw-kde-home/.config && printf '[General]\\nloginMode=restoreSession\\nstale=yes\\n' > /tmp/cw-kde-home/.config/ksmserverrc"
    verify = "tests/kconfig_verify.ws"

    gather "version" {
      description = "KDE detection reports nothing without installed KDE tools"
      from = "kde_version"
      expect {
        plasma_major = 0
        kconfig_tools_major = 0
        has_kreadconfig6 = false
        has_legacy_kconfig_tools = false
      }
    }

    step "kdeglobals" {
      description = "Write a kdeglobals KConfig entry"
      resource = "kconfig_entry"
      properties { home = "/tmp/cw-kde-home" file = "kdeglobals" group = "KDE" key = "SingleClick" value = "false" }
    }

    step "kwin" {
      description = "Write a kwinrc setting"
      resource = "kconfig_entry"
      properties { home = "/tmp/cw-kde-home" file = "kwinrc" group = "Windows" key = "FocusPolicy" value = "ClickToFocus" }
    }

    step "subgrouped" {
      description = "Write an entry in a subgroup section"
      resource = "kconfig_entry"
      properties { home = "/tmp/cw-kde-home" file = "kdeglobals" group = "General" subgroup = "Fonts" key = "fixed" value = "Hack,10" }
    }

    step "update-existing" {
      description = "Update a key seeded during setup"
      resource = "kconfig_entry"
      properties { home = "/tmp/cw-kde-home" file = "ksmserverrc" group = "General" key = "loginMode" value = "emptySession" }
    }

    step "remove-stale" {
      description = "Remove a key seeded during setup"
      resource = "kconfig_entry"
      properties { home = "/tmp/cw-kde-home" file = "ksmserverrc" group = "General" key = "stale" ensure = :absent }
    }
  }

  test "kde_tools_plasma6" {
    description = "kde_version reports Plasma 6 and the 6 tools, which win over the 5 tools"
    image = "debian:12"
    setup = "for t in kreadconfig5 kwriteconfig5 kreadconfig6; do printf '#!/bin/sh\\nexit 0\\n' > /usr/local/bin/$t; done && printf '#!/bin/sh\\necho plasmashell 6.2.4\\n' > /usr/local/bin/plasmashell && chmod +x /usr/local/bin/*"

    gather "version" {
      description = "Plasma 6 with both tool generations installed"
      from = "kde_version"
      expect {
        plasma_major = 6
        kconfig_tools_major = 6
        has_kreadconfig6 = true
        has_legacy_kconfig_tools = false
      }
    }

    gather "paths" {
      description = "kde_paths finds kreadconfig6 on PATH outside /usr/bin"
      from = "kde_paths"
      expect {
        has_kreadconfig6 = true
        has_kwriteconfig6 = false
      }
    }
  }

  test "kde_tools_plasma5" {
    description = "kde_version reports Plasma 5 with only the legacy tools"
    image = "debian:12"
    setup = "printf '#!/bin/sh\\nexit 0\\n' > /usr/local/bin/kwriteconfig5 && printf '#!/bin/sh\\necho plasmashell 5.27.11\\n' > /usr/local/bin/plasmashell && chmod +x /usr/local/bin/kwriteconfig5 /usr/local/bin/plasmashell"

    gather "version" {
      description = "Plasma 5 with only the 5 tools"
      from = "kde_version"
      expect {
        plasma_major = 5
        kconfig_tools_major = 5
        has_kreadconfig6 = false
        has_legacy_kconfig_tools = true
      }
    }
  }
}
