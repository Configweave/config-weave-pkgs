package "windows_account" {
  description = "Manage local and Active Directory users and groups"

  // Passwords: every password param is passed to PowerShell through an
  // environment variable, never in the script text, so it does not show up
  // on a command line or in an error message. Keep it out of the playbook
  // source too: write it as secret("...").
  //
  // Password drift is detected by trying a network logon with the wanted
  // password (LogonUser). A disabled, expired or must-change account still
  // validates, because Windows reports those only after the password
  // matched. A wrong password counts toward the account lockout threshold
  // (10 attempts on a stock Server 2025), so every check of a drifted
  // password costs one failed logon until apply resets it.
  resource "local_user" {
    description = "Ensure a local user account exists with the desired attributes and password, or is absent"
    script = "resources/local_user.ws"
    concurrency = "exclusive"
    param "name" { description = "Local account name. The characters \" / \\ [ ] : ; | = , + * ? < > are refused" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the account" }
      symbol "absent"  { description = "Delete the account" }
    }
    param "password" { description = "Account password; use secret(\"...\"). Checked by a logon attempt and re-set when it no longer validates. Empty leaves the password unmanaged, and creates a new account with no password" type = "string" default = "" }
    param "full_name" { description = "Full (display) name; empty leaves it unmanaged" type = "string" default = "" }
    param "description" { description = "Account description; empty leaves it unmanaged" type = "string" default = "" }
    param "disabled" { description = "Whether the account should be disabled" type = "bool" default = false }
    param "password_never_expires" { description = "Whether the password is exempt from the maximum password age (the SAM's DONT_EXPIRE_PASSWD flag). true: the password never expires; false: it expires under the maximum password age (42 days on a stock Server). Omit to leave it unmanaged" type = "bool" }
    param "account_never_expires" { description = "true: the account has no expiry date (Get-LocalUser's AccountExpires is empty), and an existing one is cleared. false is an error, because it needs an expiry date this resource does not manage. Omit to leave the expiry unmanaged" type = "bool" }
  }

  resource "local_group" {
    description = "Ensure a local group exists, or is absent"
    script = "resources/local_group.ws"
    concurrency = "exclusive"
    param "name" { description = "Local group name. The characters \" / \\ [ ] : ; | = , + * ? < > are refused" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the group" }
      symbol "absent"  { description = "Delete the group" }
    }
    param "description" { description = "Group description; empty leaves it unmanaged" type = "string" default = "" }
  }

  // Membership is compared by SID, read through ADSI: Get-LocalGroupMember
  // fails outright on a group that holds an orphaned SID (error 1789).
  resource "local_group_member" {
    description = "Ensure an account is (or is not) a member of a local group, compared by SID"
    script = "resources/local_group_member.ws"
    concurrency = "exclusive"
    param "group" { description = "Local group name" type = "string" required = true }
    param "member" { description = "Member account: a bare NAME means the local account COMPUTERNAME\\NAME only; write domain accounts and built-in principals qualified (CORP\\alice, NT AUTHORITY\\NETWORK SERVICE), or give a UPN or a SID string" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the account to the group (the group must exist)" }
      symbol "absent"  { description = "Remove exactly the account the member name resolves to; a name that resolves to no account is already absent" }
    }
  }

  // The AD resources need the ActiveDirectory PowerShell module
  // (RSAT-AD-PowerShell, present on every DC) and an account with rights
  // over the objects. 'server' picks the DC or domain they talk to.
  resource "ad_user" {
    description = "Ensure an Active Directory user exists with the desired attributes, password and OU, or is absent (requires the ActiveDirectory PowerShell module)"
    script = "resources/ad_user.ws"
    concurrency = "exclusive"
    param "name" { description = "SamAccountName of the user (also the CN of a new account)" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the directory user" }
      symbol "absent"  { description = "Delete the directory user" }
    }
    param "password" { description = "Account password; use secret(\"...\"). Checked by a logon attempt through this machine's domain logon (so the machine must be in, or trust, the user's domain) and reset when it no longer validates. A disabled account's password cannot be checked (the domain reports the account disabled first), so it is left alone while the account is disabled. Required in practice to create an enabled account. Empty leaves it unmanaged" type = "string" default = "" }
    param "upn" { description = "UserPrincipalName (compared case-insensitively); empty leaves it unmanaged" type = "string" default = "" }
    param "display_name" { description = "DisplayName; empty leaves it unmanaged" type = "string" default = "" }
    param "ou_path" { description = "Distinguished name of the OU the user belongs in; an existing user elsewhere is moved there (Move-ADObject). Empty leaves placement unmanaged" type = "string" default = "" }
    param "enabled" { description = "Whether the account should be enabled" type = "bool" default = true }
    param "server" { description = "Domain controller or domain to use (-Server); empty uses the machine's own domain" type = "string" default = "" }
  }

  resource "ad_group" {
    description = "Ensure an Active Directory group exists with the desired scope, category and OU, or is absent (requires the ActiveDirectory PowerShell module)"
    script = "resources/ad_group.ws"
    concurrency = "exclusive"
    param "name" { description = "SamAccountName of the group" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the directory group" }
      symbol "absent"  { description = "Delete the directory group" }
    }
    // AD converts Global and DomainLocal only to and from Universal, so a
    // change between those two goes through Universal. AD still refuses a
    // conversion the current members or memberships rule out, and that
    // error is reported.
    param "scope" {
      description = "Group scope. Global <-> DomainLocal changes step through Universal"
      type = "symbol"
      default = :global

      symbol "global"      { description = "Global — members from this domain, granted access in any domain" }
      symbol "universal"   { description = "Universal — members and access across the whole forest" }
      symbol "domainlocal" { description = "DomainLocal — members from any domain, access in this domain only" }
    }
    param "category" {
      description = "Group category"
      type = "symbol"
      default = :security

      symbol "security"     { description = "Security — can be granted permissions" }
      symbol "distribution" { description = "Distribution — mail distribution only, carries no permissions" }
    }
    param "ou_path" { description = "Distinguished name of the OU the group belongs in; an existing group elsewhere is moved there (Move-ADObject). Empty leaves placement unmanaged" type = "string" default = "" }
    param "server" { description = "Domain controller or domain to use (-Server); empty uses the machine's own domain" type = "string" default = "" }
  }

  // The member is resolved to one distinguished name, and that DN is both
  // what check searches the group's 'member' attribute for and what apply
  // writes, so the two cannot disagree. The search is server-side, so it
  // works at any group size; Get-ADGroupMember stops at 5000.
  resource "ad_group_member" {
    description = "Ensure a directory object is (or is not) a member of an Active Directory group (requires the ActiveDirectory PowerShell module)"
    script = "resources/ad_group_member.ws"
    concurrency = "exclusive"
    param "group" { description = "SamAccountName of the group" type = "string" required = true }
    param "member" { description = "Member: a sAMAccountName (a computer's ends in $), a distinguished name, or a SID string; it must resolve to exactly one object in the domain" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the object to the group (membership through the member's primary group counts)" }
      symbol "absent"  { description = "Remove the object from the group. A primary-group membership cannot be removed this way and is reported as an error" }
    }
    param "server" { description = "Domain controller or domain to use (-Server); empty uses the machine's own domain" type = "string" default = "" }
  }

  // The win2025 instance is a plain workgroup server, so the local account
  // resources get real converge coverage while the AD resources assert their
  // module guard: without RSAT the ActiveDirectory module is absent, so both
  // check and apply raise the documented error. The AD resources converge
  // against a real domain controller in the ad_accounts scenario.
  test "local_accounts_converge" {
    description = "Local user, group and membership converge; the AD resources guard on the missing AD module"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    verify = "tests/accounts_verify.ws"

    step "ops_group" {
      description = "Create the weave-ops local group"
      resource = "local_group"
      properties { name = "weave-ops" description = "config-weave test group" }
    }

    // The password must not embed the account name or full name: Windows
    // complexity rules reject any run of 3+ characters from either, so
    // "Weave-..." for user "weave-svc" fails with InvalidPasswordException.
    step "svc_user" {
      description = "Create the weave-svc local user"
      resource = "local_user"
      properties {
        name = "weave-svc"
        password = "Qx7!vTr9pLm2#Zk4"
        full_name = "Weave Service"
        description = "config-weave test account"
        password_never_expires = true
        account_never_expires = true
      }
    }

    step "account_expiry_false_refused" {
      description = "account_never_expires = false needs an expiry date the resource does not take, so it is an error"
      resource = "local_user"
      expect = "error"
      properties { name = "weave-expiring" account_never_expires = false }
    }

    step "ghost_user_absent_ignores_expiry" {
      description = "With ensure = absent the expiry params are ignored, so false is no error"
      resource = "local_user"
      expect = "already_configured"
      properties { name = "weave-ghost" ensure = :absent account_never_expires = false password_never_expires = false }
    }

    step "svc_in_ops" {
      description = "Put weave-svc into weave-ops"
      resource = "local_group_member"
      requires = ["ops_group", "svc_user"]
      properties { group = "weave-ops" member = "weave-svc" }
    }

    step "ghost_user_absent" {
      description = "A never-created user with ensure = absent is already configured"
      resource = "local_user"
      expect = "already_configured"
      properties { name = "weave-ghost" ensure = :absent }
    }

    step "wildcard_name_refused" {
      description = "A name holding a wildcard is refused rather than matched"
      resource = "local_user"
      expect = "error"
      properties { name = "weave-*" ensure = :absent }
    }

    step "ad_user_needs_module" {
      description = "ad_user errors when the ActiveDirectory module is unavailable"
      resource = "ad_user"
      expect = "error"
      properties { name = "weave-ad-user" password = "Qx7!vTr9pLm2#Zk4" }
    }

    step "ad_group_needs_module" {
      description = "ad_group errors when the ActiveDirectory module is unavailable"
      resource = "ad_group"
      expect = "error"
      properties { name = "weave-ad-group" }
    }

    step "ad_group_member_needs_module" {
      description = "ad_group_member errors when the ActiveDirectory module is unavailable"
      resource = "ad_group_member"
      expect = "error"
      properties { group = "weave-ad-group" member = "weave-ad-user" }
    }
  }

  // Setup seeds a user and a group that drift in every managed attribute,
  // the password included, and puts NT AUTHORITY\NETWORK SERVICE in the
  // group. The bare name "NETWORK SERVICE" means COMPUTERNAME\NETWORK SERVICE,
  // which does not exist, so its :absent step must leave the built-in
  // account in place. Setup runs under cmd /C: no double quotes.
  test "local_accounts_drift" {
    description = "Password, full name, description, disabled and never-expires drift is corrected; a bare member name never matches a qualified one"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    setup = "powershell -NoProfile -Command New-LocalUser -Name weave-drift -Password (ConvertTo-SecureString 'Old-Pw-55aa!x' -AsPlainText -Force) -FullName 'Wrong Name' -Description wrong; New-LocalGroup -Name weave-drift-grp -Description wrong; Add-LocalGroupMember -Group weave-drift-grp -Member 'NT AUTHORITY\\NETWORK SERVICE'"
    verify = "tests/accounts_drift_verify.ws"

    step "drift_user" {
      description = "Every attribute of weave-drift, and its password, is brought back"
      resource = "local_user"
      properties {
        name = "weave-drift"
        password = "Qx7!vTr9pLm2#Zk4"
        full_name = "Drift Fixed"
        description = "fixed"
        disabled = true
        password_never_expires = true
      }
    }

    step "drift_group" {
      description = "The group description is brought back"
      resource = "local_group"
      properties { name = "weave-drift-grp" description = "fixed" }
    }

    step "bare_name_absent" {
      description = "A bare NETWORK SERVICE is the (missing) local account, so nothing is removed"
      resource = "local_group_member"
      expect = "already_configured"
      properties { group = "weave-drift-grp" member = "NETWORK SERVICE" ensure = :absent }
    }
  }

  // Setup turns on a maximum password age (the template's may be unlimited,
  // which would hide every PasswordExpires date), then seeds two users with
  // Windows' defaults (the password expires) and gives weave-exp an account
  // expiry date. weave-exp is brought to "never expires" for both, and the
  // next test flips its password back; weave-plain names neither param, so
  // its expiring password is not drift. Setup runs under cmd /C: no double
  // quotes.
  test "local_user_expiry" {
    description = "password_never_expires and account_never_expires converge on an existing user; leaving them unset is not drift"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    setup = "net accounts /maxpwage:42 >nul & powershell -NoProfile -Command New-LocalUser -Name weave-exp -Password (ConvertTo-SecureString 'Old-Pw-55aa!x' -AsPlainText -Force) -AccountExpires (Get-Date).AddDays(30); New-LocalUser -Name weave-plain -Password (ConvertTo-SecureString 'Old-Pw-55aa!x' -AsPlainText -Force)"
    verify = "tests/expiry_verify.ws"

    step "exp_never" {
      description = "weave-exp's password and account stop expiring"
      resource = "local_user"
      properties { name = "weave-exp" password_never_expires = true account_never_expires = true }
    }

    step "plain_unmanaged" {
      description = "weave-plain's expiring password is left alone when neither param is set"
      resource = "local_user"
      expect = "already_configured"
      properties { name = "weave-plain" }
    }

    step "nopw_expires" {
      description = "A new account with no password and password_never_expires = false"
      resource = "local_user"
      properties { name = "weave-nopw" password_never_expires = false account_never_expires = true }
    }
  }

  // Runs after local_user_expiry in the same instance: weave-exp's password
  // now never expires, and false turns the maximum password age back on.
  // account_never_expires is unset here, so the account stays non-expiring.
  test "local_user_expiry_flip" {
    description = "password_never_expires = false makes a never-expiring password expire again"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    verify = "tests/expiry_flip_verify.ws"

    step "exp_expires" {
      description = "weave-exp's password expires again"
      resource = "local_user"
      properties { name = "weave-exp" password_never_expires = false }
    }
  }

  // Setup creates a user, a group and the membership; each :absent step
  // then has something real to remove. Setup runs under cmd /C.
  test "local_accounts_absent" {
    description = "ensure = :absent removes a real membership, user and group"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    setup = "powershell -NoProfile -Command New-LocalUser -Name weave-rm -NoPassword; New-LocalGroup -Name weave-rm-grp; Add-LocalGroupMember -Group weave-rm-grp -Member weave-rm"
    verify = "tests/accounts_absent_verify.ws"

    step "rm_member" {
      description = "Take weave-rm out of weave-rm-grp"
      resource = "local_group_member"
      properties { group = "weave-rm-grp" member = "weave-rm" ensure = :absent }
    }

    step "rm_user" {
      description = "Delete weave-rm"
      resource = "local_user"
      requires = ["rm_member"]
      properties { name = "weave-rm" ensure = :absent }
    }

    step "rm_group" {
      description = "Delete weave-rm-grp"
      resource = "local_group"
      requires = ["rm_member"]
      properties { name = "weave-rm-grp" ensure = :absent }
    }
  }

  // The AD resources against a real directory: one server promoted to a
  // DC by plain PowerShell. Users, groups and memberships converge, have
  // drift seeded behind their backs (password, display name, enabled, OU,
  // a Global-to-DomainLocal scope change), converge again, and are removed.
  scenario "ad_accounts" {
    description = "ad_user, ad_group and ad_group_member converge, reconcile and remove against a real DC"
    lab = "tests/ad-lab"
    script = "tests/ad_accounts.ws"
  }
}
