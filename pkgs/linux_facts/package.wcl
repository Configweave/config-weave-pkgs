package "linux_facts" {
  description = "Gather Linux operating system facts"

  gatherer "os_release" {
    description = "Read os-release (/etc/os-release, falling back to /usr/lib/os-release) and kernel facts. Values are unquoted the way os-release(5) specifies: single quotes literally, double quotes with backslash escapes"
    script = "gatherers/os_release.ws"
    returns "family" { description = "OS family (linux, windows, macos)" type = "string" }
    returns "name" { description = "OS name" type = "string" }
    returns "version" { description = "OS version" type = "string" }
    returns "kernel" { description = "Kernel version" type = "string" }
    returns "arch" { description = "CPU architecture" type = "string" }
    returns "id" { description = "os-release ID (debian, arch, ...)" type = "string" }
    returns "version_id" { description = "os-release VERSION_ID" type = "string" }
    returns "pretty_name" { description = "os-release PRETTY_NAME" type = "string" }
  }

  gatherer "init_system" {
    description = "Detect the init/service manager from PID 1 (/proc/1/comm and, when readable, /proc/1/exe), not from which tools are installed. In a container whose PID 1 is a plain entrypoint this is :unknown"
    script = "gatherers/init_system.ws"
    returns "init" {
      description = "Detected init/service manager"
      type = "symbol"
      symbol "systemd"  { description = "systemd is PID 1" }
      symbol "openrc"   { description = "OpenRC: PID 1 is openrc-init, or /run/openrc exists (OpenRC booted under sysvinit's or busybox's init)" }
      symbol "runit"    { description = "runit is PID 1" }
      symbol "sysvinit" { description = "SysV init: PID 1 is an init reading /etc/inittab, other than busybox's" }
      symbol "unknown"  { description = "PID 1 is none of the above, such as a container entrypoint" }
    }
  }

  gatherer "network" {
    description = "Enumerate network interfaces and detect the network management system"
    script = "gatherers/network.ws"
    returns "interfaces" { description = "One { name, mac, state, ipv4, ipv6 } map per interface" type = "list" }
    returns "network_system" { description = "Detected network manager (netplan, NetworkManager, systemd-networkd, wicked, ifupdown, unknown)" type = "string" }
  }

  gatherer "services" {
    description = "List systemd services and their active state"
    script = "gatherers/services.ws"
    returns "services" { description = "One { name, active, sub } map per service unit; empty without systemd" type = "list" }
  }

  gatherer "mounts" {
    description = "List mounted filesystems from /proc/mounts"
    script = "gatherers/mounts.ws"
    returns "count" { description = "Number of mounted filesystems" type = "int" }
    returns "mounts" { description = "One { spec, mountpoint, fstype, options } map per mount; the kernel's \\040-style escapes in spec and mountpoint are decoded, so a mount point with a space reads as one" type = "list" }
  }

  // In a VM the gatherers must return substance, not just degrade
  // gracefully: real units from systemd, a routable interface, a root
  // filesystem, and a recognised network manager.
  test "facts_on_a_real_system" {
    description = "Facts gatherers return live systemd, network and mount data on a booted host"
    template = "x86_64/ubuntu-24.04"
    verify = "tests/facts_vm_verify.ws"

    gather "os" {
      description = "OS identity of the booted guest"
      from = "os_release"
      expect {
        family = "linux"
        id = "ubuntu"
        version_id = "24.04"
      }
    }

    gather "init" {
      description = "systemd is detected as the init system"
      from = "init_system"
      expect {
        init = :systemd
      }
    }

    gather "net" {
      description = "Interfaces and the network manager"
      from = "network"
    }

    gather "mnt" {
      description = "Mounted filesystems"
      from = "mounts"
    }

    gather "svc" {
      description = "Live systemd units"
      from = "services"
    }
  }

  // /etc/os-release becomes a copy whose PRETTY_NAME is single-quoted, and
  // a mount point with a space shows up in /proc/mounts as \040.
  test "facts_gather" {
    description = "Linux facts gatherers work in a Debian container"
    image = "debian:12"
    setup = <<'SH'
sed "s/^PRETTY_NAME=.*/PRETTY_NAME='Debian 12 (cw)'/" /usr/lib/os-release > /tmp/os-release && rm /etc/os-release && mv /tmp/os-release /etc/os-release
mkdir -p "/mnt/cw space" && mount -t tmpfs tmpfs "/mnt/cw space"
SH
    verify = "tests/facts_verify.ws"

    gather "os" {
      description = "OS facts"
      from = "os_release"
      expect {
        family = "linux"
        id = "debian"
        version_id = "12"
        pretty_name = "Debian 12 (cw)"
      }
    }

    // PID 1 is vmlab's /init. Debian's `service` used to make every such
    // host :sysvinit.
    gather "init" {
      description = "A container entrypoint as PID 1 is not mistaken for an init system"
      from = "init_system"
      expect {
        init = :unknown
      }
    }

    gather "net" {
      description = "Interfaces enumerate and a network system is reported"
      from = "network"
    }

    gather "mnt" {
      description = "Mounts parse"
      from = "mounts"
    }

    gather "svc" {
      description = "services degrades to an empty list without systemd"
      from = "services"
    }
  }

  // OpenRC is not PID 1 in a container, so /run/openrc (what a booted
  // OpenRC leaves) is seeded. /etc/os-release is removed to exercise the
  // /usr/lib/os-release fallback, whose PRETTY_NAME carries escapes.
  test "facts_gather_alpine" {
    description = "Linux facts gatherers on Alpine: OpenRC detection, os-release fallback and escapes"
    image = "alpine:3.20"
    setup = <<'SH'
f=$(readlink -f /etc/os-release)
grep -v '^PRETTY_NAME=' "$f" > /tmp/os-release
printf '%s\n' 'PRETTY_NAME="Alpine \"cw\" \$HOME"' >> /tmp/os-release
rm -f /etc/os-release /usr/lib/os-release && mv /tmp/os-release /usr/lib/os-release
mkdir -p /run/openrc
SH
    verify = "tests/facts_verify.ws"

    gather "os" {
      description = "OS facts from /usr/lib/os-release"
      from = "os_release"
      expect {
        family = "linux"
        id = "alpine"
        pretty_name = "Alpine \"cw\" $HOME"
      }
    }

    gather "init" {
      description = "A booted OpenRC is detected without being PID 1"
      from = "init_system"
      expect {
        init = :openrc
      }
    }

    gather "net" {
      description = "Interfaces enumerate"
      from = "network"
    }

    gather "mnt" {
      description = "Mounts parse"
      from = "mounts"
    }

    gather "svc" {
      description = "services is empty without systemd"
      from = "services"
    }
  }
}
