package "linux_facts" {
  description = "Gather Linux operating system facts"

  gatherer "os_release" {
    description = "Read os-release (/etc/os-release, falling back to /usr/lib/os-release) and kernel facts. Values are unquoted the way os-release(5) specifies: single quotes literally, double quotes with backslash escapes"
    script = "gatherers/os_release.ws"
    returns "family" { description = "OS family (linux, windows, macos)" type = "string" }
    returns "name" { description = "OS name" type = "string" }
    returns "version" { description = "OS version" type = "string" }
    returns "kernel" { description = "Kernel version" type = "string" }
    returns "arch" { description = "CPU architecture" type = "string" }
    returns "id" { description = "os-release ID (debian, arch, ...)" type = "string" }
    returns "version_id" { description = "os-release VERSION_ID" type = "string" }
    returns "pretty_name" { description = "os-release PRETTY_NAME" type = "string" }
  }

  gatherer "init_system" {
    description = "Detect the init/service manager from PID 1 (/proc/1/comm and, when readable, /proc/1/exe), not from which tools are installed. In a container whose PID 1 is a plain entrypoint this is :unknown"
    script = "gatherers/init_system.ws"
    returns "init" {
      description = "Detected init/service manager"
      type = "symbol"
      symbol "systemd"  { description = "systemd is PID 1" }
      symbol "openrc"   { description = "OpenRC: PID 1 is openrc-init, or /run/openrc exists (OpenRC booted under sysvinit's or busybox's init)" }
      symbol "runit"    { description = "runit is PID 1" }
      symbol "sysvinit" { description = "SysV init: PID 1 is an init reading /etc/inittab, other than busybox's" }
      symbol "unknown"  { description = "PID 1 is none of the above, such as a container entrypoint" }
    }
  }

  gatherer "network" {
    description = "Enumerate network interfaces and detect the network management system"
    script = "gatherers/network.ws"
    returns "interfaces" { description = "One { name, mac, state, ipv4, ipv6 } map per interface; the address lists need iproute2 (ip) and are empty without it" type = "list" }
    returns "network_system" {
      description = "Detected network management system. A daemon counts when systemd reports it active or, under any other init, when its process is running"
      type = "symbol"
      symbol "netplan"          { description = "/etc/netplan/*.yaml exists; netplan wins over the renderer it drives" }
      symbol "network_manager"  { description = "NetworkManager is running" }
      symbol "systemd_networkd" { description = "systemd-networkd is running" }
      symbol "wicked"           { description = "wicked is running" }
      symbol "ifupdown"         { description = "/etc/network/interfaces exists and none of the above is running" }
      symbol "unknown"          { description = "None of the above" }
    }
  }

  gatherer "services" {
    description = "List services, from the first manager present: systemd when systemctl reaches it; else OpenRC when /run/openrc exists and rc-status works; else runit when runsv supervises an entry of /var/service, /etc/service, /service or /run/runit/service; else SysV when /etc/init.d holds scripts and `service` exists; else none. init_system is not consulted, so a container with an entrypoint as PID 1 still reports the manager its services run under. systemd: every loaded service unit (systemctl list-units --all) plus every installed unit file that is not loaded (list-unit-files); template units (foo@.service) are left out, their instances appear once loaded. OpenRC: every script that rc-service --list names. runit: every entry of the service dir, plus every definition in /etc/sv or /etc/runit/sv with a run script. SysV: every executable script in /etc/init.d. A service whose state command errors or answers an unknown state is left out"
    script = "gatherers/services.ws"
    returns "services" { description = "One { name, active, sub, enabled } map per service; empty with no manager. systemd: active and sub are the unit's states, enabled the unit-file state (enabled, disabled, static, masked, ...), empty for a unit with no unit file; a unit file that is not loaded reads active = inactive, sub = dead. The other managers use systemd's active words and their own sub word, and enabled is enabled or disabled. OpenRC (rc-service status exit code): 0 active/started, 3 inactive/stopped, 4 deactivating/stopping, 8 activating/starting, 16 inactive/inactive, 32 failed/crashed; enabled when linked into any /etc/runlevels/<runlevel>. runit (sv status): run active/run, down inactive/down, finish deactivating/finish; enabled when linked into the service dir; an unlinked definition is inactive/down, a link that runsv does not supervise is left out. SysV (the script's status verb, LSB codes): 0 active/running, 1 or 2 failed/dead, 3 inactive/stopped; enabled when an /etc/rc?.d/S??<name> start link exists" type = "list" }
  }

  gatherer "mounts" {
    description = "List mounted filesystems from /proc/mounts"
    script = "gatherers/mounts.ws"
    returns "count" { description = "Number of mounted filesystems" type = "int" }
    returns "mounts" { description = "One { spec, mountpoint, fstype, options } map per mount; the kernel's \\040-style escapes in spec and mountpoint are decoded, so a mount point with a space reads as one" type = "list" }
  }

  // In a VM the gatherers must return substance, not just degrade
  // gracefully: real units from systemd, a routable interface, a root
  // filesystem, and a recognised network manager.
  test "facts_on_a_real_system" {
    description = "Facts gatherers return live systemd, network and mount data on a booted host"
    template = "x86_64/ubuntu-24.04"
    verify = "tests/facts_vm_verify.ws"

    gather "os" {
      description = "OS identity of the booted guest"
      from = "os_release"
      expect {
        family = "linux"
        id = "ubuntu"
        version_id = "24.04"
      }
    }

    gather "init" {
      description = "systemd is detected as the init system"
      from = "init_system"
      expect {
        init = :systemd
      }
    }

    gather "net" {
      description = "Interfaces and the network manager"
      from = "network"
      expect {
        network_system = :netplan
      }
    }

    gather "mnt" {
      description = "Mounted filesystems"
      from = "mounts"
    }

    gather "svc" {
      description = "Live systemd units"
      from = "services"
    }
  }

  // /etc/os-release becomes a copy whose PRETTY_NAME is single-quoted, a
  // mount point with a space shows up in /proc/mounts as \040, and a copy
  // of sleep runs under the name NetworkManager.
  test "facts_gather" {
    description = "Linux facts gatherers work in a Debian container"
    image = "debian:12"
    setup = <<'SH'
sed "s/^PRETTY_NAME=.*/PRETTY_NAME='Debian 12 (cw)'/" /usr/lib/os-release > /tmp/os-release && rm /etc/os-release && mv /tmp/os-release /etc/os-release
mkdir -p "/mnt/cw space" && mount -t tmpfs tmpfs "/mnt/cw space"
cp /bin/sleep /usr/local/bin/NetworkManager && (nohup NetworkManager 3600 >/dev/null 2>&1 &)
SH
    verify = "tests/facts_verify.ws"

    gather "os" {
      description = "OS facts"
      from = "os_release"
      expect {
        family = "linux"
        id = "debian"
        version_id = "12"
        pretty_name = "Debian 12 (cw)"
      }
    }

    // PID 1 is vmlab's /init. Debian's `service` used to make every such
    // host :sysvinit.
    gather "init" {
      description = "A container entrypoint as PID 1 is not mistaken for an init system"
      from = "init_system"
      expect {
        init = :unknown
      }
    }

    // The stand-in NetworkManager process from setup: without systemd,
    // only a process scan can see it.
    gather "net" {
      description = "Interfaces enumerate, and NetworkManager is found without systemd"
      from = "network"
      expect {
        network_system = :network_manager
      }
    }

    gather "mnt" {
      description = "Mounts parse"
      from = "mounts"
    }

    gather "svc" {
      description = "services returns a list without systemd"
      from = "services"
    }
  }

  // OpenRC is not PID 1 in a container, so /run/openrc (what a booted
  // OpenRC leaves) is seeded. /etc/os-release is removed to exercise the
  // /usr/lib/os-release fallback, whose PRETTY_NAME carries escapes.
  test "facts_gather_alpine" {
    description = "Linux facts gatherers on Alpine: OpenRC detection, os-release fallback and escapes"
    image = "alpine:3.20"
    setup = <<'SH'
f=$(readlink -f /etc/os-release)
grep -v '^PRETTY_NAME=' "$f" > /tmp/os-release
printf '%s\n' 'PRETTY_NAME="Alpine \"cw\" \$HOME"' >> /tmp/os-release
rm -f /etc/os-release /usr/lib/os-release && mv /tmp/os-release /usr/lib/os-release
mkdir -p /run/openrc
SH
    verify = "tests/facts_verify.ws"

    gather "os" {
      description = "OS facts from /usr/lib/os-release"
      from = "os_release"
      expect {
        family = "linux"
        id = "alpine"
        pretty_name = "Alpine \"cw\" $HOME"
      }
    }

    gather "init" {
      description = "A booted OpenRC is detected without being PID 1"
      from = "init_system"
      expect {
        init = :openrc
      }
    }

    gather "net" {
      description = "Interfaces enumerate"
      from = "network"
    }

    gather "mnt" {
      description = "Mounts parse"
      from = "mounts"
    }

    gather "svc" {
      description = "services is empty without systemd"
      from = "services"
    }
  }

  // One test per non-systemd backend, with the real tools, as the
  // linux_openrc, linux_runit and linux_sysvinit tests run them. Each seeds
  // a running enabled, a stopped enabled and a stopped disabled service.
  // OpenRC is not PID 1 here: a marked softlevel is all rc-service needs.
  test "services_openrc" {
    description = "services lists OpenRC services with their status and runlevel membership"
    image = "alpine:3.23"
    setup = <<'SH'
apk add -q openrc >/dev/null 2>&1 || exit 1
mkdir -p /run/openrc && touch /run/openrc/softlevel
mk() {
printf '#!/sbin/openrc-run\ncommand=/bin/sleep\ncommand_args=3600\ncommand_background=true\npidfile=/run/%s.pid\n' $1 > /etc/init.d/$1
chmod +x /etc/init.d/$1
}
for s in cw-run cw-stop cw-off cw-crash; do mk $s; done
rc-update add cw-run default >/dev/null && rc-update add cw-stop default >/dev/null || exit 1
rc-service cw-run start >/dev/null 2>&1 && rc-service cw-crash start >/dev/null 2>&1 || exit 1
# Marked started, its daemon gone: status 32.
kill $(cat /run/cw-crash.pid)
SH
    verify = "tests/services_openrc_verify.ws"

    gather "svc" {
      description = "OpenRC services"
      from = "services"
    }
  }

  // runsvdir supervises /var/service. cw-stop is linked with a down file,
  // cw-off is defined in /etc/sv and not linked.
  test "services_runit" {
    description = "services lists runit services with their sv status and service-dir links"
    image = "alpine:3.23"
    setup = <<'SH'
apk add -q runit >/dev/null 2>&1 || exit 1
for s in cw-run cw-stop cw-off; do
mkdir -p /etc/sv/$s && printf '#!/bin/sh\nexec sleep 3600\n' > /etc/sv/$s/run && chmod +x /etc/sv/$s/run
done
touch /etc/sv/cw-stop/down
mkdir -p /var/service
(setsid runsvdir /var/service >/dev/null 2>&1 &)
ln -s /etc/sv/cw-run /var/service/cw-run && ln -s /etc/sv/cw-stop /var/service/cw-stop
for i in $(seq 1 30); do
  sv status /var/service/cw-run 2>/dev/null | grep -q '^run:' && sv status /var/service/cw-stop >/dev/null 2>&1 && break
  sleep 1
done
sv status /var/service/cw-run | grep -q '^run:' || exit 1
sv status /var/service/cw-stop | grep -q '^down:' || exit 1
SH
    verify = "tests/services_runit_verify.ws"

    gather "svc" {
      description = "runit services"
      from = "services"
    }
  }

  // LSB status codes: 0 running, 3 stopped. cw-off has kill links only.
  test "services_sysv" {
    description = "services lists SysV services with their status verb and rc.d start links"
    image = "debian:12"
    setup = <<'SH'
mk() {
cat > /etc/init.d/$1 <<EOF
#!/bin/sh
### BEGIN INIT INFO
# Provides: $1
# Required-Start:
# Required-Stop:
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: config-weave test
### END INIT INFO
P=/run/$1.pid
case "\$1" in
start) setsid sleep 3600 >/dev/null 2>&1 & echo \$! > \$P ;;
stop) if [ -f \$P ]; then kill \$(cat \$P) 2>/dev/null; rm -f \$P; fi ;;
status) [ -f \$P ] && kill -0 \$(cat \$P) 2>/dev/null && exit 0; exit 3 ;;
esac
EOF
chmod +x /etc/init.d/$1
}
for s in cw-run cw-stop cw-off; do mk $s; done
update-rc.d cw-run defaults >/dev/null && update-rc.d cw-stop defaults >/dev/null || exit 1
update-rc.d cw-off defaults >/dev/null && update-rc.d cw-off disable >/dev/null || exit 1
/etc/init.d/cw-run start
SH
    verify = "tests/services_sysv_verify.ws"

    gather "svc" {
      description = "SysV services"
      from = "services"
    }
  }

  // Half of each manager is here, never enough to count: /run/openrc with
  // no OpenRC tools, an /etc/sv definition with no runsvdir, and an init
  // script with no `service` command.
  test "services_no_manager" {
    description = "services is an empty list when no service manager is present"
    image = "alpine:3.23"
    setup = <<'SH'
mkdir -p /run/openrc /etc/sv/cw-def /etc/init.d
printf '#!/bin/sh\nexec sleep 3600\n' > /etc/sv/cw-def/run && chmod +x /etc/sv/cw-def/run
printf '#!/bin/sh\nexit 0\n' > /etc/init.d/cw-init && chmod +x /etc/init.d/cw-init
SH
    verify = "tests/services_none_verify.ws"

    gather "svc" {
      description = "No services"
      from = "services"
    }
  }
}
