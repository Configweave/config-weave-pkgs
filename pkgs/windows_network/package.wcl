package "windows_network" {
  description = "Manage Windows network configuration and firewall rules"

  resource "static_ip" {
    description = "Ensure an interface has a static IPv4 address (absent removes it and returns the interface to DHCP; it is converged only once DHCP is enabled)"
    script = "resources/static_ip.ws"
    concurrency = "exclusive"
    param "interface" { description = "InterfaceAlias of the adapter, e.g. Ethernet0" type = "string" required = true }
    param "ip" { description = "IPv4 address the interface should hold" type = "string" required = true }
    param "prefix_length" { description = "Subnet prefix length, e.g. 24" type = "int" required = true }
    param "gateway" { description = "Default gateway; empty leaves the default route unmanaged" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Set the static address" }
      symbol "absent"  { description = "Remove the address and return the interface to DHCP" }
    }
  }

  resource "dns_servers" {
    description = "Ensure an interface uses exactly the given IPv4 DNS servers (an empty list resets to DHCP-assigned)"
    script = "resources/dns_servers.ws"
    concurrency = "exclusive"
    param "interface" { description = "InterfaceAlias of the adapter, e.g. Ethernet0" type = "string" required = true }
    param "servers" { description = "DNS server addresses in preference order; compared order-sensitively" type = "list" required = true }
  }

  resource "firewall_rule" {
    description = "Ensure a Windows Firewall rule exists and matches every param: enabled state, direction, action, protocol, profile, local port and remote address are all probed for drift"
    script = "resources/firewall_rule.ws"
    concurrency = "exclusive"
    param "name" { description = "Rule Name (also used as DisplayName at create time)" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the rule" }
      symbol "absent"  { description = "Delete the rule" }
    }
    param "direction" {
      description = "Traffic direction"
      type = "symbol"
      default = :inbound

      symbol "inbound"  { description = "Traffic arriving at this host" }
      symbol "outbound" { description = "Traffic leaving this host" }
    }
    param "action" {
      description = "What the rule does with matching traffic"
      type = "symbol"
      default = :allow

      symbol "allow" { description = "Permit matching traffic" }
      symbol "block" { description = "Drop matching traffic" }
    }
    param "protocol" {
      description = "Protocol the rule matches"
      type = "symbol"
      default = :tcp

      symbol "tcp"    { description = "TCP" }
      symbol "udp"    { description = "UDP" }
      symbol "icmpv4" { description = "ICMPv4" }
      symbol "icmpv6" { description = "ICMPv6" }
      symbol "any"    { description = "Any protocol" }
    }
    // Windows profiles combine, so the combinations are spelled out rather
    // than dropped: a closed symbol set cannot carry a comma list.
    // Domain+Private+Public is exactly :any.
    param "profile" {
      description = "Firewall profile the rule applies to"
      type = "symbol"
      default = :any

      symbol "any"             { description = "All profiles" }
      symbol "domain"          { description = "Domain" }
      symbol "private"         { description = "Private" }
      symbol "public"          { description = "Public" }
      symbol "domain_private"  { description = "Domain and Private" }
      symbol "domain_public"   { description = "Domain and Public" }
      symbol "private_public"  { description = "Private and Public" }
    }
    // Addresses and ports stay strings: they carry ranges and CIDR, which a
    // closed symbol set cannot express.
    param "local_port" { description = "Local port or range, e.g. 443 or 8000-8010; empty means any. Only applied and compared for :tcp and :udp" type = "string" default = "" }
    param "remote_address" { description = "Remote address filter, e.g. 10.0.0.0/8; empty means any" type = "string" default = "" }
    param "enabled" { description = "Whether the rule is enabled" type = "bool" default = true }
  }

  // Reconfiguring the test VM's only adapter (static_ip / dns_servers) would
  // cut the testlab's own connection, so the vmlab test sticks to firewall
  // rules: adding one is safe, and the ghost rule exercises the absent
  // detection path.
  test "firewall_rule_converges" {
    description = "A firewall rule converges and absent detection works"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    verify = "tests/network_verify.ws"

    step "allow_8443" {
      description = "Allow inbound TCP 8443"
      resource = "firewall_rule"
      properties { name = "weave-test-8443" direction = :inbound action = :allow protocol = :tcp local_port = "8443" }
    }

    step "ghost_rule_absent" {
      description = "A never-created rule with ensure = absent is already configured"
      resource = "firewall_rule"
      expect = "already_configured"
      properties { name = "weave-ghost-rule" ensure = :absent }
    }
  }

  // Each seeded rule already matches name, direction, action and enabled, and
  // drifts in exactly one other field, so run 1 can only report Not Configured
  // if check reads that field back. Run 3 then proves the read-back spelling
  // (dotted masks, `Domain, Private`) normalises to what apply wrote. Setup
  // runs under `cmd /C`: no double quotes, no pipes.
  test "firewall_rule_drift_converges" {
    description = "Port, protocol, profile and remote address drift is detected and corrected"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    setup = "powershell -NoProfile -ExecutionPolicy Bypass -Command $ErrorActionPreference='Stop'; New-NetFirewallRule -Name weave-drift-port -DisplayName weave-drift-port -Direction Inbound -Action Allow -Protocol TCP -LocalPort 1434; New-NetFirewallRule -Name weave-drift-protocol -DisplayName weave-drift-protocol -Direction Inbound -Action Allow -Protocol UDP -LocalPort 5001; New-NetFirewallRule -Name weave-drift-profile -DisplayName weave-drift-profile -Direction Inbound -Action Allow -Protocol TCP -LocalPort 5002 -Profile Public; New-NetFirewallRule -Name weave-drift-remote -DisplayName weave-drift-remote -Direction Inbound -Action Allow -Protocol TCP -LocalPort 5003 -RemoteAddress 10.0.0.0/8; New-NetFirewallRule -Name weave-drift-remote-any -DisplayName weave-drift-remote-any -Direction Inbound -Action Allow -Protocol TCP -LocalPort 5004 -RemoteAddress 10.0.0.0/8"
    verify = "tests/firewall_drift_verify.ws"

    step "port_drift" {
      description = "Rule seeded on TCP 1434 moves back to 1433"
      resource = "firewall_rule"
      properties { name = "weave-drift-port" protocol = :tcp local_port = "1433" }
    }

    step "protocol_drift" {
      description = "Rule seeded as UDP becomes TCP"
      resource = "firewall_rule"
      properties { name = "weave-drift-protocol" protocol = :tcp local_port = "5001" }
    }

    step "profile_drift" {
      description = "Rule seeded on Public moves to Domain and Private"
      resource = "firewall_rule"
      properties { name = "weave-drift-profile" protocol = :tcp local_port = "5002" profile = :domain_private }
    }

    step "remote_address_drift" {
      description = "Rule seeded for 10.0.0.0/8 is narrowed to 192.168.50.0/24"
      resource = "firewall_rule"
      properties { name = "weave-drift-remote" protocol = :tcp local_port = "5003" remote_address = "192.168.50.0/24" }
    }

    step "remote_address_widened" {
      description = "Rule seeded for 10.0.0.0/8 with no remote_address goes back to Any"
      resource = "firewall_rule"
      properties { name = "weave-drift-remote-any" protocol = :tcp local_port = "5004" }
      }
    }

  // The one static_ip case that is safe on the testlab's only adapter: the
  // testlab drives the guest through the vmlab agent, not the network, and
  // the step itself hands the adapter back to DHCP. Setup leaves it in the
  // drifted state — the address already gone but DHCP still off — which
  // check must report as not configured so apply re-enables DHCP. Its own
  // instance, so the outage cannot leak into the win2025 group.
  test "static_ip_absent_restores_dhcp" {
    description = "An absent static address with DHCP still disabled is drift, and apply re-enables DHCP"
    template = "x86_64/windows-server-2025"
    // Setup runs under cmd.exe; the command stays unquoted because a quoted
    // -Command reaches PowerShell as a string literal and is only echoed.
    setup = "powershell -NoProfile -Command Set-NetIPInterface -InterfaceAlias Ethernet -AddressFamily IPv4 -Dhcp Disabled"
    verify = "tests/static_ip_verify.ws"

    step "absent_with_dhcp_off" {
      description = "The address is absent but DHCP is disabled, so the step converges by enabling DHCP"
      resource = "static_ip"
      properties { interface = "Ethernet" ip = "192.0.2.55" prefix_length = 24 ensure = :absent }
    }
  }
}
