package "linux_system" {
  description = "Manage core Linux system configuration"

  resource "sysctl" {
    description = "Ensure a sysctl value at runtime and persisted in its own drop-in, /etc/sysctl.d/99-config-weave-<key>.conf, or that the drop-in is absent. Multi-value keys compare field by field, so whitespace between values does not matter. Another sysctl.d file sorting after 99-config-weave-* can still override the value at boot"
    script = "resources/sysctl.ws"
    concurrency = "global"
    param "key" { description = "Sysctl key, dotted (net.ipv4.ip_forward) or with slashes (net/ipv4/conf/eth0.100/forwarding, the only spelling for an interface name with a dot)" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Set the value now and persist it in the drop-in" }
      symbol "absent"  { description = "Delete the drop-in. The running value is left as it is until the next boot or sysctl --system" }
    }
    param "value" { description = "Desired value (required when :present); space-separate the fields of a multi-value key" type = "string" default = "" }
  }

  resource "hostname" {
    description = "Ensure /etc/hostname content"
    script = "resources/hostname.ws"
    concurrency = "global"
    param "name" { description = "Desired hostname" type = "string" required = true }
  }

  resource "timezone" {
    description = "Ensure the system timezone: /etc/localtime must point at (or hold the bytes of) /usr/share/zoneinfo/<name>, and /etc/timezone, where that file exists, must hold the name. Uses timedatectl when systemd is PID 1, otherwise links /etc/localtime directly, so it works in containers and under other init systems. Needs tzdata installed; an unknown zone is an error"
    script = "resources/timezone.ws"
    concurrency = "global"
    param "name" { description = "IANA zone name such as UTC or Australia/Brisbane, as found under /usr/share/zoneinfo" type = "string" required = true }
  }

  resource "locale" {
    description = "Ensure a locale is enabled in /etc/locale.gen (and generated) or absent"
    script = "resources/locale.ws"
    // read-modify-write on the shared /etc/locale.gen
    concurrency = "exclusive"
    param "name" { description = "Locale name such as en_AU.UTF-8" type = "string" required = true }
    param "charset" { description = "Charset column in locale.gen" type = "string" default = "UTF-8" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Enable the locale and generate it" }
      symbol "absent"  { description = "Disable the locale" }
    }
  }

  resource "cron_job" {
    description = "Ensure a single cron.d job entry is present or absent"
    script = "resources/cron_job.ws"
    concurrency = "parallel"
    param "name" { description = "Job name (also the cron.d filename; no dots)" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Write the cron.d entry" }
      symbol "absent"  { description = "Remove the cron.d entry" }
    }
    param "schedule" { description = "Cron schedule such as '*/5 * * * *' (required when present)" type = "string" default = "" }
    param "command" { description = "Command to run (required when present)" type = "string" default = "" }
    param "user" { description = "User to run as" type = "string" default = "root" }
  }

  resource "fstab_mount" {
    description = "Ensure exactly one /etc/fstab entry for a mount point, or none, and optionally keep it mounted or unmounted. A second entry for the same mount point is drift and is removed. fstab is rewritten through a temp file and rename. A space, tab or backslash in spec or mountpoint is written as its fstab octal escape (\\040, \\011, \\134); whitespace in fstype or options is rejected. With mount = true, a changed entry that is already mounted is remounted with the new options, or unmounted and mounted again when spec or fstype changed; options changed at runtime by hand, with fstab untouched, are not detected"
    script = "resources/fstab_mount.ws"
    concurrency = "global"
    param "mountpoint" { description = "Absolute mount point (or none/swap for swap); identifies the entry, so it is the only field needed to remove one. A trailing slash is ignored" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Write the fstab entry, replacing every existing entry for this mount point" }
      symbol "absent"  { description = "Remove every fstab entry for this mount point" }
    }
    param "spec" { description = "Filesystem spec such as UUID=..., /dev/sdb1 or tmpfs (required when :present)" type = "string" default = "" }
    param "fstype" { description = "Filesystem type (required when :present)" type = "string" default = "" }
    param "options" { description = "Comma-separated mount options, no whitespace" type = "string" default = "defaults" }
    param "dump" { description = "Dump field" type = "int" default = 0 }
    param "pass" { description = "Pass field" type = "int" default = 0 }
    param "mount" { description = "Also manage the live mount: when :present the mount point is created if missing and mounted (check fails while it is not mounted); when :absent it is unmounted first. false leaves /proc/mounts alone" type = "bool" default = false }
  }

  test "cron_job_converge" {
    description = "cron_job adds and removes (ensure = absent) a cron.d entry"
    image = "debian:12"
    group = "system"
    setup = "echo placeholder > /etc/cron.d/cw-rm-job"
    verify = "tests/cron_job_verify.ws"

    step "add" {
      description = "Add a cron job"
      resource = "cron_job"
      properties { name = "cw-test-job" schedule = "*/5 * * * *" command = "/bin/true" }
    }

    step "remove" {
      description = "Remove a cron job"
      resource = "cron_job"
      properties { name = "cw-rm-job" ensure = :absent }
    }
  }

  test "singletons_converge" {
    description = "hostname and locale converge"
    image = "debian:12"
    group = "system"
    setup = "printf '# de_DE.UTF-8 UTF-8\\nde_DE.UTF-8 UTF-8\\n' > /etc/locale.gen"
    verify = "tests/singletons_verify.ws"

    step "hostname" {
      description = "Write /etc/hostname"
      resource = "hostname"
      properties { name = "cw-test-host" }
    }

    step "locale" {
      description = "Enable a locale in /etc/locale.gen"
      resource = "locale"
      properties { name = "en_AU.UTF-8" }
    }

    step "rm_locale" {
      description = "Remove the locale seeded during setup"
      resource = "locale"
      requires = ["locale"]
      properties { name = "de_DE.UTF-8" ensure = :absent }
    }
  }

  // vmlab containers are micro-VMs with their own kernel and full
  // capabilities, so tmpfs mounts are real here: mount = true is exercised
  // in a container rather than a full VM.
  test "fstab_converge" {
    description = "fstab_mount edits entries and mounts, remounts and unmounts them"
    image = "debian:12"
    group = "system"
    setup = <<'SH'
printf 'tmpfs /mnt/cw-seeded tmpfs defaults 0 0\n' >> /etc/fstab
mkdir -p /mnt/cw-opts && printf 'tmpfs /mnt/cw-opts tmpfs size=1m 0 0\n' >> /etc/fstab && mount /mnt/cw-opts
printf 'tmpfs /mnt/cw-dup tmpfs defaults 0 0\ntmpfs\t/mnt/cw-dup/  tmpfs size=3m 0 0\n' >> /etc/fstab
mkdir -p /mnt/cw-um && printf 'tmpfs /mnt/cw-um tmpfs defaults 0 0\n' >> /etc/fstab && mount /mnt/cw-um
mkdir -p /mnt/cw-unmounted && printf 'tmpfs /mnt/cw-unmounted tmpfs defaults 0 0\n' >> /etc/fstab
SH
    verify = "tests/fstab_verify.ws"

    step "fstab" {
      description = "Add an fstab entry without mounting it"
      resource = "fstab_mount"
      properties { spec = "tmpfs" mountpoint = "/mnt/cw-test" fstype = "tmpfs" mount = false }
    }

    // The mount point alone identifies the entry, so removal needs no spec
    // or fstype, and `mount = false` leaves /proc/mounts alone.
    step "rm_fstab" {
      description = "Remove the fstab entry seeded during setup"
      resource = "fstab_mount"
      properties { mountpoint = "/mnt/cw-seeded" ensure = :absent mount = false }
    }

    step "new_mount" {
      description = "Add and mount an entry whose mount point has a space and does not exist yet"
      resource = "fstab_mount"
      properties { spec = "tmpfs" mountpoint = "/mnt/cw new" fstype = "tmpfs" options = "size=1m" mount = true }
    }

    step "opts" {
      description = "Change the options of a mounted entry, which remounts it"
      resource = "fstab_mount"
      properties { spec = "tmpfs" mountpoint = "/mnt/cw-opts" fstype = "tmpfs" options = "size=2m" mount = true }
    }

    step "dup" {
      description = "Collapse two entries for one mount point into one"
      resource = "fstab_mount"
      properties { spec = "tmpfs" mountpoint = "/mnt/cw-dup" fstype = "tmpfs" }
    }

    step "unmounted" {
      description = "A correct entry that is not mounted is drift when mount = true"
      resource = "fstab_mount"
      properties { spec = "tmpfs" mountpoint = "/mnt/cw-unmounted" fstype = "tmpfs" mount = true }
    }

    step "um" {
      description = "Unmount and remove a mounted entry"
      resource = "fstab_mount"
      properties { mountpoint = "/mnt/cw-um" ensure = :absent mount = true }
    }

    step "bad_options" {
      description = "Whitespace in options is rejected rather than written"
      resource = "fstab_mount"
      expect = "error"
      properties { spec = "tmpfs" mountpoint = "/mnt/cw-bad" fstype = "tmpfs" options = "size=1m, mode=0755" }
    }
  }

  // vmlab containers have their own kernel, so /proc/sys is writable.
  test "sysctl_converge" {
    description = "sysctl sets multi-value and slash-separated keys and removes a drop-in"
    image = "debian:12"
    group = "system"
    setup = "mkdir -p /etc/sysctl.d && printf 'net.ipv4.tcp_syncookies = 1\\n' > /etc/sysctl.d/99-config-weave-net-ipv4-tcp_syncookies.conf"
    verify = "tests/sysctl_verify.ws"

    step "range" {
      description = "A multi-value key, which sysctl reports tab-separated"
      resource = "sysctl"
      properties { key = "net.ipv4.ip_local_port_range" value = "32000  61000" }
    }

    step "slash" {
      description = "A key written with slashes"
      resource = "sysctl"
      properties { key = "net/ipv4/ip_forward" value = "1" }
    }

    step "rm" {
      description = "Remove a drop-in"
      resource = "sysctl"
      properties { key = "net.ipv4.tcp_syncookies" ensure = :absent }
    }
  }

  // /etc/timezone already names the zone, which the old check accepted on
  // its own, while /etc/localtime is a dangling link that fs::exists missed.
  test "timezone_converge" {
    description = "timezone repairs a dangling /etc/localtime that /etc/timezone disagrees with, and rejects an unknown zone"
    image = "debian:12"
    group = "system"
    setup = "echo Australia/Brisbane > /etc/timezone && ln -sfn /usr/share/zoneinfo/Nowhere/Gone /etc/localtime"
    verify = "tests/timezone_verify.ws"

    step "timezone" {
      description = "Set the timezone"
      resource = "timezone"
      properties { name = "Australia/Brisbane" }
    }

    step "unknown" {
      description = "A zone with no zoneinfo file is an error, not a success"
      resource = "timezone"
      requires = ["timezone"]
      expect = "error"
      properties { name = "Mars/Olympus_Mons" }
    }
  }
}
