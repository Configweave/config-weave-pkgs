package "windows_updates" {
  description = "Apply Windows Updates and manage update policy"

  resource "windows_update" {
    description = "Install applicable Windows Updates via the Windows Update Agent"
    script = "resources/windows_update.ws"
    concurrency = "global"
    param "query" { description = "Update search criteria" type = "string" default = "IsInstalled=0 and IsHidden=0" }
  }

  resource "automatic_updates" {
    description = "Enable or disable automatic Windows Updates (the NoAutoUpdate AU policy)"
    script = "resources/automatic_updates.ws"
    concurrency = "global"
    param "enabled" { description = "Whether automatic updates are allowed (false sets NoAutoUpdate=1)" type = "bool" default = true }
  }

  // automatic_updates manages pure local state (an AU policy registry
  // value), so it converges fully offline. windows_update itself is
  // untested here: a WUA search/install is network-bound, very slow, and
  // needs the update service running — scenario territory.
  test "update_policy_converges" {
    description = "The automatic-updates policy resource converges"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    verify = "tests/updates_verify.ws"

    // The Server 2025 image already ships NoAutoUpdate = 1, so disabling
    // is a no-op there — converge the other way to prove the resource
    // actually writes the policy.
    step "enable_auto_updates" {
      description = "Clear the NoAutoUpdate AU policy"
      resource = "automatic_updates"
      properties { enabled = true }
    }
  }
}
