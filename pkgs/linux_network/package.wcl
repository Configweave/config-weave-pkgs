package "linux_network" {
  description = "Manage Linux network configuration and firewalls"

  resource "hosts_entry" {
    description = "Ensure /etc/hosts has exactly one line for an address, mapping it to exactly the given names in order, or no line for it. Lines are matched on their first field, so whitespace and trailing comments do not matter; a line for the address with other names is rewritten in place and further lines for it are removed. The address is compared as written (::1 and 0::1 are different addresses), and a name listed under another address is left alone. The file is rewritten in place, not renamed over, because container runtimes bind-mount it"
    script = "resources/hosts_entry.ws"
    // read-modify-write on the shared /etc/hosts — parallel steps lose updates
    concurrency = "exclusive"
    param "ip" { description = "IP address, the line's first field" type = "string" required = true }
    param "names" { description = "Host names for the address, first is canonical (required when :present). No whitespace or '#'" type = "list" default = [] }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Write the line for the address, replacing any existing ones" }
      symbol "absent"  { description = "Remove every line for the address" }
    }
  }

  resource "firewalld_rule" {
    description = "Ensure a firewalld rule (service, port, source or rich rule) is present or absent"
    script = "resources/firewalld_rule.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the rule" }
      symbol "absent"  { description = "Remove the rule" }
    }
    param "zone" { description = "Zone to operate on; empty uses the default zone" type = "string" default = "" }
    param "permanent" { description = "Operate on the permanent configuration" type = "bool" default = true }
    param "service" { description = "Named service to allow, such as https" type = "string" default = "" }
    param "port" { description = "Port rule such as 8080/tcp" type = "string" default = "" }
    param "source" { description = "Source address or CIDR bound to the zone" type = "string" default = "" }
    param "rich_rule" { description = "Full firewalld rich rule text" type = "string" default = "" }
  }

  resource "ufw_rule" {
    description = "Ensure a ufw rule is recorded or deleted. Presence is read from ufw show added, so it works while ufw is inactive; enabling the firewall is not managed here. ufw needs a working iptables backend"
    script = "resources/ufw_rule.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the rule" }
      symbol "absent"  { description = "Delete the rule" }
    }
    param "action" {
      description = "Rule action"
      type = "symbol"
      default = :allow

      symbol "allow"  { description = "Accept matching traffic" }
      symbol "deny"   { description = "Drop matching traffic silently" }
      symbol "reject" { description = "Refuse matching traffic with an error to the sender" }
      symbol "limit"  { description = "Accept, but deny a source that opens 6 or more connections in 30 seconds" }
    }
    param "port" { description = "Port spec such as 22, 22/tcp, 6000:6007/tcp or 80,443/tcp, or an application profile name such as OpenSSH or 'WWW Full' (anything not starting with a digit is a profile; ufw app list shows them)" type = "string" required = true }
    param "from" { description = "Optional source address or CIDR; empty or any means every source" type = "string" default = "" }
  }

  resource "nftables_table" {
    description = "Ensure an nftables table exists or is absent"
    script = "resources/nftables_table.ws"
    concurrency = "global"
    param "family" { description = "Address family: inet, ip, ip6, arp, bridge or netdev" type = "string" default = "inet" }
    param "name" { description = "Table name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the table" }
      symbol "absent"  { description = "Delete the table and everything in it" }
    }
  }

  resource "nftables_chain" {
    description = "Ensure an nftables chain exists or is absent (base chain when type/hook are set)"
    script = "resources/nftables_chain.ws"
    concurrency = "global"
    param "family" { description = "Address family: inet, ip, ip6, arp, bridge or netdev" type = "string" default = "inet" }
    param "table" { description = "Owning table name" type = "string" required = true }
    param "name" { description = "Chain name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the chain" }
      symbol "absent"  { description = "Delete the chain" }
    }
    param "type" { description = "Base chain type: filter, nat or route (empty for a regular chain)" type = "string" default = "" }
    param "hook" { description = "Base chain hook: input, output, forward, prerouting or postrouting" type = "string" default = "" }
    param "priority" { description = "Base chain priority" type = "int" default = 0 }
    param "policy" { description = "Base chain policy: accept or drop (empty leaves the default)" type = "string" default = "" }
  }

  resource "nftables_rule" {
    description = "Ensure an nftables rule is present in or absent from a chain"
    script = "resources/nftables_rule.ws"
    concurrency = "global"
    param "family" { description = "Address family: inet, ip, ip6, arp, bridge or netdev" type = "string" default = "inet" }
    param "table" { description = "Owning table name" type = "string" required = true }
    param "chain" { description = "Owning chain name" type = "string" required = true }
    param "rule" { description = "Rule expression as nft prints it, such as 'tcp dport 22 accept'" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the rule to the chain" }
      symbol "absent"  { description = "Delete the rule from the chain" }
    }
  }

  test "network_files_converge" {
    description = "hosts entries are added, renamed, deduplicated and removed in a Debian container"
    image = "debian:12"
    group = "network"
    // 192.0.2.20 is seeded under its old names twice (once tab-separated
    // with a comment); .30 is already right but spaced differently; .40 is
    // removed.
    setup = "grep -q cw-old /etc/hosts || printf '192.0.2.20 cw-old.local cw-old\\n# keep me\\n192.0.2.20\\tcw-old2   # stale\\n192.0.2.30   cw-spaced\\tcw-sp # ok\\n192.0.2.40 cw-gone\\n' >> /etc/hosts"
    verify = "tests/network_verify.ws"

    step "hosts" {
      description = "Add a hosts entry"
      resource = "hosts_entry"
      properties { ip = "192.0.2.10" names = ["cw-test.local", "cw-test"] }
    }

    step "rename" {
      description = "Replace the names of an address seeded twice with old names"
      resource = "hosts_entry"
      properties { ip = "192.0.2.20" names = ["cw-new.local", "cw-new"] }
    }

    step "spacing" {
      description = "A line that differs only in whitespace and a comment is already converged"
      resource = "hosts_entry"
      expect = "already_configured"
      properties { ip = "192.0.2.30" names = ["cw-spaced", "cw-sp"] }
    }

    step "remove" {
      description = "Remove a seeded address"
      resource = "hosts_entry"
      properties { ip = "192.0.2.40" ensure = :absent }
    }

    step "newline" {
      description = "A name that would add a second hosts line is rejected"
      resource = "hosts_entry"
      expect = "error"
      properties { ip = "192.0.2.50" names = ["cw-a\n10.0.0.1 evil"] }
    }
  }

  // The firewall resources need a real kernel and NET_ADMIN, so they run in
  // VMs: nftables and ufw on Ubuntu (both ship in the image), firewalld on
  // Fedora. Write nftables rules exactly as `nft` prints them back — the
  // resource compares against that text.
  test "nftables_and_ufw_converge" {
    description = "An nftables table, chain and rule and a ufw rule converge"
    template = "x86_64/ubuntu-24.04"
    verify = "tests/firewall_verify.ws"

    step "table" {
      description = "Create an nftables table"
      resource = "nftables_table"
      properties { family = "inet" name = "cwtest" ensure = :present }
    }

    step "chain" {
      description = "Create a base chain in the table"
      resource = "nftables_chain"
      requires = ["table"]
      properties {
        family = "inet"
        table = "cwtest"
        name = "input"
        type = "filter"
        hook = "input"
        priority = 0
        policy = "accept"
        ensure = :present
      }
    }

    step "rule" {
      description = "Add a rule to the chain"
      resource = "nftables_rule"
      requires = ["chain"]
      properties {
        family = "inet"
        table = "cwtest"
        chain = "input"
        rule = "tcp dport 8080 accept"
        ensure = :present
      }
    }

    step "absent_table_stays_absent" {
      description = "A table that was never created is already configured"
      resource = "nftables_table"
      expect = "already_configured"
      properties { family = "inet" name = "cw-never-created" ensure = :absent }
    }
  }

  // ufw only needs an iptables backend, and the container kernel has the
  // legacy tables but no nf_tables, so setup switches the alternatives.
  test "ufw_converges" {
    description = "ufw rules for ports, sources and application profiles are added and deleted"
    image = "debian:12"
    group = "network"
    setup = "export PATH=/usr/sbin:/usr/bin:/sbin:/bin; command -v ufw >/dev/null || (apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ufw >/dev/null) && update-alternatives --set iptables /usr/sbin/iptables-legacy >/dev/null && update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy >/dev/null && ufw allow 7070/tcp >/dev/null 2>&1 && ufw deny from 10.1.0.0/16 to any app SSH >/dev/null 2>&1; ufw show added 2>/dev/null | grep -q 'ufw allow 7070/tcp'"
    verify = "tests/ufw_verify.ws"

    step "port" {
      description = "Allow a port"
      resource = "ufw_rule"
      properties { port = "9090/tcp" }
    }

    step "from_source" {
      description = "Allow a port from a source"
      resource = "ufw_rule"
      properties { action = :limit port = "9091/tcp" from = "10.0.0.0/8" }
    }

    step "app_from_source" {
      description = "Allow an application profile whose name has a space, from a source"
      resource = "ufw_rule"
      properties { port = "WWW Full" from = "192.168.0.0/16" }
    }

    step "remove_port" {
      description = "Delete a seeded port rule"
      resource = "ufw_rule"
      properties { port = "7070/tcp" ensure = :absent }
    }

    step "remove_app" {
      description = "Delete a seeded application rule with a source"
      resource = "ufw_rule"
      properties { action = :deny port = "SSH" from = "10.1.0.0/16" ensure = :absent }
    }

    step "injection" {
      description = "A port that would run a second command is rejected"
      resource = "ufw_rule"
      expect = "error"
      properties { port = "22; touch /tmp/cw-pwned" }
    }

    step "bad_source" {
      description = "A source that is not an address is rejected"
      resource = "ufw_rule"
      expect = "error"
      properties { port = "22" from = "10.0.0.0/8 to any port 1" }
    }
  }

  // firewalld is not in the Fedora cloud image, so setup installs it; the
  // permanent configuration converges without the daemon needing to run.
  test "firewalld_converges" {
    description = "A firewalld port and service rule converge in the permanent configuration"
    template = "x86_64/fedora-44"
    setup = "dnf install -y firewalld && systemctl start firewalld"
    verify = "tests/firewalld_verify.ws"

    step "port" {
      description = "Allow a port in the default zone"
      resource = "firewalld_rule"
      properties { port = "8443/tcp" permanent = true ensure = :present }
    }

    step "service" {
      description = "Allow a named service"
      resource = "firewalld_rule"
      requires = ["port"]
      properties { service = "https" permanent = true ensure = :present }
    }

    step "absent_port_stays_absent" {
      description = "A port that was never allowed is already configured"
      resource = "firewalld_rule"
      expect = "already_configured"
      properties { port = "9999/udp" permanent = true ensure = :absent }
    }
  }
}
