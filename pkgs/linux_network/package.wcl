package "linux_network" {
  description = "Manage Linux network configuration and firewalls"

  resource "hosts_entry" {
    description = "Ensure /etc/hosts has exactly one line for an address, mapping it to exactly the given names in order, or no line for it. Lines are matched on their first field, so whitespace and trailing comments do not matter; a line for the address with other names is rewritten in place and further lines for it are removed. The address is compared as written (::1 and 0::1 are different addresses), and a name listed under another address is left alone. The file is rewritten in place, not renamed over, because container runtimes bind-mount it"
    script = "resources/hosts_entry.ws"
    // read-modify-write on the shared /etc/hosts — parallel steps lose updates
    concurrency = "exclusive"
    param "ip" { description = "IP address, the line's first field" type = "string" required = true }
    param "names" { description = "Host names for the address, first is canonical (required when :present). No whitespace or '#'" type = "list" default = [] }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Write the line for the address, replacing any existing ones" }
      symbol "absent"  { description = "Remove every line for the address" }
    }
  }

  resource "firewalld_rule" {
    description = "Ensure a firewalld rule (service, port, source or rich rule) is present or absent"
    script = "resources/firewalld_rule.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the rule" }
      symbol "absent"  { description = "Remove the rule" }
    }
    param "zone" { description = "Zone to operate on; empty uses the default zone" type = "string" default = "" }
    param "permanent" { description = "Operate on the permanent configuration" type = "bool" default = true }
    param "service" { description = "Named service to allow, such as https" type = "string" default = "" }
    param "port" { description = "Port rule such as 8080/tcp" type = "string" default = "" }
    param "source" { description = "Source address or CIDR bound to the zone" type = "string" default = "" }
    param "rich_rule" { description = "Full firewalld rich rule text" type = "string" default = "" }
  }

  resource "ufw_rule" {
    description = "Ensure a ufw rule is recorded or deleted. Presence is read from ufw show added, so it works while ufw is inactive; enabling the firewall is not managed here. ufw needs a working iptables backend"
    script = "resources/ufw_rule.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the rule" }
      symbol "absent"  { description = "Delete the rule" }
    }
    param "action" {
      description = "Rule action"
      type = "symbol"
      default = :allow

      symbol "allow"  { description = "Accept matching traffic" }
      symbol "deny"   { description = "Drop matching traffic silently" }
      symbol "reject" { description = "Refuse matching traffic with an error to the sender" }
      symbol "limit"  { description = "Accept, but deny a source that opens 6 or more connections in 30 seconds" }
    }
    param "port" { description = "Port spec such as 22, 22/tcp, 6000:6007/tcp or 80,443/tcp, or an application profile name such as OpenSSH or 'WWW Full' (anything not starting with a digit is a profile; ufw app list shows them)" type = "string" required = true }
    param "from" { description = "Optional source address or CIDR; empty or any means every source" type = "string" default = "" }
  }

  // nftables names (table, chain) are identifiers: a letter or '_' first,
  // then letters, digits, '_', '-' and '.'; nft itself rejects a name that
  // is one of its keywords (fwd, counter, ...). Nothing here persists the
  // ruleset; it lives in the kernel until saved to /etc/nftables.conf.
  resource "nftables_table" {
    description = "Ensure an nftables table exists or is absent in the running ruleset"
    script = "resources/nftables_table.ws"
    concurrency = "global"
    param "family" {
      description = "Address family"
      type = "symbol"
      default = :inet

      symbol "inet"   { description = "IPv4 and IPv6" }
      symbol "ip"     { description = "IPv4 only" }
      symbol "ip6"    { description = "IPv6 only" }
      symbol "arp"    { description = "ARP" }
      symbol "bridge" { description = "Bridged traffic" }
      symbol "netdev" { description = "Per-device ingress and egress" }
    }
    param "name" { description = "Table name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the table" }
      symbol "absent"  { description = "Delete the table and everything in it" }
    }
  }

  resource "nftables_chain" {
    description = "Ensure an nftables chain exists with the given shape, or is absent, in the running ruleset. A base chain is compared on type, hook, priority and (when set) policy, read from nft -j. A policy change is made in place; a different type, hook or priority, or turning a regular chain into a base chain or back, deletes and recreates the chain, which drops its rules, so nftables_rule steps for the chain should require this step to add them back. Removal flushes the chain first; a chain another rule still jumps to cannot be removed"
    script = "resources/nftables_chain.ws"
    concurrency = "global"
    param "family" {
      description = "Address family"
      type = "symbol"
      default = :inet

      symbol "inet"   { description = "IPv4 and IPv6" }
      symbol "ip"     { description = "IPv4 only" }
      symbol "ip6"    { description = "IPv6 only" }
      symbol "arp"    { description = "ARP" }
      symbol "bridge" { description = "Bridged traffic" }
      symbol "netdev" { description = "Per-device ingress and egress" }
    }
    param "table" { description = "Owning table name; the table must exist (see nftables_table)" type = "string" required = true }
    param "name" { description = "Chain name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the chain, or reshape it" }
      symbol "absent"  { description = "Flush and delete the chain" }
    }
    param "type" {
      description = "Base chain type; leave unset for a regular chain (a jump target with no hook)"
      type = "symbol"

      symbol "filter" { description = "Filter packets" }
      symbol "nat"    { description = "Address translation; first packet of a connection only" }
      symbol "route"  { description = "Reroute locally generated packets whose marks or addresses change (output hook)" }
    }
    param "hook" {
      description = "Base chain hook; set together with type"
      type = "symbol"

      symbol "prerouting"  { description = "Every packet as it arrives, before routing" }
      symbol "input"       { description = "Packets for this host" }
      symbol "forward"     { description = "Packets routed through this host" }
      symbol "output"      { description = "Packets this host sends" }
      symbol "postrouting" { description = "Every packet as it leaves, after routing" }
    }
    param "priority" { description = "Base chain priority as a number (filter is 0, dstnat -100, srcnat 100)" type = "int" default = 0 }
    param "policy" {
      description = "Base chain policy; unset leaves the chain's policy unmanaged (nft creates accept). Rejected on a regular chain"
      type = "symbol"

      symbol "accept" { description = "Accept packets no rule decided" }
      symbol "drop"   { description = "Drop packets no rule decided" }
    }
  }

  resource "nftables_rule" {
    description = "Ensure an nftables rule is present in or absent from a chain in the running ruleset. Rules are compared as text against nft -a list chain, ignoring whitespace and the state of stateful statements (counter packets/bytes, quota used), so write the rule as nft prints it back. When nft stores an added rule in another form (tcp dport ssh becomes tcp dport 22, limit gains burst 5 packets), apply takes it out again and fails, naming the form to use. :absent deletes every copy of the rule. A missing chain or table means the rule is absent"
    script = "resources/nftables_rule.ws"
    concurrency = "global"
    param "family" {
      description = "Address family"
      type = "symbol"
      default = :inet

      symbol "inet"   { description = "IPv4 and IPv6" }
      symbol "ip"     { description = "IPv4 only" }
      symbol "ip6"    { description = "IPv6 only" }
      symbol "arp"    { description = "ARP" }
      symbol "bridge" { description = "Bridged traffic" }
      symbol "netdev" { description = "Per-device ingress and egress" }
    }
    param "table" { description = "Owning table name" type = "string" required = true }
    param "chain" { description = "Owning chain name" type = "string" required = true }
    param "rule" { description = "Rule expression as nft prints it, such as 'tcp dport 22 accept'; one rule, so no line breaks or ';'" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the rule to the end of the chain" }
      symbol "absent"  { description = "Delete every copy of the rule from the chain" }
    }
  }

  test "network_files_converge" {
    description = "hosts entries are added, renamed, deduplicated and removed in a Debian container"
    image = "debian:12"
    group = "network"
    // 192.0.2.20 is seeded under its old names twice (once tab-separated
    // with a comment); .30 is already right but spaced differently; .40 is
    // removed.
    setup = "grep -q cw-old /etc/hosts || printf '192.0.2.20 cw-old.local cw-old\\n# keep me\\n192.0.2.20\\tcw-old2   # stale\\n192.0.2.30   cw-spaced\\tcw-sp # ok\\n192.0.2.40 cw-gone\\n' >> /etc/hosts"
    verify = "tests/network_verify.ws"

    step "hosts" {
      description = "Add a hosts entry"
      resource = "hosts_entry"
      properties { ip = "192.0.2.10" names = ["cw-test.local", "cw-test"] }
    }

    step "rename" {
      description = "Replace the names of an address seeded twice with old names"
      resource = "hosts_entry"
      properties { ip = "192.0.2.20" names = ["cw-new.local", "cw-new"] }
    }

    step "spacing" {
      description = "A line that differs only in whitespace and a comment is already converged"
      resource = "hosts_entry"
      expect = "already_configured"
      properties { ip = "192.0.2.30" names = ["cw-spaced", "cw-sp"] }
    }

    step "remove" {
      description = "Remove a seeded address"
      resource = "hosts_entry"
      properties { ip = "192.0.2.40" ensure = :absent }
    }

    step "newline" {
      description = "A name that would add a second hosts line is rejected"
      resource = "hosts_entry"
      expect = "error"
      properties { ip = "192.0.2.50" names = ["cw-a\n10.0.0.1 evil"] }
    }
  }

  // nftables needs nf_tables in the kernel, which the container micro-VM
  // kernel lacks, so it runs in an Ubuntu VM (nft ships in the image).
  // Setup seeds table cwseed with chains and rules to reshape and remove.
  // Drift chains hook forward, so a drop policy never cuts the guest off.
  test "nftables_converge" {
    description = "nftables tables, chains and rules are created, reshaped and removed"
    template = "x86_64/ubuntu-24.04"
    setup = "printf 'add table ip cwgone\\nadd table inet cwseed\\nadd chain inet cwseed seedfwd { type filter hook forward priority 0; policy drop; }\\nadd rule inet cwseed seedfwd tcp dport 2222 counter accept\\nadd rule inet cwseed seedfwd udp dport 5353 counter drop\\nadd rule inet cwseed seedfwd udp dport 5353 counter drop\\nadd chain inet cwseed reshape { type filter hook forward priority 10; }\\nadd rule inet cwseed reshape counter\\nadd chain inet cwseed doomed\\nadd rule inet cwseed doomed counter accept\\n' | nft -f -"
    verify = "tests/nftables_verify.ws"

    step "table" {
      description = "Create an nftables table"
      resource = "nftables_table"
      properties { name = "cwtest" }
    }

    step "chain" {
      description = "Create a base chain in the table"
      resource = "nftables_chain"
      requires = ["table"]
      properties { table = "cwtest" name = "input" type = :filter hook = :input priority = 0 policy = :accept }
    }

    step "regular_chain" {
      description = "Create a regular chain"
      resource = "nftables_chain"
      requires = ["table"]
      properties { table = "cwtest" name = "jumps" }
    }

    step "rule" {
      description = "Add a rule to the chain"
      resource = "nftables_rule"
      requires = ["chain"]
      properties { table = "cwtest" chain = "input" rule = "tcp dport 8080 accept" }
    }

    step "counter_rule" {
      description = "Add a counting rule, which nft prints back with packet and byte counts"
      resource = "nftables_rule"
      requires = ["chain"]
      properties { table = "cwtest" chain = "input" rule = "tcp dport 8081 counter accept" }
    }

    step "policy_drift" {
      description = "Open a seeded drop policy in place, keeping the chain's rules"
      resource = "nftables_chain"
      properties { table = "cwseed" name = "seedfwd" type = :filter hook = :forward policy = :accept }
    }

    step "seeded_counter_rule" {
      description = "A seeded counting rule is found, not added again"
      resource = "nftables_rule"
      expect = "already_configured"
      properties { table = "cwseed" chain = "seedfwd" rule = "tcp dport 2222 counter accept" }
    }

    step "reshape" {
      description = "Recreate a seeded chain whose hook and priority changed"
      resource = "nftables_chain"
      properties { table = "cwseed" name = "reshape" type = :filter hook = :prerouting priority = -5 }
    }

    step "remove_rule" {
      description = "Delete both copies of a seeded rule"
      resource = "nftables_rule"
      properties { table = "cwseed" chain = "seedfwd" rule = "udp dport 5353 counter drop" ensure = :absent }
    }

    step "remove_chain" {
      description = "Delete a seeded chain that still has rules"
      resource = "nftables_chain"
      properties { table = "cwseed" name = "doomed" ensure = :absent }
    }

    step "remove_table" {
      description = "Delete a seeded table"
      resource = "nftables_table"
      properties { family = :ip name = "cwgone" ensure = :absent }
    }

    step "absent_table_stays_absent" {
      description = "A table that was never created is already configured"
      resource = "nftables_table"
      expect = "already_configured"
      properties { name = "cw-never-created" ensure = :absent }
    }

    step "noncanonical" {
      description = "A rule nft stores in another form is taken out again and refused"
      resource = "nftables_rule"
      requires = ["chain"]
      expect = "error"
      properties { table = "cwtest" chain = "input" rule = "tcp dport ssh accept" }
    }

    step "injection" {
      description = "A rule that would run a second nft command is rejected"
      resource = "nftables_rule"
      requires = ["chain"]
      expect = "error"
      properties { table = "cwtest" chain = "input" rule = "accept; add table inet cwpwned" }
    }

    step "policy_on_regular" {
      description = "A policy on a regular chain is rejected"
      resource = "nftables_chain"
      expect = "error"
      properties { table = "cwtest" name = "nopolicy" policy = :drop }
    }
  }

  // ufw only needs an iptables backend, and the container kernel has the
  // legacy tables but no nf_tables, so setup switches the alternatives.
  test "ufw_converges" {
    description = "ufw rules for ports, sources and application profiles are added and deleted"
    image = "debian:12"
    group = "network"
    setup = "export PATH=/usr/sbin:/usr/bin:/sbin:/bin; command -v ufw >/dev/null || (apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ufw >/dev/null) && update-alternatives --set iptables /usr/sbin/iptables-legacy >/dev/null && update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy >/dev/null && ufw allow 7070/tcp >/dev/null 2>&1 && ufw deny from 10.1.0.0/16 to any app SSH >/dev/null 2>&1; ufw show added 2>/dev/null | grep -q 'ufw allow 7070/tcp'"
    verify = "tests/ufw_verify.ws"

    step "port" {
      description = "Allow a port"
      resource = "ufw_rule"
      properties { port = "9090/tcp" }
    }

    step "from_source" {
      description = "Allow a port from a source"
      resource = "ufw_rule"
      properties { action = :limit port = "9091/tcp" from = "10.0.0.0/8" }
    }

    step "app_from_source" {
      description = "Allow an application profile whose name has a space, from a source"
      resource = "ufw_rule"
      properties { port = "WWW Full" from = "192.168.0.0/16" }
    }

    step "remove_port" {
      description = "Delete a seeded port rule"
      resource = "ufw_rule"
      properties { port = "7070/tcp" ensure = :absent }
    }

    step "remove_app" {
      description = "Delete a seeded application rule with a source"
      resource = "ufw_rule"
      properties { action = :deny port = "SSH" from = "10.1.0.0/16" ensure = :absent }
    }

    step "injection" {
      description = "A port that would run a second command is rejected"
      resource = "ufw_rule"
      expect = "error"
      properties { port = "22; touch /tmp/cw-pwned" }
    }

    step "bad_source" {
      description = "A source that is not an address is rejected"
      resource = "ufw_rule"
      expect = "error"
      properties { port = "22" from = "10.0.0.0/8 to any port 1" }
    }
  }

  // firewalld is not in the Fedora cloud image, so setup installs it; the
  // permanent configuration converges without the daemon needing to run.
  test "firewalld_converges" {
    description = "A firewalld port and service rule converge in the permanent configuration"
    template = "x86_64/fedora-44"
    setup = "dnf install -y firewalld && systemctl start firewalld"
    verify = "tests/firewalld_verify.ws"

    step "port" {
      description = "Allow a port in the default zone"
      resource = "firewalld_rule"
      properties { port = "8443/tcp" permanent = true ensure = :present }
    }

    step "service" {
      description = "Allow a named service"
      resource = "firewalld_rule"
      requires = ["port"]
      properties { service = "https" permanent = true ensure = :present }
    }

    step "absent_port_stays_absent" {
      description = "A port that was never allowed is already configured"
      resource = "firewalld_rule"
      expect = "already_configured"
      properties { port = "9999/udp" permanent = true ensure = :absent }
    }
  }
}
