package "linux_apk" {
  description = "Manage packages on apk/Alpine systems"

  resource "package" {
    description = "Ensure an apk package is installed or absent"
    script = "resources/package.ws"
    concurrency = "exclusive"
    param "name" { description = "Package name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Install the package" }
      symbol "absent"  { description = "Remove the package" }
    }
  }

  resource "cache_updated" {
    description = "Run apk update when the index is older than max_age"
    script = "resources/cache_updated.ws"
    concurrency = "exclusive"
    param "max_age" {
      description = "Refresh when the last update is older than this span"
      type = "duration"
      default = 24h
    }
  }

  resource "repository" {
    description = "Ensure a repository line is present in or absent from /etc/apk/repositories"
    script = "resources/repository.ws"
    // read-modify-write on the shared repositories file
    concurrency = "exclusive"
    param "url" { description = "Repository line, such as https://dl-cdn.alpinelinux.org/alpine/v3.20/community" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the repository line" }
      symbol "absent"  { description = "Remove the repository line" }
    }
  }

  // A real install over the container's NAT: `tree` is tiny and lives in
  // Alpine's main repository.
  test "package_installs" {
    description = "package installs a real package and removing it converges"
    image = "alpine:3.20"
    verify = "tests/apk_install_verify.ws"

    step "install" {
      description = "Install tree"
      resource = "package"
      properties { name = "tree" ensure = :present }
    }

    step "absent_stays_absent" {
      description = "A package that was never installed is already configured"
      resource = "package"
      expect = "already_configured"
      properties { name = "cw-no-such-package" ensure = :absent }
    }
  }

  test "apk_existing_package" {
    description = "apk installed package checks and repository edits work in Alpine"
    image = "alpine:3.20"
    setup = "echo 'https://stale.invalid/alpine/v3.20/testing' >> /etc/apk/repositories"
    verify = "tests/apk_verify.ws"

    step "alpine-baselayout-installed" {
      description = "alpine-baselayout is installed in Alpine"
      resource = "package"
      expect = "already_configured"
      properties { name = "alpine-baselayout" }
    }

    step "repo" {
      // edge/testing is NOT in the image's default repositories file, so the
      // step genuinely converges (main/community already ship enabled).
      description = "Add a repository line"
      resource = "repository"
      properties { url = "https://dl-cdn.alpinelinux.org/alpine/edge/testing" }
    }

    step "rm_repo" {
      description = "Remove the seeded stale repository line"
      resource = "repository"
      properties { url = "https://stale.invalid/alpine/v3.20/testing" ensure = :absent }
    }
  }
}
