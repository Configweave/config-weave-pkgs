// Typed resources for every aspect of an IIS web site: the role services
// that make up the web server, application pools, sites, bindings,
// applications and virtual directories, the delegated feature sections
// (authentication, authorization, TLS, request filtering, default
// documents, errors, headers, compression, caching, handlers, modules),
// certificates, and URL Rewrite.
//
// Four conventions run through the whole package:
//
//   * Everything is written to applicationHost.config. Scripts commit with
//     `Set-WebConfigurationProperty -PSPath MACHINE/WEBROOT/APPHOST
//     -Location "<site><path>"` — the PowerShell spelling of appcmd's
//     /commit:apphost. That sidesteps IIS's biggest footgun: the
//     system.webServer/security/* sections are locked at the server level,
//     so writing them into a site's web.config yields a 500.19 at request
//     time rather than an error at write time. Resources that can legally
//     live in web.config take a `store` param (:apphost, the default, or
//     :web_config) for playbooks that want delegation instead.
//
//   * Optional attributes are declared with NO default. A param the step
//     omits is absent from the params map, and that absence means "leave
//     this setting alone" — the only way a bool or int param can say that,
//     since a declared default would instead mean "set it to false" / "set
//     it to 0". Facets a playbook may not want to own at all use the
//     :unmanaged symbol instead. Neither form can *remove* an attribute;
//     windows_iis.config_property reaches that.
//
//   * `site` and `path` scope a delegated section. Empty `site` means the
//     server-level defaults every site inherits; `path` is an application
//     or virtual path under the site, e.g. "/api". Together they form the
//     -Location string.
//
//   * Symbol params enumerate IIS's own values with `symbol` blocks, so
//     config-weave validates them and the generated docs list them. WCL
//     symbols cannot contain hyphens or dots, so Web-Server is declared
//     :web_server and v4.0 is declared :v4_0; the scripts map the spelling
//     back. That is the only accepted spelling.
//
// Everything shells out to PowerShell's WebAdministration module, so the
// target needs the IIS management scripting tools — `feature` with
// :web_server and include_management_tools = true, or the :scripting_tools
// role service on its own. IIS owns the schema validation, the collection
// merge semantics and the config file locking, none of which a hand-rolled
// XML writer gets right.
//
// IIS is version 10.0 on Windows Server 2016 through 2025 and the
// configuration schema has not moved since 8.5, so this models a fixed
// target. Individual attributes are only as old as the feature behind
// them: setting one whose module is not installed writes config that IIS
// either ignores or rejects at request time.
//
// Out of scope: FTP (system.ftpServer/*), WebDAV, shared and redirected
// configuration, and Application Request Routing. ASP.NET's own settings
// (system.web/* — sessionState, machineKey, customErrors, forms auth) live
// in web.config and are better served by windows_files.template.
package "windows_iis" {
  description = "Manage IIS: role services, application pools, sites, bindings, the delegated feature sections, certificates and URL Rewrite"

  // ---------------------------------------------------------------------
  // Installation
  // ---------------------------------------------------------------------

  // Every other resource in this package needs the role installed and the
  // WebAdministration module present, so this is the one that goes first.
  // It wraps Install-WindowsFeature exactly as
  // windows_features.windows_server_feature does — the win here is that
  // the ~53 Web-* role services are enumerated as symbols, so the docs list
  // them and a typo is a validation error rather than a silent no-op.
  resource "feature" {
    description = "Install or remove an IIS role service"
    script = "resources/feature.ws"
    // DISM/Server Manager takes a machine-wide lock, and a role service
    // install rewrites applicationHost.config's module and handler lists.
    concurrency = "global"
    param "name" {
      description = "The IIS role service, named after its Web-* feature"
      type = "symbol"
      required = true

      symbol "web_server"          { description = "Web-Server: the Web Server (IIS) role itself" }
      symbol "web_webserver"       { description = "Web-WebServer: the Web Server role service group" }
      symbol "common_http"         { description = "Web-Common-Http: the Common HTTP Features group" }
      symbol "default_doc"         { description = "Web-Default-Doc: serve a default document for a directory request" }
      symbol "dir_browsing"        { description = "Web-Dir-Browsing: directory browsing" }
      symbol "http_errors"         { description = "Web-Http-Errors: custom HTTP error responses" }
      symbol "static_content"      { description = "Web-Static-Content: serve files from disk" }
      symbol "http_redirect"       { description = "Web-Http-Redirect: HTTP redirection" }
      symbol "dav_publishing"      { description = "Web-DAV-Publishing: WebDAV publishing" }
      symbol "health"              { description = "Web-Health: the Health and Diagnostics group" }
      symbol "http_logging"        { description = "Web-Http-Logging: per-site request logging" }
      symbol "custom_logging"      { description = "Web-Custom-Logging: custom logging modules" }
      symbol "log_libraries"       { description = "Web-Log-Libraries: the logging tools and libraries" }
      symbol "odbc_logging"        { description = "Web-ODBC-Logging: log to an ODBC data source" }
      symbol "request_monitor"     { description = "Web-Request-Monitor: live request monitoring" }
      symbol "http_tracing"        { description = "Web-Http-Tracing: failed request tracing" }
      symbol "performance"         { description = "Web-Performance: the Performance group" }
      symbol "stat_compression"    { description = "Web-Stat-Compression: static content compression" }
      symbol "dyn_compression"     { description = "Web-Dyn-Compression: dynamic content compression" }
      symbol "security"            { description = "Web-Security: the Security group" }
      symbol "filtering"           { description = "Web-Filtering: request filtering" }
      symbol "basic_auth"          { description = "Web-Basic-Auth: Basic authentication" }
      symbol "cert_provider"       { description = "Web-CertProvider: the centralised certificate provider" }
      symbol "client_auth"         { description = "Web-Client-Auth: Active Directory client certificate mapping" }
      symbol "digest_auth"         { description = "Web-Digest-Auth: Digest authentication" }
      symbol "cert_auth"           { description = "Web-Cert-Auth: IIS client certificate mapping" }
      symbol "ip_security"         { description = "Web-IP-Security: IP and domain restrictions" }
      symbol "url_auth"            { description = "Web-Url-Auth: URL authorization" }
      symbol "windows_auth"        { description = "Web-Windows-Auth: Windows authentication" }
      symbol "app_dev"             { description = "Web-App-Dev: the Application Development group" }
      symbol "net_ext"             { description = "Web-Net-Ext: .NET Extensibility 3.5" }
      symbol "net_ext45"           { description = "Web-Net-Ext45: .NET Extensibility 4.x" }
      symbol "app_init"            { description = "Web-AppInit: Application Initialization" }
      symbol "asp"                 { description = "Web-ASP: classic ASP" }
      symbol "asp_net"             { description = "Web-Asp-Net: ASP.NET 3.5" }
      symbol "asp_net45"           { description = "Web-Asp-Net45: ASP.NET 4.x" }
      symbol "cgi"                 { description = "Web-CGI: CGI" }
      symbol "isapi_ext"           { description = "Web-ISAPI-Ext: ISAPI extensions" }
      symbol "isapi_filter"        { description = "Web-ISAPI-Filter: ISAPI filters" }
      symbol "includes"            { description = "Web-Includes: server side includes" }
      symbol "websockets"          { description = "Web-WebSockets: the WebSocket protocol" }
      symbol "ftp_server"          { description = "Web-Ftp-Server: the FTP Server group" }
      symbol "ftp_service"         { description = "Web-Ftp-Service: the FTP service" }
      symbol "ftp_ext"             { description = "Web-Ftp-Ext: FTP extensibility" }
      symbol "mgmt_tools"          { description = "Web-Mgmt-Tools: the Management Tools group" }
      symbol "mgmt_console"        { description = "Web-Mgmt-Console: IIS Manager" }
      symbol "scripting_tools"     { description = "Web-Scripting-Tools: the IIS management scripts and the WebAdministration PowerShell module" }
      symbol "mgmt_service"        { description = "Web-Mgmt-Service: the remote management service" }
      symbol "mgmt_compat"         { description = "Web-Mgmt-Compat: the IIS 6 management compatibility group" }
      symbol "metabase"            { description = "Web-Metabase: IIS 6 metabase compatibility" }
      symbol "lgcy_mgmt_console"   { description = "Web-Lgcy-Mgmt-Console: the IIS 6 management console" }
      symbol "lgcy_scripting"      { description = "Web-Lgcy-Scripting: IIS 6 scripting tools" }
      symbol "wmi"                 { description = "Web-WMI: the IIS 6 WMI provider" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Install the role service" }
      symbol "absent"  { description = "Remove the role service" }
    }
    param "include_management_tools" { description = "Also install the feature's management tools; :web_server needs this for the WebAdministration module the rest of this package uses" type = "bool" default = false }
  }

  // ---------------------------------------------------------------------
  // Application pools
  // ---------------------------------------------------------------------

  // The pool itself and its process model. The recycling, failure and cpu
  // sub-elements are separate resources rather than another 30 params here,
  // so a playbook that only wants a nightly recycle does not have to
  // restate the pool's identity.
  resource "app_pool" {
    description = "Ensure an application pool exists with the given runtime, identity and process model, or is absent"
    script = "resources/app_pool.ws"
    concurrency = "global"
    param "name" { description = "Application pool name" type = "string" required = true }
    param "ensure" {
      description = "Whether the pool exists"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the pool" }
      symbol "absent"  { description = "Delete the pool" }
    }
    param "state" {
      description = "Runtime state to enforce"
      type = "symbol"
      default = :unmanaged

      symbol "started"   { description = "Start the pool" }
      symbol "stopped"   { description = "Stop the pool" }
      symbol "unmanaged" { description = "Leave the runtime state alone" }
    }
    param "auto_start" { description = "autoStart: start the pool when it is created and when IIS starts" type = "bool" }
    param "managed_runtime_version" {
      description = "managedRuntimeVersion: the CLR the worker process loads"
      type = "symbol"

      symbol "none" { description = "No Managed Code — the empty string, for pools serving static content or an out-of-process runtime" }
      symbol "v1_1" { description = "CLR 1.1" }
      symbol "v2_0" { description = "CLR 2.0 — .NET Framework 2.0, 3.0 and 3.5" }
      symbol "v4_0" { description = "CLR 4.0 — .NET Framework 4.x" }
    }
    param "managed_pipeline_mode" {
      description = "managedPipelineMode: how managed content is processed"
      type = "symbol"

      symbol "integrated" { description = "The unified IIS and ASP.NET pipeline" }
      symbol "classic"    { description = "Separate IIS and ASP.NET pipelines, for ASP.NET 1.1 and apps that need ISAPI semantics" }
    }
    param "enable_32bit" { description = "enable32BitAppOnWin64: run the worker process as 32-bit on 64-bit Windows" type = "bool" }
    param "start_mode" {
      description = "startMode: when the Windows Process Activation Service starts the pool"
      type = "symbol"

      symbol "on_demand"      { description = "Start on the first request for a hosted application" }
      symbol "always_running" { description = "Keep the pool started so the runtime is warm before the first request" }
    }
    param "queue_length" { description = "queueLength: requests HTTP.sys queues for the pool before rejecting with a 503" type = "int" }
    param "enable_configuration_override" { description = "enableConfigurationOverride: honour delegated settings from web.config files in this pool" type = "bool" }
    param "identity_type" {
      description = "processModel.identityType: the account the worker process runs as"
      type = "symbol"

      symbol "application_pool_identity" { description = "The virtual IIS AppPool\\<name> account — the default, and the least privileged" }
      symbol "local_service"             { description = "NT AUTHORITY\\LocalService" }
      symbol "local_system"              { description = "NT AUTHORITY\\System — fully privileged, avoid" }
      symbol "network_service"           { description = "NT AUTHORITY\\NetworkService" }
      symbol "specific_user"             { description = "The account named by username and password" }
    }
    param "username" { description = "processModel.userName: the account when identity_type is :specific_user" type = "string" default = "" }
    param "password" { description = "processModel.password: the password for username" type = "string" default = "" }
    param "idle_timeout" { description = "processModel.idleTimeout: shut the worker process down after this long with no requests; 0 disables" type = "duration" }
    param "idle_timeout_action" {
      description = "processModel.idleTimeoutAction: what to do with the worker process when idle_timeout expires"
      type = "symbol"

      symbol "terminate" { description = "Kill the worker process" }
      symbol "suspend"   { description = "Suspend it, so the next request resumes rather than cold-starts" }
    }
    param "max_processes" { description = "processModel.maxProcesses: worker processes serving the pool; more than 1 makes it a web garden, 0 means one per logical CPU" type = "int" }
    param "load_user_profile" { description = "processModel.loadUserProfile: load the identity's user profile" type = "bool" }
    param "set_profile_environment" { description = "processModel.setProfileEnvironment: build the worker process environment from the identity's profile" type = "bool" }
    param "ping_enabled" { description = "processModel.pingingEnabled: health-ping the worker process" type = "bool" }
    param "ping_interval" { description = "processModel.pingInterval: how often to health-ping" type = "duration" }
    param "ping_response_time" { description = "processModel.pingResponseTime: how long a worker process may take to answer a ping before it is recycled" type = "duration" }
    param "startup_time_limit" { description = "processModel.startupTimeLimit: how long a worker process may take to start" type = "duration" }
    param "shutdown_time_limit" { description = "processModel.shutdownTimeLimit: how long a worker process may take to drain before it is killed" type = "duration" }
    param "logon_type" {
      description = "processModel.logonType: the logon type used for the identity"
      type = "symbol"

      symbol "batch"       { description = "LogonBatch" }
      symbol "service"     { description = "LogonService" }
    }
    param "manual_group_membership" { description = "processModel.manualGroupMembership: do not add the identity to IIS_IUSRS automatically" type = "bool" }
  }

  resource "app_pool_recycling" {
    description = "Ensure an application pool's recycling policy"
    script = "resources/app_pool_recycling.ws"
    concurrency = "global"
    param "pool" { description = "Application pool name" type = "string" required = true }
    param "disallow_overlapping_rotation" { description = "recycling.disallowOverlappingRotation: drain the old worker process before starting the new one instead of overlapping them" type = "bool" }
    param "disallow_rotation_on_config_change" { description = "recycling.disallowRotationOnConfigChange: do not recycle when the pool's configuration changes" type = "bool" }
    param "log_event_on_recycle" { description = "recycling.logEventOnRecycle: recycle reasons to write to the event log, from Time, Requests, Schedule, Memory, IsapiUnhealthy, OnDemand, ConfigChange and PrivateMemory" type = "list" }
    param "periodic_restart_time" { description = "recycling.periodicRestart.time: recycle after this long; 0 disables" type = "duration" }
    param "periodic_restart_memory" { description = "recycling.periodicRestart.memory: recycle above this virtual memory in KB; 0 disables" type = "int" }
    param "periodic_restart_private_memory" { description = "recycling.periodicRestart.privateMemory: recycle above this private memory in KB; 0 disables" type = "int" }
    param "periodic_restart_requests" { description = "recycling.periodicRestart.requests: recycle after this many requests; 0 disables" type = "int" }
    param "schedule" { description = "recycling.periodicRestart.schedule: wall-clock times to recycle at, as HH:MM:SS strings; an empty list clears the schedule" type = "list" }
  }

  resource "app_pool_failure" {
    description = "Ensure an application pool's rapid-fail protection and orphan/shutdown actions"
    script = "resources/app_pool_failure.ws"
    concurrency = "global"
    param "pool" { description = "Application pool name" type = "string" required = true }
    param "rapid_fail_protection" { description = "failure.rapidFailProtection: shut the pool down when it crashes too often" type = "bool" }
    param "rapid_fail_protection_interval" { description = "failure.rapidFailProtectionInterval: the window crashes are counted over" type = "duration" }
    param "rapid_fail_protection_max_crashes" { description = "failure.rapidFailProtectionMaxCrashes: crashes within the interval that trip the protection" type = "int" }
    param "load_balancer_capabilities" {
      description = "failure.loadBalancerCapabilities: how a request to a shut-down pool is refused"
      type = "symbol"

      symbol "http_level" { description = "Answer with a 503 so a load balancer sees an HTTP error" }
      symbol "tcp_level"  { description = "Reset the connection so a load balancer sees the node as down" }
    }
    param "orphan_worker_process" { description = "failure.orphanWorkerProcess: orphan an unhealthy worker process for debugging instead of terminating it" type = "bool" }
    param "orphan_action_exe" { description = "failure.orphanActionExe: executable run when a worker process is orphaned" type = "string" default = "" }
    param "orphan_action_params" { description = "failure.orphanActionParams: arguments for orphan_action_exe" type = "string" default = "" }
    param "auto_shutdown_exe" { description = "failure.autoShutdownExe: executable run when rapid-fail protection shuts the pool down" type = "string" default = "" }
    param "auto_shutdown_params" { description = "failure.autoShutdownParams: arguments for auto_shutdown_exe" type = "string" default = "" }
  }

  resource "app_pool_cpu" {
    description = "Ensure an application pool's CPU limit, throttling action and processor affinity"
    script = "resources/app_pool_cpu.ws"
    concurrency = "global"
    param "pool" { description = "Application pool name" type = "string" required = true }
    param "limit" { description = "cpu.limit: the CPU ceiling in thousandths of a percent, so 20000 is 20%; 0 disables" type = "int" }
    param "action" {
      description = "cpu.action: what to do when the pool exceeds limit"
      type = "symbol"

      symbol "no_action"           { description = "Only log the event" }
      symbol "kill_w3wp"           { description = "Recycle the worker process" }
      symbol "throttle"            { description = "Hold the pool at limit" }
      symbol "throttle_under_load" { description = "Hold the pool at limit only while the machine is contended" }
    }
    param "reset_interval" { description = "cpu.resetInterval: how often the CPU counters reset; 0 disables the limit" type = "duration" }
    param "smp_affinitized" { description = "cpu.smpAffinitized: pin the pool's worker processes to the CPUs in the affinity masks" type = "bool" }
    param "smp_processor_affinity_mask" { description = "cpu.smpProcessorAffinityMask: bitmask of the CPUs in processor group 0 the pool may use" type = "int" }
    param "smp_processor_affinity_mask2" { description = "cpu.smpProcessorAffinityMask2: bitmask for processor group 1 on machines with more than 64 CPUs" type = "int" }
  }

  resource "app_pool_environment_variable" {
    description = "Ensure an environment variable is set for an application pool's worker processes, or absent"
    script = "resources/app_pool_environment_variable.ws"
    concurrency = "global"
    param "pool" { description = "Application pool name" type = "string" required = true }
    param "name" { description = "Environment variable name" type = "string" required = true }
    param "value" { description = "Environment variable value; required when present" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Set the variable" }
      symbol "absent"  { description = "Remove the variable" }
    }
  }

  // ---------------------------------------------------------------------
  // Sites, applications and virtual directories
  // ---------------------------------------------------------------------

  // A site is the root application plus its root virtual directory, so
  // physical_path and app_pool here configure "/" — the same fields the IIS
  // Manager "Add Web Site" dialog asks for. Nested applications and extra
  // virtual directories are the `application` and `virtual_directory`
  // resources. A missing physical_path is created, as windows_share.share
  // creates its backing directory: a site pointed at a directory that does
  // not exist starts, then 500s on every request.
  resource "site" {
    description = "Ensure a web site exists with the given root path and application pool, or is absent"
    script = "resources/site.ws"
    concurrency = "global"
    param "name" { description = "Site name" type = "string" required = true }
    param "ensure" {
      description = "Whether the site exists"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the site" }
      symbol "absent"  { description = "Delete the site" }
    }
    param "physical_path" { description = "Directory backing the site's root application, created when missing; required when present" type = "string" default = "" }
    param "app_pool" { description = "Application pool the root application runs in; empty leaves IIS's choice alone" type = "string" default = "" }
    param "state" {
      description = "Runtime state to enforce"
      type = "symbol"
      default = :unmanaged

      symbol "started"   { description = "Start the site" }
      symbol "stopped"   { description = "Stop the site" }
      symbol "unmanaged" { description = "Leave the runtime state alone" }
    }
    param "server_auto_start" { description = "serverAutoStart: start the site when the World Wide Web Publishing Service starts" type = "bool" }
    param "id" { description = "Numeric site id; 0 lets IIS assign one. Create-only — an existing site is not renumbered" type = "int" default = 0 }
  }

  // Identity is the whole tuple (site, protocol, ip, port, host_header) —
  // that is what IIS itself keys a binding on, and it is why changing a
  // port adds a binding rather than editing one. Use ensure = :absent on
  // the old tuple to retire it.
  resource "binding" {
    description = "Ensure a site binding exists on the given protocol, address, port and host header, or is absent"
    script = "resources/binding.ws"
    concurrency = "global"
    param "site" { description = "Site name" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the binding" }
      symbol "absent"  { description = "Remove the binding" }
    }
    param "protocol" {
      description = "Binding protocol"
      type = "symbol"
      default = :http

      symbol "http"            { description = "HTTP" }
      symbol "https"           { description = "HTTPS — needs a certificate unless ssl_flags uses the central certificate store" }
      symbol "net_tcp"         { description = "net.tcp, for WCF services" }
      symbol "net_pipe"        { description = "net.pipe, for WCF services" }
      symbol "net_msmq"        { description = "net.msmq, for WCF services" }
      symbol "msmq_formatname" { description = "msmq.formatname, for WCF services" }
    }
    param "ip" { description = "IP address to listen on; * is all unassigned addresses" type = "string" default = "*" }
    param "port" { description = "TCP port" type = "int" default = 80 }
    param "host_header" { description = "Host header to match; empty matches any host" type = "string" default = "" }
    param "ssl_flags" {
      description = "sslFlags: how an https binding finds its certificate"
      type = "symbol"
      default = :none

      symbol "none"                  { description = "One certificate for the IP and port, named by certificate_thumbprint" }
      symbol "sni"                   { description = "Server Name Indication — a certificate per host header on a shared port" }
      symbol "central_cert_store"    { description = "Take the certificate from the central certificate store by file name; certificate_thumbprint must be empty" }
      symbol "sni_central_cert_store" { description = "Server Name Indication with the central certificate store" }
    }
    param "certificate_thumbprint" { description = "SHA-1 thumbprint of the certificate to bind; required for https unless certificate_subject is given or ssl_flags uses the central certificate store" type = "string" default = "" }
    param "certificate_subject" { description = "Subject of the certificate to bind, such as CN=www.example.com, looked up in certificate_store when certificate_thumbprint is empty. This is how a binding follows a certificate another step created, since a thumbprint is not known until then" type = "string" default = "" }
    param "certificate_store" { description = "LocalMachine store holding the certificate, usually My or WebHosting" type = "string" default = "My" }
  }

  resource "application" {
    description = "Ensure an application exists at a path under a site, or is absent"
    script = "resources/application.ws"
    concurrency = "global"
    param "site" { description = "Site name" type = "string" required = true }
    param "path" { description = "Virtual path under the site, such as /api" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the application" }
      symbol "absent"  { description = "Delete the application" }
    }
    param "physical_path" { description = "Directory backing the application's root virtual directory, created when missing; required when present" type = "string" default = "" }
    param "app_pool" { description = "Application pool to run in; empty inherits the site's" type = "string" default = "" }
    param "enabled_protocols" { description = "enabledProtocols: comma-separated protocols the application answers, such as http,net.tcp" type = "string" default = "" }
    param "preload_enabled" { description = "preloadEnabled: have IIS send a warm-up request after the pool starts; needs the :app_init role service and an always-running pool" type = "bool" }
    param "service_auto_start_enabled" { description = "serviceAutoStartEnabled: run the auto-start provider when the pool starts" type = "bool" }
    param "service_auto_start_provider" { description = "serviceAutoStartProvider: name of the registered auto-start provider" type = "string" default = "" }
  }

  resource "virtual_directory" {
    description = "Ensure a virtual directory exists under an application, or is absent"
    script = "resources/virtual_directory.ws"
    concurrency = "global"
    param "site" { description = "Site name" type = "string" required = true }
    param "application" { description = "Virtual path of the parent application; / is the site's root application" type = "string" default = "/" }
    param "path" { description = "Virtual path of the directory under the application, such as /static" type = "string" required = true }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create the virtual directory" }
      symbol "absent"  { description = "Delete the virtual directory" }
    }
    param "physical_path" { description = "Directory the virtual path maps to, created when missing and local; required when present" type = "string" default = "" }
    param "username" { description = "userName: account used to reach the physical path, for a UNC share; empty uses pass-through authentication" type = "string" default = "" }
    param "password" { description = "password: the password for username" type = "string" default = "" }
    param "logon_method" {
      description = "logonMethod: the logon type used for username"
      type = "symbol"

      symbol "interactive" { description = "Interactive logon" }
      symbol "batch"       { description = "Batch logon" }
      symbol "network"     { description = "Network logon" }
      symbol "cleartext"   { description = "Cleartext network logon, which lets the token reach the network" }
    }
    param "allow_sub_dir_config" { description = "allowSubDirConfig: read web.config files from subdirectories" type = "bool" }
  }

  resource "site_limits" {
    description = "Ensure a site's bandwidth, connection and timeout limits"
    script = "resources/site_limits.ws"
    concurrency = "global"
    param "site" { description = "Site name" type = "string" required = true }
    param "max_bandwidth" { description = "limits.maxBandwidth: bytes per second the site may send; 4294967295 is unlimited" type = "int" }
    param "max_connections" { description = "limits.maxConnections: concurrent connections the site accepts; 4294967295 is unlimited" type = "int" }
    param "connection_timeout" { description = "limits.connectionTimeout: how long an idle connection is held open" type = "duration" }
    param "max_url_segments" { description = "limits.maxUrlSegments: path segments a request URL may contain" type = "int" }
  }

  resource "site_logging" {
    description = "Ensure a site's request log format, location and rollover policy"
    script = "resources/site_logging.ws"
    concurrency = "global"
    param "site" { description = "Site name" type = "string" required = true }
    param "enabled" { description = "logFile.enabled: log requests for this site" type = "bool" }
    param "directory" { description = "logFile.directory: directory the log files are written under" type = "string" default = "" }
    param "format" {
      description = "logFile.logFormat: the log file format"
      type = "symbol"

      symbol "iis"    { description = "The fixed Microsoft IIS format" }
      symbol "ncsa"   { description = "The NCSA Common format" }
      symbol "w3c"    { description = "The W3C Extended format, the only one whose fields are selectable" }
      symbol "custom" { description = "A custom format supplied by a logging module" }
    }
    param "period" {
      description = "logFile.period: how often a new log file is started"
      type = "symbol"

      symbol "max_size" { description = "Roll over at truncate_size rather than on a clock" }
      symbol "daily"    { description = "A new file each day" }
      symbol "weekly"   { description = "A new file each week" }
      symbol "monthly"  { description = "A new file each month" }
      symbol "hourly"   { description = "A new file each hour" }
    }
    param "truncate_size" { description = "logFile.truncateSize: bytes a log file may reach before rollover when period is :max_size; the minimum is 1048576" type = "int" }
    param "local_time_rollover" { description = "logFile.localTimeRollover: roll over on local time instead of UTC" type = "bool" }
    param "log_ext_file_flags" { description = "logFile.logExtFileFlags: W3C fields to log, from Date, Time, ClientIP, UserName, SiteName, ComputerName, ServerIP, Method, UriStem, UriQuery, HttpStatus, Win32Status, BytesSent, BytesRecv, TimeTaken, ServerPort, UserAgent, Cookie, Referer and HttpSubStatus" type = "list" }
    param "log_target" {
      description = "logFile.logTargetW3C: where W3C log records go"
      type = "symbol"

      symbol "file"         { description = "Log files on disk" }
      symbol "etw"          { description = "Event Tracing for Windows only" }
      symbol "etw_and_file" { description = "Both ETW and log files" }
    }
  }

  resource "failed_request_tracing" {
    description = "Ensure a site's failed request tracing log settings"
    script = "resources/failed_request_tracing.ws"
    concurrency = "global"
    param "site" { description = "Site name" type = "string" required = true }
    param "enabled" { description = "traceFailedRequestsLogging.enabled: write failed request trace logs for this site" type = "bool" }
    param "directory" { description = "traceFailedRequestsLogging.directory: directory the trace logs are written under" type = "string" default = "" }
    param "max_log_files" { description = "traceFailedRequestsLogging.maxLogFiles: trace files kept before the oldest is deleted" type = "int" }
    param "max_log_file_size" { description = "traceFailedRequestsLogging.maxLogFileSizeKB: size in KB a trace file may reach" type = "int" }
    param "custom_actions_enabled" { description = "traceFailedRequestsLogging.customActionsEnabled: allow trace rules to run a custom action" type = "bool" }
  }

  // The rule says which requests get traced. Providers are written as
  // "Provider:areas:verbosity" strings — "WWW Server:Authentication:Verbose"
  // — because a list of records is not expressible as a param type.
  resource "failed_request_tracing_rule" {
    description = "Ensure a failed request tracing rule for a content path, or that it is absent"
    script = "resources/failed_request_tracing_rule.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty applies the rule at the server level" type = "string" default = "" }
    param "path" { description = "Application or virtual path the rule is scoped to" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the rule" }
      symbol "absent"  { description = "Remove the rule" }
    }
    param "content_path" { description = "Content the rule matches, such as *.aspx or *" type = "string" required = true }
    param "status_codes" { description = "failureDefinitions.statusCodes: status codes that trigger a trace, such as 404,500-599" type = "string" default = "" }
    param "time_taken" { description = "failureDefinitions.timeTaken: trace a request that takes longer than this" type = "duration" }
    param "verbosity" {
      description = "failureDefinitions.verbosity: the minimum event level that triggers a trace"
      type = "symbol"

      symbol "ignore"         { description = "Do not trigger on event level" }
      symbol "critical_error" { description = "Critical errors only" }
      symbol "error"          { description = "Errors and worse" }
      symbol "warning"        { description = "Warnings and worse" }
    }
    // The traceAreas verbosity is a DIFFERENT enum from the one above: it runs
    // General, CriticalError, Error, Warning, Information, Verbose — no
    // Ignore, and it does have the two levels failureDefinitions lacks. The
    // script validates the third field against that set.
    param "providers" { description = "traceAreas entries as \"Provider:areas:verbosity\" strings, e.g. \"WWW Server:Authentication,Security:Verbose\"; verbosity is one of General, CriticalError, Error, Warning, Information or Verbose" type = "list" }
  }

  // ---------------------------------------------------------------------
  // Authentication
  // ---------------------------------------------------------------------

  // One resource per authentication scheme rather than one resource with a
  // `scheme` symbol: the schemes share only `enabled`, and windowsAuth's
  // providers have nothing in common with basicAuth's realm.
  //
  // These sections are locked at the server level in a stock IIS, which is
  // why they default to store = :apphost. Writing them into a site's
  // web.config needs windows_iis.section_delegation to unlock the section
  // first, or every request to the site fails with a 500.19.

  resource "anonymous_authentication" {
    description = "Ensure Anonymous authentication's enabled state and identity for a site or path"
    script = "resources/anonymous_authentication.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default all sites inherit" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path — works even while the section is locked" }
      symbol "web_config" { description = "The web.config at site and path — needs the section unlocked with windows_iis.section_delegation" }
    }
    param "enabled" { description = "enabled: allow unauthenticated requests" type = "bool" }
    param "username" { description = "userName: the account anonymous requests impersonate; empty string means the application pool identity" type = "string" default = "" }
    param "password" { description = "password: the password for username" type = "string" default = "" }
    param "logon_method" {
      description = "logonMethod: the logon type used for username"
      type = "symbol"

      symbol "interactive" { description = "Interactive logon" }
      symbol "batch"       { description = "Batch logon" }
      symbol "network"     { description = "Network logon" }
      symbol "cleartext"   { description = "Cleartext network logon, which lets the token reach the network" }
    }
  }

  resource "basic_authentication" {
    description = "Ensure Basic authentication's enabled state and realm for a site or path"
    script = "resources/basic_authentication.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path — needs the section unlocked" }
    }
    param "enabled" { description = "enabled: offer Basic authentication. Credentials cross the wire base64-encoded, so pair it with TLS" type = "bool" }
    param "realm" { description = "realm: the realm shown in the browser's credential prompt" type = "string" default = "" }
    param "default_logon_domain" { description = "defaultLogonDomain: domain used when the user supplies a bare user name" type = "string" default = "" }
    param "logon_method" {
      description = "logonMethod: the logon type used for the authenticated user"
      type = "symbol"

      symbol "interactive" { description = "Interactive logon" }
      symbol "batch"       { description = "Batch logon" }
      symbol "network"     { description = "Network logon" }
      symbol "cleartext"   { description = "Cleartext network logon, which lets the token reach the network" }
    }
  }

  resource "digest_authentication" {
    description = "Ensure Digest authentication's enabled state and realm for a site or path"
    script = "resources/digest_authentication.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path — needs the section unlocked" }
    }
    param "enabled" { description = "enabled: offer Digest authentication; the server must be domain-joined" type = "bool" }
    param "realm" { description = "realm: the realm the digest is computed against, normally the domain name" type = "string" default = "" }
  }

  resource "windows_authentication" {
    description = "Ensure Windows authentication's enabled state, providers and kernel-mode settings for a site or path"
    script = "resources/windows_authentication.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path — needs the section unlocked" }
    }
    param "enabled" { description = "enabled: offer Negotiate/NTLM authentication" type = "bool" }
    param "providers" { description = "providers: the schemes offered, in preference order, from Negotiate, NTLM and Negotiate:Kerberos; an empty list clears them" type = "list" }
    param "auth_persist_single_request" { description = "authPersistSingleRequest: re-authenticate every request instead of persisting the token on the connection" type = "bool" }
    param "auth_persist_non_ntlm" { description = "authPersistNonNTLM: persist Kerberos authentication across the requests on a connection" type = "bool" }
    param "use_kernel_mode" { description = "useKernelMode: decrypt the ticket in HTTP.sys, which is faster and lets the pool run unprivileged" type = "bool" }
    param "use_app_pool_credentials" { description = "useAppPoolCredentials: with kernel mode on, decrypt with the pool identity rather than the machine account — needed when a custom identity holds the SPN" type = "bool" }
  }

  resource "client_certificate_mapping_authentication" {
    description = "Ensure Active Directory client certificate mapping authentication's enabled state for a site or path"
    script = "resources/client_certificate_mapping_authentication.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path — needs the section unlocked" }
    }
    param "enabled" { description = "enabled: map client certificates to Windows accounts through Active Directory; the server must be domain-joined" type = "bool" }
  }

  resource "iis_client_certificate_mapping_authentication" {
    description = "Ensure IIS client certificate mapping authentication's enabled state and mapping modes for a site or path"
    script = "resources/iis_client_certificate_mapping_authentication.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path — needs the section unlocked" }
    }
    // IIS documents this section as configurable at the server and site level
    // only — unlike digestAuthentication, which also names application, virtual
    // directory and URL. A `path` below a site is therefore untested here, and
    // may be accepted and then ignored.
    param "enabled" { description = "enabled: map client certificates to accounts using IIS's own mapping tables" type = "bool" }
    param "one_to_one_enabled" { description = "oneToOneCertificateMappingsEnabled: honour the one-to-one mapping table" type = "bool" }
    param "many_to_one_enabled" { description = "manyToOneCertificateMappingsEnabled: honour the many-to-one mapping table" type = "bool" }
    param "default_logon_domain" { description = "defaultLogonDomain: domain used when a mapping names a bare user name" type = "string" default = "" }
  }

  // ---------------------------------------------------------------------
  // Authorization, TLS and request restrictions
  // ---------------------------------------------------------------------

  resource "authorization_rule" {
    description = "Ensure a URL authorization rule for a site or path, or that it is absent"
    script = "resources/authorization_rule.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the rule is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the rule" }
      symbol "absent"  { description = "Remove the rule" }
    }
    param "access_type" {
      description = "accessType: whether the rule grants or refuses access"
      type = "symbol"
      default = :allow

      symbol "allow" { description = "Grant access to the named users, roles and verbs" }
      symbol "deny"  { description = "Refuse access to them" }
    }
    param "users" { description = "users: comma-separated user names; * is everyone and ?  is anonymous. Rule identity is the (access_type, users, roles, verbs) tuple" type = "string" default = "" }
    param "roles" { description = "roles: comma-separated role names" type = "string" default = "" }
    param "verbs" { description = "verbs: comma-separated HTTP verbs the rule covers; empty is all verbs" type = "string" default = "" }
  }

  // system.webServer/security/access sslFlags, the "SSL Settings" page in
  // IIS Manager. The three params are the three flag bits; IIS stores them
  // as one comma-separated attribute, which the script assembles.
  resource "ssl_settings" {
    description = "Ensure the TLS requirements for a site or path: require HTTPS, client certificate policy and 128-bit ciphers"
    script = "resources/ssl_settings.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "require_ssl" { description = "The Ssl flag: refuse plain HTTP requests with a 403.4" type = "bool" }
    param "client_certificates" {
      description = "The SslNegotiateCert and SslRequireCert flags: how a client certificate is treated"
      type = "symbol"

      symbol "ignore" { description = "Never ask for a client certificate" }
      symbol "accept" { description = "Ask for one, but serve the request without it" }
      symbol "require" { description = "Refuse the request without a valid client certificate" }
    }
    param "require_128bit" { description = "The Ssl128 flag: refuse a negotiated cipher weaker than 128 bits" type = "bool" }
  }

  resource "ip_restriction_settings" {
    description = "Ensure the IP and domain restriction policy for a site or path"
    script = "resources/ip_restriction_settings.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "allow_unlisted" { description = "allowUnlisted: serve clients that match no entry. Set it false and add allow entries for a deny-by-default posture" type = "bool" }
    param "enable_reverse_dns" { description = "enableReverseDns: resolve client addresses so domain_name entries can match; this costs a DNS lookup per request" type = "bool" }
    param "enable_proxy_mode" { description = "enableProxyMode: also match the addresses in the X-Forwarded-For header" type = "bool" }
    param "deny_action" {
      description = "denyAction: the response sent to a refused client"
      type = "symbol"

      symbol "unauthorized" { description = "401 Unauthorized" }
      symbol "forbidden"    { description = "403 Forbidden" }
      symbol "not_found"    { description = "404 Not Found, which hides the fact that the resource exists" }
      symbol "abort"        { description = "Drop the connection without a response" }
    }
  }

  resource "ip_restriction" {
    description = "Ensure an IP address, subnet or domain is allowed or denied for a site or path, or that the entry is absent"
    script = "resources/ip_restriction.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the entry is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the entry" }
      symbol "absent"  { description = "Remove the entry" }
    }
    param "ip_address" { description = "ipAddress: the client address; with subnet_mask it covers a range. Give either this or domain_name" type = "string" default = "" }
    param "subnet_mask" { description = "subnetMask: the mask applied to ip_address, such as 255.255.255.0" type = "string" default = "255.255.255.255" }
    param "domain_name" { description = "domainName: a DNS name to match; needs enable_reverse_dns on the settings resource" type = "string" default = "" }
    param "allowed" { description = "allowed: true admits the client, false refuses it" type = "bool" default = true }
  }

  resource "dynamic_ip_restriction" {
    description = "Ensure the dynamic IP restriction thresholds for a site or path"
    script = "resources/dynamic_ip_restriction.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "deny_by_concurrent_requests" { description = "denyByConcurrentRequests.enabled: block a client with too many requests in flight" type = "bool" }
    param "max_concurrent_requests" { description = "denyByConcurrentRequests.maxConcurrentRequests: the concurrency that trips the block" type = "int" }
    param "deny_by_request_rate" { description = "denyByRequestRate.enabled: block a client sending requests too fast" type = "bool" }
    param "max_requests" { description = "denyByRequestRate.maxRequests: requests allowed within request_interval" type = "int" }
    param "request_interval" { description = "denyByRequestRate.requestIntervalInMilliseconds: the window max_requests is counted over" type = "duration" }
    param "enable_logging_only_mode" { description = "enableLoggingOnlyMode: log what would be blocked without blocking it — the way to tune the thresholds safely" type = "bool" }
    param "enable_proxy_mode" { description = "enableProxyMode: also count the addresses in the X-Forwarded-For header, which is what makes this work behind a load balancer" type = "bool" }
    param "deny_action" {
      description = "denyAction: the response sent to a blocked client"
      type = "symbol"

      symbol "unauthorized" { description = "401 Unauthorized" }
      symbol "forbidden"    { description = "403 Forbidden" }
      symbol "not_found"    { description = "404 Not Found" }
      symbol "abort"        { description = "Drop the connection without a response" }
    }
  }

  resource "request_filtering" {
    description = "Ensure the request filtering limits and allowances for a site or path"
    script = "resources/request_filtering.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "allow_double_escaping" { description = "allowDoubleEscaping: accept a URL whose escape sequences decode to another escape sequence" type = "bool" }
    param "allow_high_bit_characters" { description = "allowHighBitCharacters: accept non-ASCII bytes in the URL" type = "bool" }
    param "allow_unlisted_file_extensions" { description = "fileExtensions.allowUnlisted: serve extensions no request_filtering_rule names" type = "bool" }
    param "allow_unlisted_verbs" { description = "verbs.allowUnlisted: serve verbs no request_filtering_rule names" type = "bool" }
    param "max_allowed_content_length" { description = "requestLimits.maxAllowedContentLength: request body bytes accepted" type = "int" }
    param "max_url" { description = "requestLimits.maxUrl: characters accepted in the request URL" type = "int" }
    param "max_query_string" { description = "requestLimits.maxQueryString: characters accepted in the query string" type = "int" }
    param "remove_server_header" { description = "removeServerHeader: strip the Server response header" type = "bool" }
  }

  // One resource for the five request-filtering lists, keyed by `kind`,
  // because they are the same shape: a value that is allowed or refused.
  resource "request_filtering_rule" {
    description = "Ensure a request filtering entry — a file extension, verb, hidden segment, denied URL sequence or always-allowed URL — or that it is absent"
    script = "resources/request_filtering_rule.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the entry is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the entry" }
      symbol "absent"  { description = "Remove the entry" }
    }
    param "kind" {
      description = "Which request filtering list the entry belongs to"
      type = "symbol"
      required = true

      symbol "file_extension"      { description = "fileExtensions: an extension such as .config, matched on the requested file" }
      symbol "verb"                { description = "verbs: an HTTP method such as TRACE" }
      symbol "hidden_segment"      { description = "hiddenSegments: a path segment such as bin that is never served" }
      symbol "denied_url_sequence" { description = "denyUrlSequences: a substring such as .. that no URL may contain; `allowed` does not apply" }
      symbol "always_allowed_url"  { description = "alwaysAllowedUrls: a URL served even when another rule would refuse it; `allowed` does not apply" }
    }
    param "value" { description = "The extension, verb, segment, sequence or URL" type = "string" required = true }
    param "allowed" { description = "allowed: true admits the extension or verb, false refuses it. Ignored for :hidden_segment, :denied_url_sequence and :always_allowed_url, whose presence is the whole rule" type = "bool" default = false }
  }

  // ---------------------------------------------------------------------
  // Content: documents, errors, headers, MIME types and caching
  // ---------------------------------------------------------------------

  resource "default_document" {
    description = "Ensure the default document list and whether default documents are served for a site or path"
    script = "resources/default_document.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "enabled" { description = "enabled: serve a default document when the request names a directory" type = "bool" }
    param "files" { description = "files: the document names to try, in order. Unlike most list params this REPLACES the inherited list rather than adding to it, because the order is the whole point" type = "list" }
  }

  resource "directory_browse" {
    description = "Ensure directory browsing and the columns it shows for a site or path"
    script = "resources/directory_browse.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "enabled" { description = "enabled: list a directory's contents when no default document matches. Off by default, and normally left off" type = "bool" }
    param "show_flags" { description = "showFlags: columns in the listing, from Date, Time, Size, Extension and LongDate" type = "list" }
  }

  resource "http_errors" {
    description = "Ensure the custom error policy for a site or path"
    script = "resources/http_errors.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "error_mode" {
      description = "errorMode: who sees the detailed error page"
      type = "symbol"

      symbol "detailed"            { description = "Everyone — useful while debugging, an information leak in production" }
      symbol "detailed_local_only" { description = "Only requests from the server itself; remote clients get the custom page" }
      symbol "custom"              { description = "Always the custom page" }
    }
    param "existing_response" {
      description = "existingResponse: what to do when the application already produced a response body for the error"
      type = "symbol"

      symbol "auto"         { description = "Replace it unless the application asked to keep it" }
      symbol "replace"      { description = "Always replace it with the custom page" }
      symbol "pass_through" { description = "Always keep the application's own body" }
    }
    param "default_path" { description = "defaultPath: the response used for a status with no error entry" type = "string" default = "" }
    param "default_response_mode" {
      description = "defaultResponseMode: how default_path is served"
      type = "symbol"

      symbol "file"        { description = "Return the file's contents" }
      symbol "execute_url" { description = "Execute the URL within the application, so it can be dynamic" }
      symbol "redirect"    { description = "Redirect the client to it" }
    }
  }

  resource "http_error" {
    description = "Ensure a custom error page for one status code on a site or path, or that it is absent"
    script = "resources/http_error.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the entry is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the error entry" }
      symbol "absent"  { description = "Remove it, so the status falls back to the default page" }
    }
    param "status_code" { description = "statusCode: the HTTP status the entry covers, such as 404. Entry identity is the (status_code, sub_status_code) pair" type = "int" required = true }
    param "sub_status_code" { description = "subStatusCode: the IIS substatus; -1 covers every substatus of status_code" type = "int" default = -1 }
    param "error_path" { description = "path: the file, URL or redirect target served for this status; required when present" type = "string" default = "" }
    param "response_mode" {
      description = "responseMode: how error_path is served"
      type = "symbol"
      default = :file

      symbol "file"        { description = "Return the file's contents" }
      symbol "execute_url" { description = "Execute the URL within the application, so it can be dynamic" }
      symbol "redirect"    { description = "Redirect the client to it" }
    }
    param "prefix_language_file_path" { description = "prefixLanguageFilePath: directory prefix IIS joins with the client's language before error_path" type = "string" default = "" }
  }

  resource "http_redirect" {
    description = "Ensure the HTTP redirection settings for a site or path"
    script = "resources/http_redirect.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "enabled" { description = "enabled: redirect every request to destination. This is the whole-directory redirect; URL Rewrite rules are the per-URL tool" type = "bool" }
    param "destination" { description = "destination: the URL requests are sent to" type = "string" default = "" }
    param "exact_destination" { description = "exactDestination: send every request to destination verbatim instead of appending the requested path" type = "bool" }
    param "child_only" { description = "childOnly: only redirect requests below this directory, which stops the infinite loop when destination is inside it" type = "bool" }
    param "http_response_status" {
      description = "httpResponseStatus: the redirect status returned"
      type = "symbol"

      symbol "permanent"          { description = "301 Moved Permanently" }
      symbol "found"              { description = "302 Found" }
      symbol "temporary"          { description = "307 Temporary Redirect, which preserves the request method" }
      symbol "permanent_redirect" { description = "308 Permanent Redirect, which preserves the request method" }
    }
  }

  resource "http_protocol" {
    description = "Ensure the HTTP protocol settings for a site or path"
    script = "resources/http_protocol.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "allow_keep_alive" { description = "allowKeepAlive: honour HTTP keep-alive. Turning it off costs a connection per request and breaks NTLM authentication" type = "bool" }
  }

  resource "response_header" {
    description = "Ensure a custom HTTP response header for a site or path, or that it is absent"
    script = "resources/response_header.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the header is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Send the header" }
      symbol "absent"  { description = "Stop sending it" }
    }
    param "name" { description = "Header name, such as Strict-Transport-Security. Entry identity is the name alone" type = "string" required = true }
    param "value" { description = "Header value; required when present" type = "string" default = "" }
  }

  resource "mime_map" {
    description = "Ensure a file extension maps to a MIME type for a site or path, or that the mapping is absent"
    script = "resources/mime_map.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the mapping is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the mapping. IIS refuses to serve an extension it has no MIME type for" }
      symbol "absent"  { description = "Remove it" }
    }
    param "file_extension" { description = "fileExtension: the extension including the dot, such as .webp. Mapping identity is the extension alone" type = "string" required = true }
    param "mime_type" { description = "mimeType: the Content-Type sent for the extension; required when present" type = "string" default = "" }
  }

  resource "static_content_cache" {
    description = "Ensure the client cache headers sent for static content on a site or path"
    script = "resources/static_content_cache.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "cache_control_mode" {
      description = "clientCache.cacheControlMode: which cache headers static files carry"
      type = "symbol"

      symbol "no_control"   { description = "Send no cache headers and let the client decide" }
      symbol "disable_cache" { description = "Send Cache-Control: no-cache" }
      symbol "use_max_age"  { description = "Send Cache-Control: max-age from cache_control_max_age" }
      symbol "use_expires"  { description = "Send an absolute Expires header" }
    }
    param "cache_control_max_age" { description = "clientCache.cacheControlMaxAge: the max-age sent when cache_control_mode is :use_max_age" type = "duration" }
    param "cache_control_custom" { description = "clientCache.cacheControlCustom: extra Cache-Control directives appended verbatim, such as public" type = "string" default = "" }
    param "set_e_tag" { description = "clientCache.setEtag: send an ETag for static files. Turn it off across a load-balanced farm where the tags would not agree" type = "bool" }
  }

  // ---------------------------------------------------------------------
  // Compression and output caching
  // ---------------------------------------------------------------------

  resource "url_compression" {
    description = "Ensure whether static and dynamic responses are compressed for a site or path"
    script = "resources/url_compression.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "do_static_compression" { description = "doStaticCompression: compress static responses; needs the :stat_compression role service" type = "bool" }
    param "do_dynamic_compression" { description = "doDynamicCompression: compress generated responses; needs the :dyn_compression role service, and costs CPU per request" type = "bool" }
    param "dynamic_compression_before_cache" { description = "dynamicCompressionBeforeCache: compress before the output cache stores the response, so the cached copy is already compressed" type = "bool" }
  }

  // Server-level compression: where the static cache lives and how hard IIS
  // compresses. The per-site switches are url_compression.
  resource "http_compression" {
    description = "Ensure the server-wide HTTP compression settings"
    script = "resources/http_compression.ws"
    concurrency = "global"
    param "directory" { description = "directory: where compressed copies of static files are cached" type = "string" default = "" }
    param "min_file_size_for_comp" { description = "minFileSizeForComp: bytes a response must reach before it is worth compressing" type = "int" }
    param "do_disk_space_limiting" { description = "doDiskSpaceLimiting: cap the static compression cache at max_disk_space_usage" type = "bool" }
    param "max_disk_space_usage" { description = "maxDiskSpaceUsage: megabytes the static compression cache may occupy" type = "int" }
    param "no_compression_for_proxies" { description = "noCompressionForProxies: skip compression for requests that arrived through a proxy" type = "bool" }
    param "no_compression_for_http10" { description = "noCompressionForHttp10: skip compression for HTTP/1.0 requests" type = "bool" }
    param "no_compression_for_range" { description = "noCompressionForRange: skip compression for range requests" type = "bool" }
    param "send_cache_headers" { description = "sendCacheHeaders: send cache headers on compressed responses. IIS ignores this unless cache_control_header or expires_header gives it something to send" type = "bool" }
    param "cache_control_header" { description = "cacheControlHeader: the Cache-Control value sent when send_cache_headers is on, such as max-age=86400" type = "string" default = "" }
    param "expires_header" { description = "expiresHeader: the Expires value sent when send_cache_headers is on" type = "string" default = "" }
  }

  // The compression LEVELS live on <scheme>, not on <httpCompression>: setting
  // them on the section is a schema error. Server-wide.
  resource "compression_scheme" {
    description = "Ensure a compression scheme's DLL and its static and dynamic compression levels, or that the scheme is absent"
    script = "resources/compression_scheme.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Register the scheme" }
      symbol "absent"  { description = "Unregister it" }
    }
    param "name" { description = "Content-Encoding the scheme implements, such as gzip or br. Identity is the name alone" type = "string" required = true }
    param "dll" { description = "Full path to the compression DLL, such as %Windir%\\system32\\inetsrv\\gzip.dll" type = "string" default = "" }
    param "static_compression_level" { description = "staticCompressionLevel: 0-10. Static files are compressed once and cached, so a high level is nearly free" type = "int" }
    param "dynamic_compression_level" { description = "dynamicCompressionLevel: 0-10. Every response is compressed afresh, so this trades CPU for bandwidth on each request" type = "int" }
  }

  resource "compression_mime_type" {
    description = "Ensure a MIME type is compressed or excluded from compression, or that the entry is absent"
    script = "resources/compression_mime_type.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the entry" }
      symbol "absent"  { description = "Remove it" }
    }
    param "mime_type" { description = "mimeType: the type the entry covers; wildcards such as text/* and */* are allowed. Entry identity is the (mime_type, kind) pair" type = "string" required = true }
    param "kind" {
      description = "Which compression list the entry belongs to"
      type = "symbol"
      default = :static

      symbol "static"  { description = "staticTypes: responses served from disk" }
      symbol "dynamic" { description = "dynamicTypes: responses an application generated" }
    }
    param "enabled" { description = "enabled: true compresses the type, false exempts it — which is how you exclude an already-compressed type such as image/png that a wildcard entry would otherwise catch" type = "bool" default = true }
  }

  resource "output_cache" {
    description = "Ensure whether user-mode and kernel-mode output caching are on for a site or path"
    script = "resources/output_cache.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "enabled" { description = "enabled: cache responses in the worker process" type = "bool" }
    param "enable_kernel_cache" { description = "enableKernelCache: let HTTP.sys answer cache hits without entering user mode. Much faster, but it cannot vary the response by anything the kernel does not see" type = "bool" }
  }

  resource "output_cache_profile" {
    description = "Ensure an output cache profile for a file extension on a site or path, or that it is absent"
    script = "resources/output_cache_profile.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the profile is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the profile" }
      symbol "absent"  { description = "Remove it" }
    }
    param "extension" { description = "extension: the file extension the profile covers, such as .aspx. Profile identity is the extension alone" type = "string" required = true }
    param "policy" {
      description = "policy: the user-mode caching policy"
      type = "symbol"

      symbol "dont_cache"            { description = "Do not cache in user mode" }
      symbol "cache_until_change"    { description = "Cache until the underlying file changes" }
      symbol "cache_for_time_period" { description = "Cache for `duration`" }
      symbol "disable_cache"         { description = "Disable caching for the extension, overriding an inherited profile" }
    }
    param "kernel_cache_policy" {
      description = "kernelCachePolicy: the HTTP.sys caching policy"
      type = "symbol"

      symbol "dont_cache"            { description = "Do not cache in the kernel" }
      symbol "cache_until_change"    { description = "Cache until the underlying file changes" }
      symbol "cache_for_time_period" { description = "Cache for `duration`" }
      symbol "disable_cache"         { description = "Disable kernel caching for the extension" }
    }
    param "duration" { description = "duration: how long a cached response stays valid when either policy is :cache_for_time_period" type = "duration" }
    param "location" {
      description = "location: where the response may be cached"
      type = "symbol"

      symbol "any"        { description = "Anywhere: client, proxy or server" }
      symbol "client"     { description = "The client only" }
      symbol "downstream" { description = "Any downstream cache, but not the server" }
      symbol "server"     { description = "The server only" }
      symbol "none"       { description = "Nowhere" }
      symbol "server_and_client" { description = "The server and the client, but not a shared proxy" }
    }
    param "vary_by_headers" { description = "varyByHeaders: request headers a cached entry is keyed on, such as Accept-Encoding" type = "string" default = "" }
    param "vary_by_query_string" { description = "varyByQueryString: query string parameters a cached entry is keyed on; * keys on the whole query string" type = "string" default = "" }
  }

  // ---------------------------------------------------------------------
  // Handlers, modules and the request pipeline
  // ---------------------------------------------------------------------

  resource "handler" {
    description = "Ensure a handler mapping for a site or path, or that it is absent"
    script = "resources/handler.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the handler is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the handler" }
      symbol "absent"  { description = "Remove it" }
    }
    param "name" { description = "name: a unique name for the mapping. Handler identity is the name alone" type = "string" required = true }
    param "path_pattern" { description = "path: the request path the handler claims, such as *.php; required when present" type = "string" default = "" }
    param "verb" { description = "verb: comma-separated methods the handler answers; * is all of them" type = "string" default = "*" }
    param "type" { description = "type: the managed handler's .NET type name; give this or script_processor, not both" type = "string" default = "" }
    param "modules" { description = "modules: the native module that runs the handler, such as FastCgiModule or IsapiModule" type = "string" default = "" }
    param "script_processor" { description = "scriptProcessor: the executable or DLL that runs the request, for CGI, FastCGI and ISAPI handlers" type = "string" default = "" }
    param "resource_type" {
      description = "resourceType: what the request path must resolve to before the handler runs"
      type = "symbol"

      symbol "file"           { description = "An existing file" }
      symbol "directory"      { description = "An existing directory" }
      symbol "either"         { description = "Either a file or a directory" }
      symbol "unspecified"    { description = "Anything — the handler runs without a disk check, which is what a route-based application needs" }
    }
    param "require_access" {
      description = "requireAccess: the access the handler needs, checked against handler_access"
      type = "symbol"

      symbol "none"    { description = "No access requirement" }
      symbol "read"    { description = "Read access" }
      symbol "write"   { description = "Write access" }
      symbol "script"  { description = "Script access" }
      symbol "execute" { description = "Execute access" }
    }
    param "precondition" { description = "preCondition: when the handler applies, such as integratedMode or classicMode,runtimeVersionv4.0,bitness64" type = "string" default = "" }
    param "allow_path_info" { description = "allowPathInfo: pass the trailing path info to the handler instead of treating it as part of the script name" type = "bool" }
    param "response_buffer_limit" { description = "responseBufferLimit: bytes of the handler's response IIS buffers; 0 streams it" type = "int" }
  }

  resource "handler_access" {
    description = "Ensure the access policy handlers are checked against for a site or path"
    script = "resources/handler_access.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "access_policy" { description = "accessPolicy: the access granted, from None, Read, Write, Execute, Script, Source, NoRemoteRead, NoRemoteWrite, NoRemoteExecute and NoRemoteScript. A handler whose require_access is not covered here is refused" type = "list" }
  }

  resource "module" {
    description = "Ensure a managed or native module is enabled for a site or path, or that it is removed"
    script = "resources/module.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the entry is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the module to the pipeline" }
      symbol "absent"  { description = "Remove it, which is how an inherited module is switched off for one application" }
    }
    param "name" { description = "name: the module name. Entry identity is the name alone; for a native module this must match a global_module" type = "string" required = true }
    param "type" { description = "type: the managed module's .NET type name; leave empty for a native module registered with global_module" type = "string" default = "" }
    param "precondition" { description = "preCondition: when the module loads, such as managedHandler or integratedMode" type = "string" default = "" }
  }

  resource "global_module" {
    description = "Ensure a native module is registered with the server, or that it is unregistered"
    script = "resources/global_module.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Register the module DLL with the server" }
      symbol "absent"  { description = "Unregister it" }
    }
    param "name" { description = "name: the module name the `module` resource refers to. Identity is the name alone" type = "string" required = true }
    param "image" { description = "image: full path to the module DLL; required when present" type = "string" default = "" }
    param "precondition" { description = "preCondition: when the module loads, such as bitness64" type = "string" default = "" }
  }

  resource "isapi_filter" {
    description = "Ensure an ISAPI filter is registered for a site or the server, or that it is absent"
    script = "resources/isapi_filter.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty registers the filter at the server level" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Register the filter" }
      symbol "absent"  { description = "Unregister it" }
    }
    param "name" { description = "name: the filter name. Identity is the name alone" type = "string" required = true }
    param "filter_path" { description = "path: full path to the filter DLL; required when present" type = "string" default = "" }
    param "enabled" { description = "enabled: run the filter" type = "bool" }
    param "precondition" { description = "preCondition: when the filter loads, such as bitness64" type = "string" default = "" }
    param "enable_cache" { description = "enableCache: cache the filter DLL in memory" type = "bool" }
  }

  resource "isapi_cgi_restriction" {
    description = "Ensure an ISAPI or CGI executable is allowed to run, or that the restriction entry is absent"
    script = "resources/isapi_cgi_restriction.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the entry" }
      symbol "absent"  { description = "Remove it" }
    }
    param "executable_path" { description = "path: full path to the ISAPI DLL or CGI executable. Identity is the path alone" type = "string" required = true }
    param "allowed" { description = "allowed: true lets IIS run it. An unlisted executable is refused, which is why a new FastCGI or ISAPI handler also needs an entry here" type = "bool" default = true }
    param "description" { description = "description: a label shown in IIS Manager" type = "string" default = "" }
    param "group_id" { description = "groupId: groups entries so IIS Manager can enable or disable them together" type = "string" default = "" }
  }

  // The section-level half of the ISAPI/CGI restriction list; the entries are
  // windows_iis.isapi_cgi_restriction. An unlisted executable is refused by
  // default, which is the safe posture — these relax it.
  resource "isapi_cgi_restriction_settings" {
    description = "Ensure whether unlisted ISAPI extensions and CGI executables may run"
    script = "resources/isapi_cgi_restriction_settings.ws"
    concurrency = "global"
    param "allow_unlisted_isapis" { description = "notListedIsapisAllowed: let an ISAPI extension with no restriction entry run. Off is the hardened default" type = "bool" }
    param "allow_unlisted_cgis" { description = "notListedCgisAllowed: let a CGI executable with no restriction entry run. Off is the hardened default" type = "bool" }
  }

  resource "fastcgi_application" {
    description = "Ensure a FastCGI application pool is registered, or that it is absent"
    script = "resources/fastcgi_application.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Register the FastCGI application" }
      symbol "absent"  { description = "Unregister it" }
    }
    param "full_path" { description = "fullPath: the FastCGI executable, such as C:\\PHP\\php-cgi.exe. Identity is the (full_path, arguments) pair, which is how one executable hosts several configurations" type = "string" required = true }
    param "arguments" { description = "arguments: arguments passed to the executable; part of the identity" type = "string" default = "" }
    param "max_instances" { description = "maxInstances: FastCGI processes IIS may start; 0 lets IIS size it from the CPU count" type = "int" }
    param "instance_max_requests" { description = "instanceMaxRequests: requests one process handles before it is recycled, which contains leaks in the hosted runtime" type = "int" }
    param "activity_timeout" { description = "activityTimeout: how long a process may be silent before IIS kills it" type = "duration" }
    param "request_timeout" { description = "requestTimeout: how long one request may take" type = "duration" }
    param "idle_timeout" { description = "idleTimeout: how long an idle process is kept alive" type = "duration" }
    param "queue_length" { description = "queueLength: requests queued for the application before new ones are refused" type = "int" }
    param "protocol" {
      description = "protocol: how IIS talks to the FastCGI process"
      type = "symbol"

      symbol "named_pipe" { description = "A named pipe — local, and the default" }
      symbol "tcp"        { description = "TCP, which allows a remote FastCGI host" }
    }
    param "monitor_changes_to" { description = "monitorChangesTo: a file whose modification recycles every process, such as a php.ini" type = "string" default = "" }
    param "stderr_mode" {
      description = "stderrMode: what IIS does with what the process writes to stderr"
      type = "symbol"

      symbol "return_stderr_in_500"  { description = "Return it in a 500 response — useful while debugging, an information leak in production" }
      symbol "return_generic_500"    { description = "Return a plain 500 and discard it" }
      symbol "ignore_and_return_200" { description = "Ignore it and answer 200" }
      symbol "terminate_process"     { description = "Kill the process" }
    }
    param "signal_before_terminate_seconds" { description = "signalBeforeTerminateSeconds: grace period given to a process before it is killed" type = "int" }
    param "flush_named_pipe" { description = "flushNamedPipe: flush the pipe after each request; only meaningful when protocol is :named_pipe" type = "bool" }
  }

  resource "fastcgi_environment_variable" {
    description = "Ensure an environment variable is set for a FastCGI application's processes, or absent"
    script = "resources/fastcgi_environment_variable.ws"
    concurrency = "global"
    param "full_path" { description = "fullPath of the FastCGI application the variable belongs to" type = "string" required = true }
    param "arguments" { description = "arguments of the FastCGI application; part of its identity" type = "string" default = "" }
    param "name" { description = "Environment variable name" type = "string" required = true }
    param "value" { description = "Environment variable value; required when present" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Set the variable" }
      symbol "absent"  { description = "Remove it" }
    }
  }

  resource "cgi" {
    description = "Ensure the CGI settings for a site or path"
    script = "resources/cgi.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "create_process_as_user" { description = "createProcessAsUser: run the CGI process as the authenticated user instead of the pool identity" type = "bool" }
    param "timeout" { description = "timeout: how long a CGI process may run before it is killed" type = "duration" }
    param "create_console_window" { description = "createCGIWithNewConsole: give the CGI process its own console window" type = "bool" }
  }

  resource "application_initialization" {
    description = "Ensure the application initialization settings for a site or path"
    script = "resources/application_initialization.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "do_app_init_after_restart" { description = "doAppInitAfterRestart: run the initialization pages after the worker process restarts, not only after an IIS restart" type = "bool" }
    param "remap_managed_requests_to" { description = "remapManagedRequestsTo: a page served to real clients while the application is still warming up" type = "string" default = "" }
    param "skip_managed_modules" { description = "skipManagedModules: bypass the managed pipeline for the warm-up requests" type = "bool" }
  }

  resource "application_initialization_page" {
    description = "Ensure a page is requested to warm an application up, or that the entry is absent"
    script = "resources/application_initialization_page.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the entry is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the warm-up page" }
      symbol "absent"  { description = "Remove it" }
    }
    param "init_page" { description = "initializationPage: the path IIS requests to warm the application, such as /health. Identity is the page alone" type = "string" required = true }
    param "host_name" { description = "hostName: the Host header sent with the warm-up request, for a site bound to several host names" type = "string" default = "" }
  }

  resource "websocket" {
    description = "Ensure whether the WebSocket protocol is enabled for a site or path"
    script = "resources/websocket.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "enabled" { description = "enabled: allow protocol upgrades to WebSocket; needs the :websockets role service" type = "bool" }
  }

  resource "server_runtime" {
    description = "Ensure the request-handling limits for a site or path"
    script = "resources/server_runtime.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "enabled" { description = "enabled: run the application. Setting it false takes the application offline without deleting it" type = "bool" }
    param "app_concurrent_request_limit" { description = "appConcurrentRequestLimit: requests the application may have in flight before further ones get a 503" type = "int" }
    param "frequent_hit_threshold" { description = "frequentHitThreshold: hits within frequent_hit_time_period that make a URL worth caching" type = "int" }
    param "frequent_hit_time_period" { description = "frequentHitTimePeriod: the window frequent_hit_threshold is counted over" type = "duration" }
    param "max_request_entity_allowed" { description = "maxRequestEntityAllowed: bytes of request body the server accepts for this application; 4294967295 is the default. Not to be confused with the ASP-only limit of the same name, which windows_iis.asp reaches" type = "int" }
    param "upload_read_ahead_size" { description = "uploadReadAheadSize: bytes of the request body IIS reads before handing the request to the handler. Raise it for large client-certificate or POST bodies" type = "int" }
    param "enable_nagling" { description = "enableNagling: coalesce small responses with Nagle's algorithm; off trades bandwidth for latency" type = "bool" }
    param "alternate_host_name" { description = "alternateHostName: host name substituted into the SERVER_NAME server variable" type = "string" default = "" }
    param "authenticated_user_override" {
      description = "authenticatedUserOverride: which identity the request runs as once it is authenticated"
      type = "symbol"

      symbol "use_authenticated_user"   { description = "Impersonate the authenticated user" }
      symbol "use_worker_process_user"  { description = "Stay as the application pool identity, whoever authenticated" }
    }
  }

  resource "asp" {
    description = "Ensure the classic ASP settings for a site or path"
    script = "resources/asp.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the setting is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "enable_parent_paths" { description = "enableParentPaths: allow .. in Server.MapPath and include paths. Off by default because it lets a script reach outside the application" type = "bool" }
    param "buffering_on" { description = "bufferingOn: buffer the whole response before sending it" type = "bool" }
    param "script_timeout" { description = "limits.scriptTimeout: how long a script may run" type = "duration" }
    param "script_error_sent_to_browser" { description = "scriptErrorSentToBrowser: send the script error text to the client. An information leak in production" type = "bool" }
    param "script_error_message" { description = "scriptErrorMessage: the message clients see instead" type = "string" default = "" }
    param "code_page" { description = "codePage: the code page scripts run under; 65001 is UTF-8" type = "int" }
    param "lcid" { description = "lcid: the locale identifier scripts run under" type = "int" }
    param "script_language" { description = "scriptLanguage: the default scripting language, normally VBScript" type = "string" default = "" }
    param "allow_session_state" { description = "session.allowSessionState: keep ASP session state" type = "bool" }
    param "session_timeout" { description = "session.timeout: how long an idle ASP session is kept" type = "duration" }
  }

  // ---------------------------------------------------------------------
  // Certificates
  // ---------------------------------------------------------------------

  // An https binding needs a certificate in a LocalMachine store before it
  // can name a thumbprint, so these come first in a play. They live here
  // rather than in windows_files because the store, not the filesystem, is
  // what IIS reads.

  resource "certificate" {
    description = "Ensure a PFX is imported into a LocalMachine certificate store, or that the certificate is absent"
    script = "resources/certificate.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Import the PFX if no certificate with this identity is in the store" }
      symbol "absent"  { description = "Remove the certificate from the store" }
    }
    param "store" {
      description = "The LocalMachine store the certificate lives in"
      type = "symbol"
      default = :my

      symbol "my"          { description = "LocalMachine\\My, the Personal store IIS Manager shows by default" }
      symbol "web_hosting" { description = "LocalMachine\\WebHosting, which scales to many more certificates and is the right store for shared hosting" }
    }
    param "pfx_path" { description = "Local path or HTTP(S) URL of the .pfx to import; required when present and the certificate is missing" type = "string" default = "" }
    param "password" { description = "Password protecting the .pfx; empty for an unprotected file" type = "string" default = "" }
    param "thumbprint" { description = "SHA-1 thumbprint identifying the certificate. Give this when you know it — it is the only identity that cannot match the wrong certificate" type = "string" default = "" }
    param "subject" { description = "Subject to identify the certificate by when thumbprint is empty, such as CN=www.example.com" type = "string" default = "" }
    param "exportable" { description = "Mark the private key exportable, so the certificate can be moved to another node later" type = "bool" default = false }
  }

  // Converges on "the store holds an unexpired certificate for these
  // names", not "create a certificate" — otherwise every run would mint a
  // new one and the binding would chase it.
  resource "self_signed_certificate" {
    description = "Ensure a LocalMachine store holds an unexpired self-signed certificate for the given DNS names, or that it holds none"
    script = "resources/self_signed_certificate.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Create a certificate only when no unexpired one already covers dns_names" }
      symbol "absent"  { description = "Remove the certificates covering dns_names" }
    }
    param "dns_names" { description = "DNS names the certificate covers; the first becomes the subject. Identity is this list" type = "list" required = true }
    param "store" {
      description = "The LocalMachine store the certificate is created in"
      type = "symbol"
      default = :my

      symbol "my"          { description = "LocalMachine\\My, the Personal store" }
      symbol "web_hosting" { description = "LocalMachine\\WebHosting" }
    }
    param "friendly_name" { description = "Friendly name shown in the certificate store and IIS Manager" type = "string" default = "" }
    param "valid_days" { description = "Days the certificate stays valid from creation" type = "int" default = 365 }
    param "key_length" { description = "RSA key size in bits" type = "int" default = 2048 }
    param "renew_before" { description = "Replace the certificate once it expires within this span, so a long-lived host rolls over on its own" type = "duration" default = 30d }
  }

  // The one resource in this package with no test. Enabling the provider needs
  // a UNC share plus an account that can read it, which a single disposable
  // instance cannot supply, and the credentials are write-only so there would
  // be nothing to assert afterwards either. Its shape follows
  // Enable-/Disable-WebCentralCertProvider directly; see the script's header.
  resource "central_certificate_store" {
    description = "Ensure the IIS central certificate store's enabled state, share and credentials"
    script = "resources/central_certificate_store.ws"
    concurrency = "global"
    param "enabled" { description = "Enable the central certificate provider; needs the :cert_provider role service" type = "bool" }
    param "cert_store_location" { description = "Local path or UNC share holding the .pfx files. IIS picks a certificate by matching the request's host name to the file name, so www.example.com needs www.example.com.pfx and a wildcard needs _.example.com.pfx" type = "string" default = "" }
    param "username" { description = "Account used to read the share; required for a UNC path" type = "string" default = "" }
    param "password" { description = "Password for username" type = "string" default = "" }
    param "private_key_password" { description = "Password protecting the private keys in the .pfx files; empty when they are unprotected" type = "string" default = "" }
  }

  // ---------------------------------------------------------------------
  // URL Rewrite
  // ---------------------------------------------------------------------

  // URL Rewrite is not part of the IIS role — it ships as a separate MSI —
  // so it is installed rather than assumed. Every other resource in this
  // group reports a clear error when the section is missing instead of
  // letting a raw PowerShell failure through.

  resource "rewrite_module" {
    description = "Ensure the IIS URL Rewrite module is installed, or that it is removed"
    script = "resources/rewrite_module.ws"
    concurrency = "global"
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Install the module" }
      symbol "absent"  { description = "Uninstall it" }
    }
    param "method" {
      description = "How the module is installed"
      type = "symbol"
      default = :msi

      symbol "msi"        { description = "Download `source` and run msiexec. The only method that works from a service or scheduled task, because it needs no per-user package manager — which is why the testlab uses it" }
      symbol "winget"     { description = "winget install -e --id Microsoft.IIS.URLRewrite. Needs App Installer, which is absent on Server SKUs and unavailable to the SYSTEM account" }
      symbol "chocolatey" { description = "choco install urlrewrite. Needs Chocolatey on PATH" }
    }
    param "source" { description = "MSI to install when method is :msi — a local path or an HTTP(S) URL. Defaults to Microsoft's x64 English download; point it at an internal mirror for an air-gapped build" type = "string" default = "https://download.microsoft.com/download/1/2/8/128E2E22-C1B9-44A4-BE2A-5859ED1D4592/rewrite_amd64_en-US.msi" }
  }

  // A rule's conditions are written as "input|pattern" strings — a list of
  // records is not expressible as a param type. Append "|negate" to invert
  // one: ["{HTTPS}|^OFF$", "{REQUEST_FILENAME}|-f|negate"].
  resource "rewrite_rule" {
    description = "Ensure an inbound URL Rewrite rule for a site or path, or that it is absent"
    script = "resources/rewrite_rule.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the rule is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path, which is where most rewrite rules are deployed with the application" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the rule" }
      symbol "absent"  { description = "Remove it" }
    }
    param "name" { description = "name: a unique name for the rule. Identity is the name alone" type = "string" required = true }
    param "enabled" { description = "enabled: evaluate the rule" type = "bool" }
    param "stop_processing" { description = "stopProcessing: stop evaluating later rules once this one matches" type = "bool" }
    param "pattern_syntax" {
      description = "patternSyntax: how match_url and every condition pattern in this rule are interpreted"
      type = "symbol"

      symbol "ecma_script" { description = "ECMAScript regular expressions, the default" }
      symbol "wildcard"    { description = "Wildcards, where * captures and ? matches one character" }
      symbol "exact_match" { description = "A literal string comparison" }
    }
    param "match_url" { description = "match.url: the pattern tried against the request path, without the leading slash; required when present" type = "string" default = "" }
    param "ignore_case" { description = "match.ignoreCase: match case-insensitively" type = "bool" }
    param "negate" { description = "match.negate: run the action when the URL does NOT match" type = "bool" }
    param "conditions" { description = "conditions: entries as \"input|pattern\" strings, with an optional third field of negate or a matchType of isFile, isDirectory or pattern — e.g. \"{HTTPS}|^OFF$\" or \"{REQUEST_FILENAME}||isFile,negate\"" type = "list" }
    param "conditions_logical_grouping" {
      description = "conditions.logicalGrouping: whether every condition must hold"
      type = "symbol"

      symbol "match_all" { description = "All conditions must hold" }
      symbol "match_any" { description = "Any one condition is enough" }
    }
    param "conditions_track_all_captures" { description = "conditions.trackAllCaptures: make every condition's capture groups available as back-references, not just the last one's" type = "bool" }
    param "action_type" {
      description = "action.type: what the rule does when it matches"
      type = "symbol"

      symbol "rewrite"         { description = "Serve action_url instead, without telling the client" }
      symbol "redirect"        { description = "Send the client to action_url" }
      symbol "custom_response" { description = "Answer with status_code and status_reason" }
      symbol "abort_request"   { description = "Drop the connection" }
      symbol "none"            { description = "Do nothing, which paired with stop_processing exempts a URL from the rules below it" }
    }
    param "action_url" { description = "action.url: the substitution, with back-references such as {R:1} from the match and {C:1} from the conditions" type = "string" default = "" }
    param "append_query_string" { description = "action.appendQueryString: carry the original query string onto action_url" type = "bool" }
    param "log_rewritten_url" { description = "action.logRewrittenUrl: log the rewritten URL rather than the one the client asked for" type = "bool" }
    param "redirect_type" {
      description = "action.redirectType: the status used when action_type is :redirect"
      type = "symbol"

      symbol "permanent" { description = "301 Permanent" }
      symbol "found"     { description = "302 Found" }
      symbol "see_other" { description = "303 See Other" }
      symbol "temporary" { description = "307 Temporary, which preserves the request method" }
    }
    param "status_code" { description = "action.statusCode: the status when action_type is :custom_response" type = "int" }
    param "sub_status_code" { description = "action.subStatusCode: the IIS substatus for a custom response" type = "int" }
    param "status_reason" { description = "action.statusReason: the reason phrase on the status line" type = "string" default = "" }
    param "status_description" { description = "action.statusDescription: the response body for a custom response" type = "string" default = "" }
  }

  resource "rewrite_outbound_rule" {
    description = "Ensure an outbound URL Rewrite rule that rewrites the response for a site or path, or that it is absent"
    script = "resources/rewrite_outbound_rule.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the rule is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the rule" }
      symbol "absent"  { description = "Remove it" }
    }
    param "name" { description = "name: a unique name for the rule. Identity is the name alone" type = "string" required = true }
    param "enabled" { description = "enabled: evaluate the rule" type = "bool" }
    param "stop_processing" { description = "stopProcessing: stop evaluating later outbound rules once this one matches" type = "bool" }
    param "pre_condition" { description = "preCondition: name of a rewrite_pre_condition that gates this rule. Without one the rule is evaluated against every response, which is expensive" type = "string" default = "" }
    param "match_server_variable" { description = "match.serverVariable: rewrite a response header or server variable, such as RESPONSE_Location. Give this or filter_by_tags, not both" type = "string" default = "" }
    param "filter_by_tags" { description = "match.filterByTags: HTML tags whose attributes are rewritten, such as A,Area,Base,Form,Img. Give this or match_server_variable" type = "string" default = "" }
    param "pattern" { description = "match.pattern: the pattern tried against the matched variable or tag attribute; required when present" type = "string" default = "" }
    param "pattern_syntax" {
      description = "patternSyntax: how pattern and every condition pattern in this rule are interpreted"
      type = "symbol"

      symbol "ecma_script" { description = "ECMAScript regular expressions, the default" }
      symbol "wildcard"    { description = "Wildcards" }
      symbol "exact_match" { description = "A literal string comparison" }
    }
    param "ignore_case" { description = "match.ignoreCase: match case-insensitively" type = "bool" }
    param "negate" { description = "match.negate: run the action when the value does NOT match" type = "bool" }
    param "conditions" { description = "conditions: entries as \"input|pattern\" strings, as for rewrite_rule" type = "list" }
    param "conditions_logical_grouping" {
      description = "conditions.logicalGrouping: whether every condition must hold"
      type = "symbol"

      symbol "match_all" { description = "All conditions must hold" }
      symbol "match_any" { description = "Any one condition is enough" }
    }
    param "action_value" { description = "action.value: the replacement, with back-references such as {R:1}" type = "string" default = "" }
    param "replace_server_variable" { description = "action.replace: replace the whole variable rather than only the matched part" type = "bool" }
  }

  resource "rewrite_pre_condition" {
    description = "Ensure an outbound rewrite pre-condition for a site or path, or that it is absent"
    script = "resources/rewrite_pre_condition.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the pre-condition is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the pre-condition" }
      symbol "absent"  { description = "Remove it" }
    }
    param "name" { description = "name: a unique name outbound rules refer to. Identity is the name alone" type = "string" required = true }
    param "conditions" { description = "conditions: entries as \"input|pattern\" strings, e.g. \"{RESPONSE_CONTENT_TYPE}|^text/html\" — the usual way to keep an outbound rule off images and downloads" type = "list" }
    param "logical_grouping" {
      description = "logicalGrouping: whether every condition must hold"
      type = "symbol"

      symbol "match_all" { description = "All conditions must hold" }
      symbol "match_any" { description = "Any one condition is enough" }
    }
    param "pattern_syntax" {
      description = "patternSyntax: how the condition patterns are interpreted"
      type = "symbol"

      symbol "ecma_script" { description = "ECMAScript regular expressions, the default" }
      symbol "wildcard"    { description = "Wildcards" }
      symbol "exact_match" { description = "A literal string comparison" }
    }
  }

  resource "rewrite_map" {
    description = "Ensure a rewrite map for a site or path, or that it is absent"
    script = "resources/rewrite_map.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the map is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the map" }
      symbol "absent"  { description = "Remove it and its entries" }
    }
    param "name" { description = "name: the map name rules look up with {name:{R:1}}. Identity is the name alone" type = "string" required = true }
    param "default_value" { description = "defaultValue: what a lookup returns when the key is not in the map; empty is the usual choice so a rule can test for a miss" type = "string" default = "" }
    param "ignore_case" { description = "ignoreCase: look keys up case-insensitively" type = "bool" }
  }

  resource "rewrite_map_entry" {
    description = "Ensure a key maps to a value in a rewrite map, or that the entry is absent"
    script = "resources/rewrite_map_entry.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the entry is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the entry" }
      symbol "absent"  { description = "Remove it" }
    }
    param "map" { description = "Name of the rewrite_map the entry belongs to" type = "string" required = true }
    param "key" { description = "key: the lookup key. Entry identity is the (map, key) pair" type = "string" required = true }
    param "value" { description = "value: what the key maps to; required when present" type = "string" default = "" }
  }

  resource "rewrite_allowed_server_variable" {
    description = "Ensure a server variable may be set by rewrite rules, or that it is not"
    script = "resources/rewrite_allowed_server_variable.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty configures the server-level default" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Allow rules to set the variable" }
      symbol "absent"  { description = "Disallow it" }
    }
    param "name" { description = "The server variable, such as HTTP_X_FORWARDED_PROTO. A rule that sets a variable not on this list fails at request time. The list is always read from applicationHost.config, never web.config — that is the point of it" type = "string" required = true }
  }

  // ---------------------------------------------------------------------
  // Delegation and the untyped escape hatches
  // ---------------------------------------------------------------------

  // IIS's schema is far larger than the resources above. These three reach
  // whatever is not modelled, the way git.config_entry reaches the ~995
  // git config variables the typed section resources do not name.

  resource "section_delegation" {
    description = "Ensure a configuration section's delegation, so a site's web.config may or may not override it"
    script = "resources/section_delegation.ws"
    concurrency = "global"
    param "section_path" { description = "Section to delegate, such as system.webServer/security/authentication/windowsAuthentication" type = "string" required = true }
    param "override_mode" {
      description = "overrideMode: whether a lower-level web.config may set the section"
      type = "symbol"
      default = :allow

      symbol "allow"   { description = "Unlock the section, so web.config files may set it" }
      symbol "deny"    { description = "Lock it, so only applicationHost.config may set it" }
      symbol "inherit" { description = "Clear the explicit setting and take the parent's" }
    }
    param "location" { description = "Site or path the delegation applies to; empty is the server-wide default" type = "string" default = "" }
  }

  resource "config_property" {
    description = "Ensure any IIS configuration attribute has a value — the escape hatch for what this package does not model"
    script = "resources/config_property.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty is the server level" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the attribute is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "filter" { description = "The section or element the attribute lives on, such as system.webServer/asp or system.applicationHost/sites/siteDefaults/logFile" type = "string" required = true }
    param "name" { description = "Attribute name; dotted names reach a child element, such as processModel.identityType" type = "string" required = true }
    param "value" { description = "The value to set, written as text. Durations are IIS's own \"HH:MM:SS\" spelling" type = "string" required = true }
    param "value_type" {
      description = "How `value` is converted before it is written; IIS's schema rejects a string where it wants a number or a flag"
      type = "symbol"
      default = :string

      symbol "string" { description = "Write it as text" }
      symbol "int"    { description = "Parse it as an integer first" }
      symbol "bool"   { description = "Parse true/false first" }
    }
  }

  resource "config_collection_element" {
    description = "Ensure an element with the given keys and attributes is in an IIS configuration collection, or is absent"
    script = "resources/config_collection_element.ws"
    concurrency = "global"
    param "site" { description = "Site name; empty is the server level" type = "string" default = "" }
    param "path" { description = "Application or virtual path under the site" type = "string" default = "" }
    param "store" {
      description = "Which configuration file the element is written to"
      type = "symbol"
      default = :apphost

      symbol "apphost"    { description = "applicationHost.config, under a <location> for site and path" }
      symbol "web_config" { description = "The web.config at site and path" }
    }
    param "ensure" {
      description = "Desired state: :present or :absent"
      type = "symbol"
      default = :present

      symbol "present" { description = "Add the element, or update its non-key attributes when it already exists" }
      symbol "absent"  { description = "Remove the element matching `keys`" }
    }
    param "filter" { description = "The section holding the collection, such as system.webServer/httpProtocol" type = "string" required = true }
    param "collection_name" { description = "The collection under `filter`, such as customHeaders; empty when the section IS the collection, as system.webServer/handlers is" type = "string" default = "" }
    param "keys" { description = "Attributes that identify the element, as a name-to-value map. An element matching all of them is the one this resource owns" type = "map" required = true }
    param "attributes" { description = "Further attributes set on the element, as a name-to-value map" type = "map" }
  }

  // ---------------------------------------------------------------------
  // Gatherers
  // ---------------------------------------------------------------------

  gatherer "iis_info" {
    description = "Whether IIS is installed, its version, and how many sites and pools it has"
    script = "gatherers/iis_info.ws"
    returns "installed" { description = "Whether the IIS role is installed and the WebAdministration module is usable" type = "bool" }
    returns "version" { description = "IIS version from HKLM\\SOFTWARE\\Microsoft\\InetStp, e.g. 10.0; empty when not installed" type = "string" }
    returns "rewrite_installed" { description = "Whether the URL Rewrite module is installed" type = "bool" }
    returns "site_count" { description = "Number of configured sites" type = "int" }
    returns "app_pool_count" { description = "Number of configured application pools" type = "int" }
  }

  gatherer "sites" {
    description = "Every configured site with its state, root path, pool and bindings"
    script = "gatherers/sites.ws"
    returns "sites" { description = "One { name, id, state, physical_path, app_pool, bindings } map per site, each binding a { protocol, binding_information, ssl_flags, certificate_hash } map; empty without IIS" type = "list" }
  }

  gatherer "app_pools" {
    description = "Every application pool with its runtime, pipeline mode, identity and state"
    script = "gatherers/app_pools.ws"
    returns "app_pools" { description = "One { name, state, managed_runtime_version, managed_pipeline_mode, identity_type, enable_32bit } map per pool; empty without IIS" type = "list" }
  }

  // ---------------------------------------------------------------------
  // Tests
  // ---------------------------------------------------------------------

  // All four share one Windows VM through `group`, and they share its state
  // with no reset between them: iis_install puts the role on the machine and
  // the other three build on it. That ordering is why the tests are declared
  // in this order and why none of them re-asserts what an earlier one did —
  // run 1 of every test is a check of ALL its steps before any of them
  // applies, so an "already_configured" step can only assert state that some
  // EARLIER test (or the stock image) established, never state a sibling step
  // in the same test is about to create.
  //
  // The verify scripts drive curl.exe, which ships in System32 on Server
  // 2019 and later, rather than the http module: ureq treats a 4xx as an
  // error, and the security test's whole point is observing a 401.

  test "iis_install" {
    description = "The IIS role and the role services this package needs install and converge"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    memory = "4GiB"
    verify = "tests/iis_install_verify.ws"

    step "web_server" {
      description = "Install the Web Server (IIS) role with its management tools"
      resource = "feature"
      properties { name = :web_server include_management_tools = true }
    }

    // Every other resource in this package shells out to the
    // WebAdministration module, which is Web-Scripting-Tools —
    // -IncludeManagementTools on Web-Server brings only the console.
    step "scripting_tools" {
      description = "Install the IIS management scripts and the WebAdministration PowerShell module"
      resource = "feature"
      requires = ["web_server"]
      properties { name = :scripting_tools }
    }

    step "windows_auth" {
      description = "Install Windows authentication"
      resource = "feature"
      requires = ["web_server"]
      properties { name = :windows_auth }
    }

    step "basic_auth" {
      description = "Install Basic authentication"
      resource = "feature"
      requires = ["web_server"]
      properties { name = :basic_auth }
    }

    step "url_auth" {
      description = "Install URL authorization"
      resource = "feature"
      requires = ["web_server"]
      properties { name = :url_auth }
    }

    step "ip_security" {
      description = "Install IP and domain restrictions"
      resource = "feature"
      requires = ["web_server"]
      properties { name = :ip_security }
    }

    step "dyn_compression" {
      description = "Install dynamic content compression"
      resource = "feature"
      requires = ["web_server"]
      properties { name = :dyn_compression }
    }

    step "http_redirect" {
      description = "Install HTTP redirection"
      resource = "feature"
      requires = ["web_server"]
      properties { name = :http_redirect }
    }

    step "websockets" {
      description = "Install the WebSocket protocol"
      resource = "feature"
      requires = ["web_server"]
      properties { name = :websockets }
    }
  }

  test "iis_site_converges" {
    description = "An application pool, site, binding, application, virtual directory and the content settings converge, and the site serves"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    memory = "4GiB"
    // cmd /C runs this: no inner double quotes and no pipes. `echo x>f`
    // rather than `echo x > f`, which would write a trailing space.
    setup = "mkdir C:\\weave-iis\\www\\new && mkdir C:\\weave-iis\\static && echo weave-iis-ok>C:\\weave-iis\\www\\index.html && echo weave-rewritten>C:\\weave-iis\\www\\new\\index.html && echo weave-static-ok>C:\\weave-iis\\static\\index.html"
    verify = "tests/iis_site_verify.ws"

    // Web-Static-Content is one of the sub-features the Web-Server role
    // pulls in, so by the time this test runs iis_install has already
    // provided it. This is the detection-path assertion the install test
    // could not make about itself.
    step "static_content_present" {
      description = "The Web Server role brought static content serving with it"
      resource = "feature"
      expect = "already_configured"
      properties { name = :static_content }
    }

    step "pool" {
      description = "An application pool with no managed runtime, for static content"
      resource = "app_pool"
      properties {
        name = "weave-pool"
        managed_runtime_version = :none
        managed_pipeline_mode = :integrated
        start_mode = :always_running
        queue_length = 2000
        identity_type = :application_pool_identity
        idle_timeout = 0min
      }
    }

    step "pool_recycling" {
      description = "Recycle the pool nightly and on a private-memory ceiling"
      resource = "app_pool_recycling"
      requires = ["pool"]
      properties {
        pool = "weave-pool"
        disallow_overlapping_rotation = false
        periodic_restart_private_memory = 524288
        periodic_restart_time = 0min
        schedule = ["03:00:00"]
      }
    }

    step "pool_failure" {
      description = "Rapid-fail protection on the pool"
      resource = "app_pool_failure"
      requires = ["pool"]
      properties {
        pool = "weave-pool"
        rapid_fail_protection = true
        rapid_fail_protection_max_crashes = 10
        rapid_fail_protection_interval = 10min
        load_balancer_capabilities = :tcp_level
      }
    }

    step "pool_cpu" {
      description = "Throttle the pool at 80% CPU"
      resource = "app_pool_cpu"
      requires = ["pool"]
      properties {
        pool = "weave-pool"
        limit = 80000
        action = :throttle_under_load
        reset_interval = 5min
      }
    }

    step "pool_env" {
      description = "An environment variable for the pool's worker processes"
      resource = "app_pool_environment_variable"
      requires = ["pool"]
      properties { pool = "weave-pool" name = "WEAVE_ENV" value = "testlab" }
    }

    // The site is created without a binding — IIS is happy with that, and
    // it is what lets `binding` own the bindings — so it cannot be started
    // until the binding exists. Hence the separate start_site step below
    // rather than state = :started here.
    step "site" {
      description = "A site rooted at C:\\weave-iis\\www"
      resource = "site"
      requires = ["pool"]
      properties {
        name = "weave-site"
        physical_path = "C:\\weave-iis\\www"
        app_pool = "weave-pool"
        server_auto_start = true
      }
    }

    step "binding" {
      description = "An HTTP binding on port 8080"
      resource = "binding"
      requires = ["site"]
      properties { site = "weave-site" protocol = :http port = 8080 }
    }

    step "certificate" {
      description = "A self-signed certificate for the site's TLS binding"
      resource = "self_signed_certificate"
      properties {
        dns_names = ["weave.local", "localhost"]
        friendly_name = "config-weave testlab"
        store = :my
      }
    }

    step "https_binding" {
      description = "An HTTPS binding on port 8443 using that certificate"
      resource = "binding"
      requires = ["site", "certificate"]
      properties {
        site = "weave-site"
        protocol = :https
        port = 8443
        certificate_subject = "CN=weave.local"
        certificate_store = "My"
      }
    }

    // No step starts the site: serverAutoStart plus a binding is enough, and
    // asking for :started here would assert a converge that never happens.
    // windows_iis:iis_security_converges asserts the state instead.
    step "application" {
      description = "An application at /app in its own pool"
      resource = "application"
      requires = ["site"]
      properties {
        site = "weave-site"
        path = "/app"
        physical_path = "C:\\weave-iis\\www"
        app_pool = "weave-pool"
      }
    }

    step "virtual_directory" {
      description = "A virtual directory at /static under the root application"
      resource = "virtual_directory"
      requires = ["site"]
      properties {
        site = "weave-site"
        path = "/static"
        physical_path = "C:\\weave-iis\\static"
      }
    }

    step "limits" {
      description = "Connection limits on the site"
      resource = "site_limits"
      requires = ["site"]
      properties {
        site = "weave-site"
        max_connections = 5000
        connection_timeout = 2min
      }
    }

    step "logging" {
      description = "W3C logging with a daily rollover"
      resource = "site_logging"
      requires = ["site"]
      properties {
        site = "weave-site"
        enabled = true
        format = :w3c
        period = :daily
        directory = "C:\\weave-iis\\logs"
        log_ext_file_flags = ["Date", "Time", "ClientIP", "Method", "UriStem", "HttpStatus", "TimeTaken"]
      }
    }

    step "default_document" {
      description = "Serve index.html for a directory request"
      resource = "default_document"
      requires = ["site"]
      properties { site = "weave-site" enabled = true files = ["index.html"] }
    }

    step "mime_map" {
      description = "Map .weave to text/plain so the extension is servable"
      resource = "mime_map"
      requires = ["site"]
      properties { site = "weave-site" file_extension = ".weave" mime_type = "text/plain" }
    }

    step "response_header" {
      description = "A custom response header on the site"
      resource = "response_header"
      requires = ["site"]
      properties { site = "weave-site" name = "X-Weave" value = "iis" }
    }

    step "static_cache" {
      description = "Cache static content for an hour"
      resource = "static_content_cache"
      requires = ["site"]
      properties {
        site = "weave-site"
        cache_control_mode = :use_max_age
        cache_control_max_age = 1h
      }
    }

    // Installing the :dyn_compression role service already turns dynamic
    // compression on, so the two switches alone would be a no-op — compressing
    // before the output cache stores the response is the real change here.
    step "compression" {
      description = "Compress static and dynamic responses, before they are cached"
      resource = "url_compression"
      requires = ["site"]
      properties {
        site = "weave-site"
        do_static_compression = true
        do_dynamic_compression = true
        dynamic_compression_before_cache = true
      }
    }

    // webSocket ships enabled, so turning it OFF is what a converge looks
    // like for this section.
    step "websocket" {
      description = "Turn the WebSocket protocol off for this site"
      resource = "websocket"
      requires = ["site"]
      properties { site = "weave-site" enabled = false }
    }

    // 451 rather than 404: IIS ships an entry for 404 at the server level, and
    // overriding an entry the location merely inherits is untested — the
    // failure that first prompted this choice turned out to be an unrelated
    // read bug, so the inherited-override path is simply unproven, not known
    // broken. 451 has no default entry, so this covers the plain add.
    step "http_error" {
      description = "A custom page for 451"
      resource = "http_error"
      requires = ["site"]
      properties {
        site = "weave-site"
        status_code = 451
        error_path = "C:\\weave-iis\\www\\index.html"
        response_mode = :file
      }
    }

    // The escape hatches, on settings the typed resources above do not
    // reach: an ASP attribute and a second custom header.
    step "config_property" {
      description = "Set an unmodelled attribute through the generic property resource"
      resource = "config_property"
      requires = ["site"]
      properties {
        site = "weave-site"
        filter = "system.webServer/asp"
        name = "enableParentPaths"
        value = "true"
        value_type = :bool
      }
    }

    step "config_collection_element" {
      description = "Add a response header through the generic collection resource"
      resource = "config_collection_element"
      requires = ["site"]
      properties {
        site = "weave-site"
        filter = "system.webServer/httpProtocol"
        collection_name = "customHeaders"
        keys = { name: "X-Weave-Generic" }
        attributes = { value: "yes" }
      }
    }

    step "ghost_site_absent" {
      description = "A never-created site with ensure = absent is already configured"
      resource = "site"
      expect = "already_configured"
      properties { name = "weave-ghost-site" ensure = :absent }
    }

    step "ghost_pool_absent" {
      description = "A never-created application pool with ensure = absent is already configured"
      resource = "app_pool"
      expect = "already_configured"
      properties { name = "weave-ghost-pool" ensure = :absent }
    }
  }

  test "iis_security_converges" {
    description = "Authentication, authorization, TLS settings and request restrictions converge, and an unauthenticated request is refused"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    memory = "4GiB"
    setup = "mkdir C:\\weave-iis\\secure && echo weave-secure-ok>C:\\weave-iis\\secure\\index.html"
    verify = "tests/iis_security_verify.ws"

    // Everything here is scoped to /secure so the site root stays open —
    // iis_rewrite_converges runs next in this VM and needs to fetch it.
    step "secure_app" {
      description = "An application at /secure to lock down"
      resource = "application"
      properties {
        site = "weave-site"
        path = "/secure"
        physical_path = "C:\\weave-iis\\secure"
        app_pool = "weave-pool"
      }
    }

    step "unlock_windows_auth" {
      description = "Delegate the Windows authentication section so a web.config could set it"
      resource = "section_delegation"
      properties {
        section_path = "system.webServer/security/authentication/windowsAuthentication"
        override_mode = :allow
      }
    }

    step "anonymous_off" {
      description = "Refuse unauthenticated requests to /secure"
      resource = "anonymous_authentication"
      requires = ["secure_app"]
      properties { site = "weave-site" path = "/secure" enabled = false }
    }

    step "windows_auth" {
      description = "Offer Negotiate and NTLM on /secure"
      resource = "windows_authentication"
      requires = ["secure_app"]
      properties {
        site = "weave-site"
        path = "/secure"
        enabled = true
        providers = ["Negotiate", "NTLM"]
        use_kernel_mode = true
      }
    }

    step "basic_auth" {
      description = "Also offer Basic authentication with a realm"
      resource = "basic_authentication"
      requires = ["secure_app"]
      properties {
        site = "weave-site"
        path = "/secure"
        enabled = true
        realm = "weave"
        default_logon_domain = "weave"
      }
    }

    // Not allow/* : that rule is inherited from the server level, so this
    // would exercise the untested inherited-override path (see the note on
    // http_error). Denying a named group adds an entry this level owns.
    step "authorization" {
      description = "Refuse the Guests group access to /secure"
      resource = "authorization_rule"
      requires = ["secure_app"]
      properties {
        site = "weave-site"
        path = "/secure"
        access_type = :deny
        roles = "Guests"
      }
    }

    // Not require_ssl: that would answer 403.4 rather than the 401 the
    // verify script is looking for, and this path has no TLS binding.
    step "ssl_settings" {
      description = "Accept a client certificate when one is offered"
      resource = "ssl_settings"
      requires = ["secure_app"]
      properties {
        site = "weave-site"
        path = "/secure"
        client_certificates = :accept
      }
    }

    step "ip_settings" {
      description = "Match forwarded client addresses and answer refusals with a 403"
      resource = "ip_restriction_settings"
      requires = ["secure_app"]
      properties {
        site = "weave-site"
        path = "/secure"
        enable_proxy_mode = true
        deny_action = :forbidden
      }
    }

    step "ip_allow_loopback" {
      description = "An explicit allow entry for the loopback address"
      resource = "ip_restriction"
      requires = ["ip_settings"]
      properties {
        site = "weave-site"
        path = "/secure"
        ip_address = "127.0.0.1"
        allowed = true
      }
    }

    step "request_filtering" {
      description = "Raise the query string limit and strip the Server header"
      resource = "request_filtering"
      requires = ["secure_app"]
      properties {
        site = "weave-site"
        path = "/secure"
        max_query_string = 4096
        remove_server_header = true
      }
    }

    step "deny_extension" {
      description = "Refuse requests for .weave files under /secure"
      resource = "request_filtering_rule"
      requires = ["secure_app"]
      properties {
        site = "weave-site"
        path = "/secure"
        kind = :file_extension
        value = ".weave"
        allowed = false
      }
    }

    step "hidden_segment" {
      description = "Never serve anything under a bin segment"
      resource = "request_filtering_rule"
      requires = ["secure_app"]
      properties {
        site = "weave-site"
        path = "/secure"
        kind = :hidden_segment
        value = "weave-private"
      }
    }

    step "site_running" {
      description = "The site started itself once it had a binding"
      resource = "site"
      expect = "already_configured"
      properties { name = "weave-site" state = :started }
    }

    step "directory_browse_off" {
      description = "Directory browsing is off, as it is on a stock IIS"
      resource = "directory_browse"
      expect = "already_configured"
      properties { site = "weave-site" enabled = false }
    }

    step "ghost_header_absent" {
      description = "A response header that was never added is already absent"
      resource = "response_header"
      expect = "already_configured"
      properties { site = "weave-site" name = "X-Weave-Ghost" ensure = :absent }
    }
  }

  // URL Rewrite is not part of the IIS role, so this test downloads and
  // installs the ~7 MB MSI in the guest. That is already the norm here: the
  // windows_installers test pulls the 7-Zip MSI, windows_packages
  // bootstraps Chocolatey, and the mssql win_install scenario fetches
  // sqlcmd, all over the same NAT'd connection.
  //
  // Every rule step `requires` the module, because a check runs before any
  // apply: without the ordering the rules would be checked against a
  // machine that has no rewrite section yet.
  test "iis_rewrite_converges" {
    description = "The URL Rewrite module installs, and inbound, outbound and map rules converge and take effect"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    memory = "4GiB"
    verify = "tests/iis_rewrite_verify.ws"

    step "rewrite_module" {
      description = "Download and install the IIS URL Rewrite module"
      resource = "rewrite_module"
      properties { ensure = :present method = :msi }
    }

    step "allowed_server_variable" {
      description = "Let rules set a custom server variable"
      resource = "rewrite_allowed_server_variable"
      requires = ["rewrite_module"]
      properties { site = "weave-site" name = "HTTP_X_WEAVE" }
    }

    step "map" {
      description = "A rewrite map rules can look names up in"
      resource = "rewrite_map"
      requires = ["rewrite_module"]
      properties { site = "weave-site" name = "weave-map" default_value = "" }
    }

    step "map_entry" {
      description = "An entry in that map"
      resource = "rewrite_map_entry"
      requires = ["map"]
      properties { site = "weave-site" map = "weave-map" key = "alpha" value = "beta" }
    }

    step "rewrite_rule" {
      description = "Serve /new/<x> for a request to /old/<x> without telling the client"
      resource = "rewrite_rule"
      requires = ["rewrite_module"]
      properties {
        site = "weave-site"
        name = "weave-rewrite"
        match_url = "^old/(.*)"
        action_type = :rewrite
        action_url = "new/{R:1}"
        stop_processing = true
        enabled = true
      }
    }

    step "redirect_rule" {
      description = "Redirect /gone/<x> to /new/<x> permanently"
      resource = "rewrite_rule"
      requires = ["rewrite_module"]
      properties {
        site = "weave-site"
        name = "weave-redirect"
        match_url = "^gone/(.*)"
        action_type = :redirect
        action_url = "/new/{R:1}"
        redirect_type = :permanent
        stop_processing = true
        enabled = true
      }
    }

    step "https_only_rule" {
      description = "A conditional rule, to prove conditions round-trip"
      resource = "rewrite_rule"
      requires = ["rewrite_module"]
      properties {
        site = "weave-site"
        name = "weave-conditional"
        match_url = "^secure-only/(.*)"
        conditions = ["{HTTPS}|^ON$"]
        conditions_logical_grouping = :match_all
        action_type = :rewrite
        action_url = "new/{R:1}"
        enabled = true
      }
    }

    step "pre_condition" {
      description = "Restrict the outbound rule to HTML responses"
      resource = "rewrite_pre_condition"
      requires = ["rewrite_module"]
      properties {
        site = "weave-site"
        name = "weave-html"
        conditions = ["{RESPONSE_CONTENT_TYPE}|^text/html"]
        logical_grouping = :match_all
      }
    }

    step "outbound_rule" {
      description = "Rewrite links in the response body"
      resource = "rewrite_outbound_rule"
      requires = ["pre_condition"]
      properties {
        site = "weave-site"
        name = "weave-outbound"
        pre_condition = "weave-html"
        filter_by_tags = "A"
        pattern = "^http://old\\.example\\.com/(.*)"
        action_value = "http://new.example.com/{R:1}"
        enabled = true
      }
    }

    step "ghost_rule_absent" {
      description = "A rule that was never created is already absent"
      resource = "rewrite_rule"
      requires = ["rewrite_module"]
      expect = "already_configured"
      properties { site = "weave-site" name = "weave-ghost-rule" ensure = :absent }
    }
  }

  // The request pipeline: handler mappings, pipeline modules, ISAPI, CGI,
  // FastCGI, classic ASP, the request-handling limits and application
  // warm-up — the sections the three tests above deliberately left alone.
  //
  // The role services those sections need (:cgi, :isapi_ext, :isapi_filter,
  // :asp, :app_init) are NOT part of the Web-Server role, so this test
  // installs them itself and every step that writes a section one of them
  // owns `requires` the matching feature step. Run 1 checks every step before
  // any of them applies, so the ordering is what stops a section being
  // written on a machine whose schema does not declare it yet — the checks
  // themselves survive it, because a section read that throws is caught and
  // reported as drift, which on a first run is the truth.
  //
  // Everything scoped to a location is scoped to a new /pipeline application
  // rather than to the site root or to /app. Two reasons: this test shares
  // the VM with the three before it and the URLs their verify scripts fetch
  // have to keep working, and applicationInitialization and serverRuntime are
  // only definable down to an application, not to an arbitrary path.
  test "iis_pipeline_converges" {
    description = "Handler mappings, pipeline modules, ISAPI, CGI, FastCGI, classic ASP, the request-handling limits and application warm-up converge, and a handler the access policy refuses answers 403"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    memory = "4GiB"
    // cmd /C runs this: no inner double quotes and no pipes. `echo x>f`
    // rather than `echo x > f`, which would write a trailing space.
    setup = "mkdir C:\\weave-iis\\pipeline && echo weave-pipeline-ok>C:\\weave-iis\\pipeline\\index.html"
    verify = "tests/iis_pipeline_verify.ws"

    // The detection path, on state the stock image already has rather than on
    // anything a sibling step is about to create: a fresh
    // applicationHost.config writes <handlers accessPolicy="Read, Script"> at
    // the server level. The flags comparison is set-based and
    // case-insensitive, so the order and spacing IIS reports back do not
    // matter. It is also the baseline the /pipeline policy below narrows.
    step "server_handler_access_default" {
      description = "The server-level handler access policy is the stock Read, Script"
      resource = "handler_access"
      expect = "already_configured"
      properties { access_policy = ["Read", "Script"] }
    }

    // ---------------------------------------------------------------
    // The role services this test needs
    // ---------------------------------------------------------------

    // Web-CGI brings both CgiModule (cgi.dll) and FastCgiModule
    // (iisfcgi.dll), which is why one feature step covers the cgi section,
    // the fastCgi section and the handler below.
    step "feature_cgi" {
      description = "Install CGI, which also brings the FastCGI module"
      resource = "feature"
      properties { name = :cgi }
    }

    step "feature_isapi_ext" {
      description = "Install ISAPI extensions, which is what runs an ISAPI DLL or a CGI executable"
      resource = "feature"
      properties { name = :isapi_ext }
    }

    step "feature_isapi_filter" {
      description = "Install ISAPI filters"
      resource = "feature"
      properties { name = :isapi_filter }
    }

    // Web-ASP depends on Web-ISAPI-Ext, so Install-WindowsFeature pulls that
    // in as well. Harmless: the isapi_ext step's own apply is idempotent and
    // its re-check passes whichever of the two applied first.
    step "feature_asp" {
      description = "Install classic ASP, which owns the system.webServer/asp section"
      resource = "feature"
      properties { name = :asp }
    }

    step "feature_app_init" {
      description = "Install Application Initialization, which owns the applicationInitialization section"
      resource = "feature"
      properties { name = :app_init }
    }

    // ---------------------------------------------------------------
    // The application every per-location setting below is scoped to
    // ---------------------------------------------------------------

    // Deliberately minimal: `application` is already covered by
    // iis_site_converges, and this one is only here to give the pipeline
    // settings a location of their own that is an application. In particular
    // preload_enabled is left alone — it would make the warm-up steps below
    // fire a real request, but it is an untested attribute of a resource this
    // test is not about, and a read-back mismatch there would fail a step
    // that covers nothing new.
    step "pipeline_app" {
      description = "An application at /pipeline to hang the pipeline configuration on"
      resource = "application"
      requires = ["feature_app_init"]
      properties {
        site = "weave-site"
        path = "/pipeline"
        physical_path = "C:\\weave-iis\\pipeline"
        app_pool = "weave-pool"
      }
    }

    // ---------------------------------------------------------------
    // Handlers, the access policy they are checked against, and modules
    // ---------------------------------------------------------------

    // Read alone, narrowing the inherited "Read, Script": static content
    // needs nothing more (requireAccess="Read" on the StaticFile mapping, and
    // "None" on the TRACE and OPTIONS ones), so /pipeline keeps serving its
    // index document, while the CGI handler below — which asks for Execute —
    // is refused. That refusal is the one thing in this test a live request
    // can prove, which is why the policy is narrowed rather than widened.
    step "handler_access" {
      description = "Grant Read only to /pipeline, so a handler asking for Execute is refused"
      resource = "handler_access"
      requires = ["pipeline_app"]
      properties {
        site = "weave-site"
        path = "/pipeline"
        access_policy = ["Read"]
      }
    }

    // The shape IIS itself uses for its CGI-exe mapping: CgiModule, plus a
    // scriptProcessor and requireAccess = Execute. The processor does not
    // exist and never runs — accessPolicy is checked while the handler is
    // being resolved, before the module is invoked — which is exactly why
    // this is safe to assert over HTTP on a machine with no CGI program on
    // it. resource_type = :unspecified so the mapping claims the path whether
    // or not a file is there.
    step "handler" {
      description = "A CGI handler mapping for *.weave-cgi under /pipeline"
      resource = "handler"
      requires = ["pipeline_app", "feature_cgi", "handler_access"]
      properties {
        site = "weave-site"
        path = "/pipeline"
        name = "weave-cgi"
        path_pattern = "*.weave-cgi"
        verb = "GET,HEAD"
        modules = "CgiModule"
        script_processor = "C:\\weave-iis\\fcgi\\weave-fcgi.exe"
        resource_type = :unspecified
        require_access = :execute
        allow_path_info = false
        response_buffer_limit = 0
      }
    }

    // A managed module entry, not a native one: weave-pool runs with no
    // managed runtime, so with preCondition = managedHandler this entry is
    // never loaded by anything — the point is that the collection entry
    // converges. A native entry would have to name a global_module, and the
    // one registered below is deliberately gated so that it never loads
    // either.
    step "module" {
      description = "A managed module in the /pipeline pipeline"
      resource = "module"
      requires = ["pipeline_app"]
      properties {
        site = "weave-site"
        path = "/pipeline"
        name = "WeaveSessionState"
        type = "System.Web.SessionState.SessionStateModule"
        precondition = "managedHandler"
      }
    }

    // globalModules entries are loaded by EVERY worker process, whether or
    // not a <modules> entry refers to them, so a registration pointing at
    // something that is not a module would take the whole server down and
    // with it the URLs the earlier tests' verify scripts fetch. Two things
    // make this safe: the image is a real IIS native module DLL
    // (StaticFileModule's, already on disk because Web-Static-Content is
    // installed), and preCondition = bitness32 keeps it out of the 64-bit
    // worker processes this machine runs — the same gate applicationHost.config
    // uses for ManagedEngineV4.0_32bit. The path is written out rather than
    // spelled %windir% so that what is read back is what was written.
    step "global_module" {
      description = "Register a native module with the server, gated so no worker loads it"
      resource = "global_module"
      properties {
        name = "WeaveGlobalModule"
        image = "C:\\Windows\\System32\\inetsrv\\static.dll"
        precondition = "bitness32"
      }
    }

    // ---------------------------------------------------------------
    // ISAPI, CGI and FastCGI
    // ---------------------------------------------------------------

    // Server level rather than under the site: isapiFilters is
    // allowDefinition = MachineToWebRoot, and writing it at the server level
    // is the spelling that is unambiguously legal. Safe to leave server-wide
    // because of the same bitness32 gate as the global module — and
    // aspnet_filter.dll under the 32-bit Framework directory is a genuine
    // ISAPI filter carrying exactly that preCondition in a stock
    // applicationHost.config.
    step "isapi_filter" {
      description = "Register an ISAPI filter, gated to 32-bit workers"
      resource = "isapi_filter"
      requires = ["feature_isapi_filter"]
      properties {
        name = "weave-isapi-filter"
        filter_path = "C:\\Windows\\Microsoft.NET\\Framework\\v4.0.30319\\aspnet_filter.dll"
        enabled = true
        precondition = "bitness32"
        enable_cache = true
      }
    }

    // The restriction entry the FastCGI executable below would need before
    // IIS would run it. An unlisted executable answers 404.2, but so does one
    // listed with allowed = false, so nothing over the wire can tell the two
    // apart — the entry's own check() is the assertion.
    step "isapi_cgi_restriction" {
      description = "Allow the FastCGI executable to be run at all"
      resource = "isapi_cgi_restriction"
      requires = ["feature_cgi"]
      properties {
        executable_path = "C:\\weave-iis\\fcgi\\weave-fcgi.exe"
        allowed = true
        description = "config-weave testlab FastCGI"
        group_id = "weave"
      }
    }

    // The section-level half of the same list. Both switches ship off, which is
    // the hardened posture; turning one on is the converge. Safe here only
    // because the instance is disposable.
    step "isapi_cgi_restriction_settings" {
      description = "Let an unlisted CGI executable run"
      resource = "isapi_cgi_restriction_settings"
      requires = ["feature_cgi"]
      properties { allow_unlisted_cgis = true }
    }

    // No interpreter is installed — this is not a PHP test. A FastCGI
    // application pointing at an executable that is not there is still a
    // valid, convergent configuration entry, and that is what is under test:
    // IIS validates the schema, not the filesystem, and nothing ever asks
    // this application to start a process.
    //
    // `arguments` is non-empty on purpose. It is half of the element's
    // identity, and both the addressed read of the symbol attributes here and
    // the section XPath the environment-variable step below builds address
    // the element by (fullPath, arguments) — an empty value would leave the
    // attribute at its schema default and out of the written XML, and an
    // XPath predicate cannot be relied on to match an attribute that is not
    // there.
    step "fastcgi" {
      description = "Register a FastCGI application with its process model"
      resource = "fastcgi_application"
      requires = ["feature_cgi"]
      properties {
        full_path = "C:\\weave-iis\\fcgi\\weave-fcgi.exe"
        arguments = "-weave"
        max_instances = 4
        instance_max_requests = 1000
        activity_timeout = 60s
        request_timeout = 120s
        idle_timeout = 200s
        queue_length = 500
        protocol = :named_pipe
        stderr_mode = :return_generic_500
        signal_before_terminate_seconds = 5
      }
    }

    step "fastcgi_env" {
      description = "An environment variable for that FastCGI application's processes"
      resource = "fastcgi_environment_variable"
      requires = ["fastcgi"]
      properties {
        full_path = "C:\\weave-iis\\fcgi\\weave-fcgi.exe"
        arguments = "-weave"
        name = "WEAVE_FCGI"
        value = "testlab"
      }
    }

    // timeout is what makes this a change: the stock cgi section is
    // 00:15:00. createProcessAsUser and createCGIWithNewConsole are left
    // alone — one of them is on by default and one is off, and asserting
    // either would only risk matching the default and turning this into an
    // already_configured on run 1.
    step "cgi_settings" {
      description = "Kill a CGI process that has run for five minutes"
      resource = "cgi"
      requires = ["pipeline_app", "feature_cgi"]
      properties {
        site = "weave-site"
        path = "/pipeline"
        timeout = 5min
      }
    }

    // ---------------------------------------------------------------
    // Classic ASP
    // ---------------------------------------------------------------

    // codePage is the attribute that is certainly a change: it ships as 0.
    // enableParentPaths is the interesting one — iis_site_converges set it to
    // TRUE at the weave-site level through config_property, so false here is
    // an application narrowing what it inherits rather than a no-op.
    //
    // limits.scriptTimeout and session.timeout are the package's only dotted
    // attribute paths and nothing exercises them: whether
    // Set-WebConfigurationProperty -Name 'limits.scriptTimeout' round-trips
    // is a question about asp.ws, and it does not belong in the step budget
    // of a test about pipeline coverage. No .asp file is served either —
    // authoring valid VBScript through a setup line that may contain neither
    // a double quote nor a pipe is not worth the fragility, so the section's
    // attributes are proven by check() alone.
    step "asp_settings" {
      description = "Lock classic ASP down for /pipeline and run it as UTF-8"
      resource = "asp"
      requires = ["pipeline_app", "feature_asp"]
      properties {
        site = "weave-site"
        path = "/pipeline"
        enable_parent_paths = false
        script_error_sent_to_browser = false
        script_error_message = "weave: the ASP script could not be run"
        code_page = 65001
      }
    }

    // ---------------------------------------------------------------
    // Request-handling limits and warm-up
    // ---------------------------------------------------------------

    // uploadReadAheadSize ships as 49152 and frequentHitThreshold as 2, so
    // either one alone makes this a converge. `enabled` is not set: false is
    // the only value that would be a change, and taking an application
    // offline in a VM three other tests are still fetching from is not a
    // risk worth a step. enable_native_logging is left alone for the same
    // reason the cgi bools are — its stock value is not worth guessing.
    step "server_runtime" {
      description = "Raise the read-ahead buffer and the frequent-hit window for /pipeline"
      resource = "server_runtime"
      requires = ["pipeline_app"]
      properties {
        site = "weave-site"
        path = "/pipeline"
        app_concurrent_request_limit = 4000
        upload_read_ahead_size = 98304
        frequent_hit_threshold = 5
        frequent_hit_time_period = 20s
      }
    }

    // doAppInitAfterRestart ships as false, so this converges. The remap page
    // is the application's own index document, which exists — a remap to a
    // page that is not there would answer 404 to real clients during the
    // warm-up window.
    step "app_init" {
      description = "Warm /pipeline up after a worker restart, serving index.html meanwhile"
      resource = "application_initialization"
      requires = ["pipeline_app", "feature_app_init"]
      properties {
        site = "weave-site"
        path = "/pipeline"
        do_app_init_after_restart = true
        remap_managed_requests_to = "/index.html"
        skip_managed_modules = true
      }
    }

    // The page element lives inside the section the step above sets
    // attributes on, so it goes after it — the same ordering the rewrite
    // test's map and map_entry steps use.
    step "app_init_page" {
      description = "The page IIS requests to warm /pipeline up"
      resource = "application_initialization_page"
      requires = ["app_init"]
      properties {
        site = "weave-site"
        path = "/pipeline"
        init_page = "/index.html"
      }
    }

    // ---------------------------------------------------------------
    // Ghosts: removing what was never there
    // ---------------------------------------------------------------

    // Both are server level on purpose. A location-scoped ghost would read
    // through a -Location that does not exist yet on run 1, which reports
    // ABSENT too, but only by accident; these two answer ABSENT because the
    // element genuinely is not in the collection.
    step "ghost_global_module_absent" {
      description = "A native module that was never registered is already absent"
      resource = "global_module"
      expect = "already_configured"
      properties { name = "weave-ghost-module" ensure = :absent }
    }

    step "ghost_fastcgi_absent" {
      description = "A FastCGI application that was never registered is already absent"
      resource = "fastcgi_application"
      expect = "already_configured"
      properties {
        full_path = "C:\\weave-iis\\fcgi\\weave-ghost.exe"
        arguments = "-ghost"
        ensure = :absent
      }
    }
  }

  // Last in the win2025 group, and the first test anywhere in this package
  // to assert the gatherers. `gather` blocks run BEFORE the three step
  // runs, so what they see is the machine every earlier test in the group
  // left behind — the role installed, URL Rewrite installed, weave-site
  // started on 8080 with weave-pool behind it — which is also the only
  // state they are allowed to describe: a gather cannot assert what this
  // test's own steps are about to create.
  //
  // Everything the steps touch is scoped to three new paths rather than to
  // the site root: /content (an application: the error policy, the HTTP
  // protocol switch, output caching and the tracing rule), /authx (an
  // application: the authentication schemes) and /moved (a plain directory
  // under the site root: the whole-directory redirect). The site root must
  // keep answering 200 anonymously — every existing verify script fetches
  // it, and so will any later sibling — and a directory redirect or a
  // custom error policy there would break that. /content and /authx are
  // applications rather than bare paths because httpErrors and the
  // authentication sections are declared MachineToApplication: a location
  // that is not at least an application boundary is the wrong place to
  // write them.
  test "iis_content_converges" {
    description = "The error, protocol, redirect, compression, caching, tracing and certificate-mapping sections converge, the gatherers report the machine the group built, and a custom 404 and a directory redirect are served"
    template = "x86_64/windows-server-2025"
    group = "win2025"
    memory = "4GiB"
    // cmd /C runs this: no inner double quotes and no pipes. `echo x>f`
    // rather than `echo x > f`, which would write a trailing space.
    //
    // The PowerShell tail mints a certificate in the CURRENT USER store and
    // exports it to a PFX, which is the only way the `certificate` step
    // below can be a real converge: that resource imports a PFX into a
    // LocalMachine store and reports already_configured when the store
    // already holds a match, so a certificate created directly in
    // LocalMachine\My would leave it nothing to do. CurrentUser\My is not a
    // store `certificate` ever looks in, so the export leaves the import
    // genuinely outstanding. It is written without parentheses (the
    // password goes through $p) because cmd gives ( ) meaning of its own.
    setup = "mkdir C:\\weave-iis\\content && mkdir C:\\weave-iis\\authx && mkdir C:\\weave-iis\\www\\moved && echo weave-content-ok>C:\\weave-iis\\content\\index.html && echo weave-custom-404>C:\\weave-iis\\content\\404.html && echo weave-authx-ok>C:\\weave-iis\\authx\\index.html && echo weave-moved-ok>C:\\weave-iis\\www\\moved\\index.html && powershell -NoProfile -Command $p = ConvertTo-SecureString -String weavepass -AsPlainText -Force; $c = New-SelfSignedCertificate -DnsName weave-pfx.local -CertStoreLocation Cert:\\CurrentUser\\My; Export-PfxCertificate -Cert $c -FilePath C:\\weave-iis\\weave.pfx -Password $p"
    verify = "tests/iis_content_verify.ws"

    // The three gatherers. Only scalars this point in the group makes
    // certain are asserted: iis_install put the role on the machine and
    // iis_rewrite_converges installed URL Rewrite, and IIS has been 10.0
    // since Server 2016, which is what the package models. site_count and
    // app_pool_count are deliberately not asserted — they count whatever
    // the stock image shipped with (Default Web Site, DefaultAppPool) plus
    // what the group added, and pinning that number would make every
    // future test that adds a site fail here instead of where it belongs.
    gather "iis_facts" {
      description = "IIS reports itself installed, at version 10.0, with URL Rewrite present"
      from = "iis_info"
      expect {
        installed = true
        version = "10.0"
        rewrite_installed = true
      }
    }

    // No `expect` on these two: their whole payload is a list, and equality
    // against a literal list would be asserting the stock image's sites and
    // pools as much as this group's. The verify script picks weave-site and
    // weave-pool out of the facts map instead, which is the assertion worth
    // making — and it needs weave-site's numeric id from here anyway to
    // find the failed-request trace log on disk.
    gather "site_facts" {
      description = "Every configured site, for the verify script to pick weave-site out of"
      from = "sites"
    }

    gather "pool_facts" {
      description = "Every application pool, for the verify script to pick weave-pool out of"
      from = "app_pools"
    }

    // Three role services none of the earlier tests installed. They go
    // first through `requires` so the apply runs put the module on the
    // machine before anything writes the section it owns. Run 1 checks
    // every step against a machine that still lacks them, which is fine:
    // the section reads are guarded, so a section that cannot be read
    // reports empty, which is drift, which is the truth on a first run.
    step "digest_auth_feature" {
      description = "Install Digest authentication"
      resource = "feature"
      properties { name = :digest_auth }
    }

    step "cert_auth_feature" {
      description = "Install IIS client certificate mapping authentication"
      resource = "feature"
      properties { name = :cert_auth }
    }

    step "tracing_feature" {
      description = "Install failed request tracing"
      resource = "feature"
      properties { name = :http_tracing }
    }

    step "content_app" {
      description = "An application at /content to hang the content settings off"
      resource = "application"
      properties {
        site = "weave-site"
        path = "/content"
        physical_path = "C:\\weave-iis\\content"
        app_pool = "weave-pool"
      }
    }

    step "authx_app" {
      description = "An application at /authx to hang the authentication schemes off"
      resource = "application"
      properties {
        site = "weave-site"
        path = "/authx"
        physical_path = "C:\\weave-iis\\authx"
        app_pool = "weave-pool"
      }
    }

    // error_mode = :custom is not decoration: IIS ships
    // DetailedLocalOnly, and the verify script requests from the guest
    // itself, so with the default it would be shown the detailed IIS
    // diagnostic page and never see the custom document at all. :replace
    // likewise — Auto lets a handler keep its own body, and a static 404
    // has none to keep, but Replace is the unambiguous statement and is
    // drift from the shipped Auto. default_path covers the "status with no
    // entry of its own" arm.
    step "errors_policy" {
      description = "Always serve the custom error page, even locally, and replace whatever the handler produced"
      resource = "http_errors"
      requires = ["content_app"]
      properties {
        site = "weave-site"
        path = "/content"
        error_mode = :custom
        existing_response = :replace
        default_path = "/content/404.html"
        default_response_mode = :execute_url
      }
    }

    // The point of this step: 404 is an entry every location INHERITS from
    // the server level, where IIS ships
    // <error statusCode="404" prefixLanguageFilePath="...custerr"
    // path="404.htm" />. The 451 entry in iis_site_converges covers the
    // plain add; this covers the override, which the collection machinery
    // reaches through its "the element is there, set the attributes that
    // differ in place" arm and which no test has ever exercised. If IIS
    // refuses to patch an element the location does not own, this step is
    // where that shows up, and that is worth knowing.
    //
    // :file, not :execute_url. ExecuteURL returns whatever the executed URL
    // returns, and a static .html sets no status, so the client saw 200 for a
    // missing document — the custom page was served but the error was not
    // reported. File mode returns the document WITH the 404.
    //
    // That needs the inherited prefixLanguageFilePath cleared, or IIS joins
    // %SystemDrive%\inetpub\custerr with this absolute path and resolves to
    // nonsense. http_error owns that attribute (see always_write in its
    // script), so leaving the param empty clears it rather than inheriting it.
    step "error_404" {
      description = "Override the inherited 404 entry with a document of our own"
      resource = "http_error"
      requires = ["content_app"]
      properties {
        site = "weave-site"
        path = "/content"
        status_code = 404
        error_path = "C:\\weave-iis\\content\\404.html"
        response_mode = :file
      }
    }

    // allowKeepAlive ships true, so turning it off is what a converge
    // looks like for this section. Scoped to /content: keep-alive off
    // breaks NTLM, and /secure is authenticated.
    step "keep_alive_off" {
      description = "Turn HTTP keep-alive off for /content"
      resource = "http_protocol"
      requires = ["content_app"]
      properties {
        site = "weave-site"
        path = "/content"
        allow_keep_alive = false
      }
    }

    // enabled is already true on a stock IIS; enableKernelCache is too, so
    // taking HTTP.sys out of the path is the real change here.
    step "output_cache" {
      description = "Cache in the worker process but not in the kernel"
      resource = "output_cache"
      requires = ["content_app"]
      properties {
        site = "weave-site"
        path = "/content"
        enabled = true
        enable_kernel_cache = false
      }
    }

    // The extension is spelled without a leading dot, matching every sample on
    // IIS's reference page for this collection (extension='asp'). Either form
    // works — a dotted key converged just as well once the real cause was
    // found, which was `location`: see the note on that property below.
    step "cache_profile" {
      description = "A time-based output cache profile for weave responses"
      resource = "output_cache_profile"
      requires = ["content_app"]
      properties {
        site = "weave-site"
        path = "/content"
        extension = "weave"
        policy = :cache_for_time_period
        kernel_cache_policy = :dont_cache
        duration = 30s
        // `location` is written but NOT diffed, and deliberately kept here to
        // exercise that path: the IIS PowerShell provider puts its own
        // `Location` member on every object it returns, and it wins over the
        // attribute of the same name, so reading this back answers
        // "weave-site/content" rather than "ServerAndClient".
        location = :server_and_client
        vary_by_query_string = "*"
      }
    }

    // One attribute only, and one that is not the schema default. Paired with
    // the profile above it separates "this collection and its key work" from
    // "one of those other attributes does not round-trip".
    step "cache_profile_minimal" {
      description = "A change-based output cache profile, with nothing else set"
      resource = "output_cache_profile"
      requires = ["content_app"]
      properties {
        site = "weave-site"
        path = "/content"
        extension = "weavemin"
        policy = :cache_until_change
      }
    }

    // Every threshold differs from the shipped values (both denyBy*
    // switches off, 10 concurrent, 30 requests per 200ms), and
    // logging-only mode is on deliberately: it is the only setting here
    // that guarantees the verify script's own burst of requests to
    // /content cannot be blocked by the rule this step just installed.
    step "dynamic_ip" {
      description = "Dynamic IP restriction thresholds, in logging-only mode so nothing is actually refused"
      resource = "dynamic_ip_restriction"
      requires = ["content_app"]
      properties {
        site = "weave-site"
        path = "/content"
        deny_by_concurrent_requests = true
        max_concurrent_requests = 20
        deny_by_request_rate = true
        max_requests = 60
        request_interval = 500ms
        enable_logging_only_mode = true
        deny_action = :not_found
      }
    }

    // Digest ships disabled with an empty realm. The scheme cannot
    // actually authenticate anybody here — a digest is computed against a
    // domain controller and this VM is a workgroup member — but that is a
    // request-time fact, not a configuration one, and anonymous
    // authentication is still enabled on /authx, so requests keep being
    // served anonymously and the verify script can prove the pipeline
    // survived the change.
    step "digest_auth" {
      description = "Offer Digest authentication on /authx"
      resource = "digest_authentication"
      requires = ["authx_app", "digest_auth_feature"]
      properties {
        site = "weave-site"
        path = "/authx"
        enabled = true
        realm = "weave-authx"
      }
    }

    // IIS's own mapping tables, which need no domain — the mapping only
    // engages when a client actually presents a certificate, which nothing
    // here does, so an anonymous request is unaffected. enabled ships
    // false and manyToOneCertificateMappingsEnabled ships true, so both
    // are drift.
    step "iis_cert_map" {
      description = "Enable IIS client certificate mapping on /authx, one-to-one only"
      resource = "iis_client_certificate_mapping_authentication"
      requires = ["authx_app", "cert_auth_feature"]
      properties {
        site = "weave-site"
        path = "/authx"
        enabled = true
        one_to_one_enabled = true
        many_to_one_enabled = false
      }
    }

    // The Active Directory-backed mapping is the one scheme in this
    // package that CANNOT be turned on here: it resolves certificates to
    // Windows accounts through a directory, and this VM is a workgroup
    // member, so enabling it would write configuration that fails at
    // request time. What is assertable is the detection path — that IIS
    // reports the section's shipped disabled state and that this resource
    // reads it correctly — which is what an already_configured with
    // enabled = false says. The Web-Client-Auth role service is
    // deliberately NOT installed: if a section declaration only appeared
    // with its role service then this step would report drift on run 1
    // instead, and that would itself be the finding.
    //
    // Asserted at the SERVER level, with no site and no path, for a reason
    // that matters to the three-run protocol: a -Location read is guarded,
    // and a guarded read that fails reports empty, which is drift — so a
    // location is the wrong place to make an already_configured claim about
    // an inherited default. MACHINE/WEBROOT/APPHOST with no -Location is
    // the one scope that cannot fail to read.
    step "ad_cert_map_disabled" {
      description = "Active Directory client certificate mapping is off at the server level, as it is on a stock IIS"
      resource = "client_certificate_mapping_authentication"
      expect = "already_configured"
      properties {
        enabled = false
      }
    }

    // Per-site trace logging, which ships off with room for 50 files of
    // 1024 KB each. `directory` is left at IIS's default
    // (%SystemDrive%\inetpub\logs\FailedReqLogFiles) on purpose: a
    // directory of our own would need an ACL for the worker process
    // identity before anything could be written into it, and the verify
    // script proves the same thing by finding the trace file in the
    // default location.
    step "tracing" {
      description = "Turn failed request trace logging on for the site"
      resource = "failed_request_tracing"
      requires = ["tracing_feature"]
      properties {
        site = "weave-site"
        enabled = true
        max_log_files = 10
        max_log_file_size = 512
      }
    }

    // One provider with ONE area, not two: the areas attribute is a flags
    // enum, IIS renders a multi-flag value with its own spacing
    // ("Authentication, Security"), and this resource compares the
    // provider list as exact text — so a two-area rule would re-check as
    // drift after a successful apply and the step would report an error
    // instead of converging.
    step "trace_rule" {
      description = "Trace any .html request under /content that answers 404"
      resource = "failed_request_tracing_rule"
      requires = ["tracing", "content_app"]
      properties {
        site = "weave-site"
        path = "/content"
        content_path = "*.html"
        status_codes = "404"
        verbosity = :warning
        providers = ["WWW Server:Authentication:Verbose"]
      }
    }

    // Server-wide: httpCompression is not a delegated section, so there is
    // no site or path here. min_file_size_for_comp is 2700 on a stock IIS,
    // max_disk_space_usage 100 MB, send_cache_headers false and
    // no_compression_for_proxies true, so every value below is drift.
    //
    // The compression LEVELS are not here: in IIS's schema they are attributes
    // of the <scheme> child elements, not of httpCompression, so they belong to
    // windows_iis.compression_scheme — see the next step.
    step "compression" {
      description = "Compress smaller responses, allow a bigger cache, and stop exempting proxied requests"
      resource = "http_compression"
      properties {
        min_file_size_for_comp = 512
        do_disk_space_limiting = true
        max_disk_space_usage = 200
        no_compression_for_proxies = false
        send_cache_headers = true
      }
    }

    // gzip is registered by a stock IIS (static compression is a default
    // sub-feature of the role), so this lands in the update-in-place arm and
    // needs no dll. Level 9 over the shipped 7 is the change; a static
    // response is compressed once and cached, so the cost is paid once.
    step "compression_scheme" {
      description = "Raise gzip's static compression level"
      resource = "compression_scheme"
      properties {
        name = "gzip"
        static_compression_level = 9
      }
    }

    // A type invented for this test rather than a real one such as
    // application/json: the shipped dynamicTypes list is not something to
    // bet a converge on, and an entry nothing could already have is a
    // guaranteed add.
    step "compress_type" {
      description = "Compress a dynamic MIME type of our own"
      resource = "compression_mime_type"
      properties {
        mime_type = "application/vnd.weave+json"
        kind = :dynamic
        enabled = true
      }
    }

    step "ghost_compress_type_absent" {
      description = "A compression entry that was never added is already absent"
      resource = "compression_mime_type"
      expect = "already_configured"
      properties {
        mime_type = "application/vnd.weave-ghost"
        kind = :dynamic
        ensure = :absent
      }
    }

    // The whole-directory redirect, on a directory created for it under
    // the site root — NOT on the root or on /app, which every existing
    // verify script, and any later sibling, expects to answer 200.
    // /moved holds a real index.html, so an unredirected request would be
    // a 200 rather than a 404: the 301 the verify script asserts can only
    // come from this step. httpRedirect ships disabled and answers 302
    // when it is on, so enabled and :permanent are both drift.
    step "redirect_moved" {
      description = "Redirect everything under /moved to the document the rewrite test serves"
      resource = "http_redirect"
      properties {
        site = "weave-site"
        path = "/moved"
        enabled = true
        destination = "http://localhost:8080/new/index.html"
        exact_destination = true
        child_only = false
        http_response_status = :permanent
      }
    }

    // The one step in the suite that writes to a web.config instead of to
    // applicationHost.config, which is the whole `store` branch and has
    // never been executed by a test.
    //
    // response_header is the resource to do it with: customHeaders is
    // delegated Read/Write on a stock IIS, so no section_delegation step
    // is needed first, and the result is provable twice over — the header
    // on the wire and the web.config file on disk, which only this branch
    // can have created. It is written at the SITE level, with no `path`,
    // so the PSPath is a plain IIS:\Sites\weave-site: that isolates what
    // is under test (which file the write lands in) from the separate
    // question of how a site and a path are joined into a provider path.
    step "header_via_web_config" {
      description = "A response header written into the site's web.config rather than applicationHost.config"
      resource = "response_header"
      properties {
        site = "weave-site"
        store = :web_config
        name = "X-Weave-WebConfig"
        value = "yes"
      }
    }

    // setup exported this PFX from a certificate it created in
    // CurrentUser\My, a store this resource never looks at, so
    // LocalMachine\My genuinely lacks it and the import is real work.
    // iis_site_converges covers self_signed_certificate; this covers the
    // import path, which is the one a playbook uses in production.
    step "certificate" {
      description = "Import the PFX setup exported into the LocalMachine personal store"
      resource = "certificate"
      properties {
        ensure = :present
        store = :my
        pfx_path = "C:\\weave-iis\\weave.pfx"
        password = "weavepass"
        subject = "CN=weave-pfx.local"
        exportable = true
      }
    }
  }
}
