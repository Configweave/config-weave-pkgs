use value
use shell

fn verify(facts: Value) -> Result[bool, string] {
    let out = shell::powershell("$ErrorActionPreference='Stop'; Add-Type -Path (Join-Path $env:windir 'system32\\inetsrv\\Microsoft.Web.Administration.dll'); $sm=New-Object Microsoft.Web.Administration.ServerManager; if ($null -eq $sm.Sites['remove-site41']) {{ throw 'parent site disappeared' }}; $cfg=$sm.GetApplicationHostConfiguration(); $c=$cfg.GetSection('system.webServer/tracing/traceFailedRequests', 'remove-site41').GetCollection(); if (@($c | Where-Object {{ $_['path'] -eq 'remove-*' }}).Count -ne 0) {{ throw 'failed_request_tracing_rule target survived' }}; if (@($c | Where-Object {{ $_['path'] -eq 'keep-*' }}).Count -ne 1) {{ throw 'failed_request_tracing_rule sibling lost' }}; $c=$cfg.GetSection('system.webServer/security/ipSecurity', 'remove-site41').GetCollection(); if (@($c | Where-Object {{ $_['ipAddress'] -eq '192.0.2.41' }}).Count -ne 0) {{ throw 'ip_restriction target survived' }}; if (@($c | Where-Object {{ $_['ipAddress'] -eq '192.0.2.42' }}).Count -ne 1) {{ throw 'ip_restriction sibling lost' }}; $c=$cfg.GetSection('system.webServer/security/requestFiltering', 'remove-site41').GetCollection('hiddenSegments'); if (@($c | Where-Object {{ $_['segment'] -eq 'remove41' }}).Count -ne 0) {{ throw 'request_filtering_rule target survived' }}; if (@($c | Where-Object {{ $_['segment'] -eq 'keep41' }}).Count -ne 1) {{ throw 'request_filtering_rule sibling lost' }}; $c=$cfg.GetSection('system.webServer/httpErrors', 'remove-site41').GetCollection(); if (@($c | Where-Object {{ $_['statusCode'] -eq 491 }}).Count -ne 0) {{ throw 'http_error target survived' }}; if (@($c | Where-Object {{ $_['statusCode'] -eq 492 }}).Count -ne 1) {{ throw 'http_error sibling lost' }}; $c=$cfg.GetSection('system.webServer/staticContent', 'remove-site41').GetCollection(); if (@($c | Where-Object {{ $_['fileExtension'] -eq '.remove41' }}).Count -ne 0) {{ throw 'mime_map target survived' }}; if (@($c | Where-Object {{ $_['fileExtension'] -eq '.keep41' }}).Count -ne 1) {{ throw 'mime_map sibling lost' }}; $c=$cfg.GetSection('system.webServer/caching', 'remove-site41').GetCollection('profiles'); if (@($c | Where-Object {{ $_['extension'] -eq '.remove41' }}).Count -ne 0) {{ throw 'output_cache_profile target survived' }}; if (@($c | Where-Object {{ $_['extension'] -eq '.keep41' }}).Count -ne 1) {{ throw 'output_cache_profile sibling lost' }}; $c=$cfg.GetSection('system.webServer/handlers', 'remove-site41').GetCollection(); if (@($c | Where-Object {{ $_['name'] -eq 'remove41' }}).Count -ne 0) {{ throw 'handler target survived' }}; if (@($c | Where-Object {{ $_['name'] -eq 'keep41' }}).Count -ne 1) {{ throw 'handler sibling lost' }}; $c=$cfg.GetSection('system.webServer/isapiFilters', 'remove-site41').GetCollection(); if (@($c | Where-Object {{ $_['name'] -eq 'remove41' }}).Count -ne 0) {{ throw 'isapi_filter target survived' }}; if (@($c | Where-Object {{ $_['name'] -eq 'keep41' }}).Count -ne 1) {{ throw 'isapi_filter sibling lost' }}; $c=$cfg.GetSection('system.webServer/security/isapiCgiRestriction').GetCollection(); if (@($c | Where-Object {{ $_['path'] -eq 'C:\\remove41.dll' }}).Count -ne 0) {{ throw 'isapi_cgi_restriction target survived' }}; if (@($c | Where-Object {{ $_['path'] -eq 'C:\\keep41.dll' }}).Count -ne 1) {{ throw 'isapi_cgi_restriction sibling lost' }}; $c=$cfg.GetSection('system.webServer/applicationInitialization', 'remove-site41').GetCollection(); if (@($c | Where-Object {{ $_['initializationPage'] -eq '/remove41' }}).Count -ne 0) {{ throw 'application_initialization_page target survived' }}; if (@($c | Where-Object {{ $_['initializationPage'] -eq '/keep41' }}).Count -ne 1) {{ throw 'application_initialization_page sibling lost' }}; $c=$cfg.GetSection('system.webServer/rewrite/rewriteMaps', 'remove-site41').GetCollection(); if (@($c | Where-Object {{ $_['name'] -eq 'remove41' }}).Count -ne 0) {{ throw 'rewrite_map target survived' }}; if (@($c | Where-Object {{ $_['name'] -eq 'keep41' }}).Count -ne 1) {{ throw 'rewrite_map sibling lost' }}; $c=$cfg.GetSection('system.webServer/rewrite/rewriteMaps/rewriteMap[@name=''entries41'']', 'remove-site41').GetCollection(); if (@($c | Where-Object {{ $_['key'] -eq 'remove41' }}).Count -ne 0) {{ throw 'rewrite_map_entry target survived' }}; if (@($c | Where-Object {{ $_['key'] -eq 'keep41' }}).Count -ne 1) {{ throw 'rewrite_map_entry sibling lost' }}; $c=$cfg.GetSection('system.webServer/rewrite/allowedServerVariables', 'remove-site41').GetCollection(); if (@($c | Where-Object {{ $_['name'] -eq 'HTTP_X_REMOVE41' }}).Count -ne 0) {{ throw 'rewrite_allowed_server_variable target survived' }}; if (@($c | Where-Object {{ $_['name'] -eq 'HTTP_X_KEEP41' }}).Count -ne 1) {{ throw 'rewrite_allowed_server_variable sibling lost' }}; ", Value::Null)?
    if !out.success { return Err(out.stderr.trim()) }
    Ok(true)
}
