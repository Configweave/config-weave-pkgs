use value
use fs
use shell
use common

// This resource owns .service units only; `unit_file` covers timers,
// sockets and every other unit type. A trailing ".service" is accepted and
// not doubled.
fn unit_name(name: string) -> string {
    if name.ends_with(".service") { name } else { name + ".service" }
}

fn unit_path(name: string) -> string { "/etc/systemd/system/" + unit_name(name) }

fn prepare(params: Value) -> Result[string, string] {
    let name = common::param_str(params, "name", "")
    if name == "" { return Err("missing 'name' parameter") }
    common::require_segment("name", name)?
    if unit_name(name) == ".service" { return Err("'name' must name a service") }
    if !common::has_systemctl()? { return Err("systemctl is not available on this host") }
    if !common::systemd_running() { return Err("systemd is not running on this host") }
    Ok(name)
}

// `systemctl is-enabled` prints the unit file state; its exit code is 0 for
// static, alias, indirect, generated and transient units too, so only the
// text tells enabled from "nothing to enable". A unit it cannot find prints
// nothing on stdout.
fn enablement(unit: string) -> Result[string, string] {
    let out = shell::bash("systemctl is-enabled " + common::q(unit), Value::Null)?
    let state = out.stdout.trim().split("\n").get(0).unwrap_or("").trim()
    if state == "" { return Ok("not-found") }
    Ok(state)
}

fn is_on(state: string) -> bool { state == "enabled" || state == "enabled-runtime" }

// Whether the unit file state already satisfies `want`, or an error when no
// systemctl verb can get it there.
fn satisfies(unit: string, state: string, want: string) -> Result[bool, string] {
    if is_on(state) { return Ok(want == "enabled") }
    if state == "disabled" || state == "linked" || state == "linked-runtime" { return Ok(want == "disabled") }
    if want == "disabled" {
        // Nothing starts these at boot through enablement of their own.
        if state == "static" || state == "indirect" || state == "transient" || state == "masked" || state == "masked-runtime" || state == "not-found" { return Ok(true) }
        if state == "generated" { return Err(unit + " is generated by a systemd generator, so systemctl cannot disable it; mask it or change the generator's source") }
        if state == "alias" { return Err(unit + " is an alias; manage the unit it names") }
        return Err(unit + " has unit file state '" + state + "', which cannot be disabled")
    }
    if state == "static" { return Err(unit + " is static (no [Install] section), so it cannot be enabled; it runs when another unit pulls it in") }
    if state == "masked" || state == "masked-runtime" { return Err(unit + " is masked; unmask it before enabling") }
    if state == "not-found" { return Err(unit + " was not found; supply `unit` or install it first") }
    Err(unit + " has unit file state '" + state + "', which systemctl cannot enable")
}

fn active(unit: string) -> Result[bool, string] {
    Ok(shell::bash("systemctl is-active --quiet " + common::q(unit), Value::Null)?.success)
}

// The service entered its active state before its unit file last changed,
// or systemd has not reloaded the file: either way it runs the old unit.
fn stale(unit: string, p: string) -> Result[bool, string] {
    if common::needs_reload(unit)? { return Ok(true) }
    let out = shell::bash("systemctl show -p ActiveEnterTimestamp --timestamp=unix --value " + common::q(unit), Value::Null)?
    let ts = out.stdout.trim()
    if !out.success || !ts.starts_with("@") { return Ok(false) }
    let started = 0
    for c in ts.replace("@", "").chars() {
        if c < '0' || c > '9' { break }
        started = started * 10 + (int(c) - int('0'))
    }
    Ok(common::mtime(p) > started)
}

fn systemctl(verb: string, unit: string) -> Result[unit, string] {
    common::run("systemctl " + verb + " " + unit, "systemctl " + verb + " " + common::q(unit))
}

fn check(params: Value) -> Result[CheckResult, string] {
    let name = prepare(params)?
    let unit = unit_name(name)
    let p = unit_path(name)
    if !common::want_present(params)? {
        if fs::lexists(p) { return Ok(CheckResult::NotConfigured) }
        if active(unit)? { return Ok(CheckResult::NotConfigured) }
        if is_on(enablement(unit)?) { return Ok(CheckResult::NotConfigured) }
        return Ok(CheckResult::AlreadyConfigured)
    }
    // An empty `unit` means "manage a unit that already exists" — which
    // includes vendor units under /lib, so the file under /etc is only
    // required when this resource is the one writing it.
    let body = common::param_str(params, "unit", "")
    if body != "" && !common::has_content(p, body) { return Ok(CheckResult::NotConfigured) }
    let en = common::desired_enabled(params)?
    if en != "unmanaged" && !satisfies(unit, enablement(unit)?, en)? {
        return Ok(CheckResult::NotConfigured)
    }
    let st = common::desired_state(params)?
    if st != "unmanaged" {
        let up = active(unit)?
        if up != (st == "running") { return Ok(CheckResult::NotConfigured) }
        if up && body != "" && stale(unit, p)? { return Ok(CheckResult::NotConfigured) }
    }
    Ok(CheckResult::AlreadyConfigured)
}

fn apply(params: Value) -> Result[ApplyResult, string] {
    let name = prepare(params)?
    let unit = unit_name(name)
    let p = unit_path(name)
    if !common::want_present(params)? {
        // Stop and disable while the unit file is still there — systemd
        // cannot resolve a unit it can no longer read.
        if active(unit)? { systemctl("stop", unit)? }
        let state = enablement(unit)?
        if state == "enabled-runtime" { systemctl("disable --runtime", unit)? } else if state == "enabled" { systemctl("disable", unit)? }
        if fs::lexists(p) {
            fs::delete(p)?
            common::daemon_reload()?
        }
        return Ok(ApplyResult::Success)
    }
    let body = common::param_str(params, "unit", "")
    let changed = false
    if body != "" {
        if !common::has_content(p, body) {
            fs::write(p, body)?
            changed = true
        }
        // The unit must be re-read before enable/start act on the new file.
        if changed || common::needs_reload(unit)? { common::daemon_reload()? }
    }
    let en = common::desired_enabled(params)?
    if en != "unmanaged" {
        let state = enablement(unit)?
        if !satisfies(unit, state, en)? {
            if en == "enabled" {
                systemctl("enable", unit)?
            } else if state == "enabled-runtime" {
                systemctl("disable --runtime", unit)?
            } else {
                systemctl("disable", unit)?
            }
        }
    }
    let st = common::desired_state(params)?
    if st != "unmanaged" {
        let up = active(unit)?
        if st == "running" && !up {
            systemctl("start", unit)?
        } else if st == "running" && body != "" && (changed || stale(unit, p)?) {
            // Running from the unit as it was before the write.
            systemctl("try-restart", unit)?
        } else if st == "stopped" && up {
            systemctl("stop", unit)?
        }
    }
    Ok(ApplyResult::Success)
}
