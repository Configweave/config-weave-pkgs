package "linux_systemd" {
  description = "Manage systemd services and unit files"

  // One resource for the whole service: its unit file, its boot enablement
  // and whether it is running. `state` and `enabled` default to :unmanaged
  // so this can install a unit without also deciding those, or manage an
  // existing service (including a vendor unit under /lib) without supplying
  // one. This owns .service units; `unit_file` below covers every other
  // unit type.
  resource "service" {
    description = "Ensure a systemd service's unit file, boot enablement and running state"
    script = "resources/service.ws"
    concurrency = "exclusive"
    param "name" { description = "Service name without the .service suffix" type = "string" required = true }
    param "ensure" {
      description = "Whether the service is installed"
      type = "symbol"
      default = :present

      symbol "present" { description = "The service exists" }
      symbol "absent"  { description = "Stop and disable the service, then delete its unit file under /etc/systemd/system" }
    }
    param "unit" { description = "Unit file body written to /etc/systemd/system/<name>.service; empty manages an existing unit without rewriting it" type = "string" default = "" }
    param "state" {
      description = "Runtime state to enforce"
      type = "symbol"
      default = :unmanaged

      symbol "running"   { description = "Start the service" }
      symbol "stopped"   { description = "Stop the service" }
      symbol "unmanaged" { description = "Leave the runtime state alone" }
    }
    param "enabled" {
      description = "Boot enablement to enforce"
      type = "symbol"
      default = :unmanaged

      symbol "enabled"   { description = "Enable the service at boot" }
      symbol "disabled"  { description = "Disable the service at boot" }
      symbol "unmanaged" { description = "Leave boot enablement alone" }
    }
  }

  // For unit types `service` does not cover — timers, sockets, mounts,
  // targets — where there is no running/enabled pair to manage.
  resource "unit_file" {
    description = "Ensure a systemd unit file under /etc/systemd/system (any unit type)"
    script = "resources/unit_file.ws"
    concurrency = "exclusive"
    param "name" { description = "Unit filename including its suffix, such as example.timer" type = "string" required = true }
    param "content" { description = "Unit file content" type = "string" required = true }
    param "daemon_reload" { description = "Run systemctl daemon-reload after writing" type = "bool" default = false }
  }

  test "unit_file_converges" {
    description = "Unit files converge in a container (no live systemd needed)"
    image = "debian:12"
    verify = "tests/unit_file_verify.ws"

    step "unit" {
      description = "Write a timer unit"
      resource = "unit_file"
      properties {
        name = "config-weave-test.timer"
        content = "[Unit]\nDescription=Config Weave Test\n"
      }
    }
  }

  // `service` needs live systemd — covered by vmlab.
  test "service_control_converges" {
    description = "Unit installation, enablement and runtime state converge against live systemd"
    template = "x86_64/ubuntu-24.04"
    setup = "printf '[Unit]\\nDescription=config-weave seeded\\n[Service]\\nExecStart=/bin/sleep 3600\\n[Install]\\nWantedBy=multi-user.target\\n' > /etc/systemd/system/cw-seeded.service && systemctl daemon-reload && systemctl enable cw-seeded >/dev/null 2>&1"
    verify = "tests/service_verify.ws"

    step "disable" {
      description = "Stop and disable systemd-timesyncd"
      resource = "service"
      properties { name = "systemd-timesyncd" enabled = :disabled state = :stopped }
    }

    // A service this resource installs from scratch, unit and all.
    step "install" {
      description = "Install a unit, enable it and start it"
      resource = "service"
      requires = ["disable"]
      properties {
        name = "cw-managed"
        enabled = :enabled
        state = :running
        unit = <<'UNIT'
[Unit]
Description=config-weave managed test service

[Service]
ExecStart=/bin/sleep 3600

[Install]
WantedBy=multi-user.target
UNIT
      }
    }

    // cw-seeded is enabled with its unit under /etc, so :absent has real
    // work: disable it, then delete the unit file.
    step "remove" {
      description = "Remove the service seeded during setup"
      resource = "service"
      requires = ["install"]
      properties { name = "cw-seeded" ensure = :absent }
    }
  }
}
